{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigmentlab-com",
  "compatibility_date": "2024-09-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "pigmentlaboratory.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}