---
import Layout from '../../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Conditions Générales d\'Utilisation — PigmentLab',
  'url': 'https://pigmentlab.com/fr/terms',
  'description': 'Conditions d\'utilisation de PigmentLab : service gratuit pour utilisation personnelle et commerciale, pleine propriété de vos palettes.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlab.com'
  }
};
---

<Layout
  title="Conditions Générales d'Utilisation — PigmentLab"
  description="Conditions d'utilisation de PigmentLab. Libre et gratuit pour tous usages personnels et commerciaux."
  keywords="conditions générales pigmentlab, cgu, licence commerciale libre, palettes de couleurs"
  currentPath="/fr/terms"
  lang="fr"
  schema={termsSchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 text-center">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Conditions Générales d'Utilisation
      </h1>
      <p class="mt-4 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
        Toutes les palettes, codes couleurs et extraits CSS générés sur PigmentLab vous appartiennent intégralement et sont libres d'utilisation.
      </p>
    </div>
  </section>
</Layout>

