---
import Layout from '../../layouts/Layout.astro';
import ColorWheelStudio from '../../components/ColorWheelStudio.astro';

const frenchFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Qu\'est-ce qu\'une roue chromatique en ligne gratuit ?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Une roue chromatique en ligne gratuit est un outil interactif représentant le spectre visible sous forme de cercle géométrique. Elle permet aux artistes et designers de sélectionner des teintes, d\'ajuster la saturation et de calculer des harmonies comme la roue couleur complémentaire ou les triades.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Quelle est la différence entre le cercle chromatique Itten et la roue chromatique Adobe ?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'La roue chromatique Adobe utilise uniquement des coordonnées numériques RGB (Rouge opposé au Cyan). Le cercle chromatique de Johannes Itten (Bauhaus RYB) place le Rouge en face du Vert et le Bleu en face de l\'Orange, respectant la perception artistique traditionnelle et le mélange des pigments réels.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Comment trouver une roue chromatique couleur complémentaire ?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Dans notre roue chromatique, les couleurs complémentaires se situent exactement à 180° l\'une de l\'autre. Elles créent un contraste simultané maximal idéal pour les boutons d\'appel à l\'action et l\'identité visuelle.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Comment utiliser une roue chromatique pour créer une palette harmonieuse ?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Pour utiliser la roue chromatique, choisissez d\'abord une couleur principale sur le cercle, puis sélectionnez une règle d\'harmonie : les complémentaires (opposées à 180° pour un contraste fort), les analogues (teintes voisines pour une ambiance calme) ou les triadiques (triangle équilatéral à 120° pour une palette vivante). Dans PigmentLab, les codes HEX, les nuances d\'ombre et les ratios WCAG s\'affichent instantanément.'
      }
    }
  ]
};

const frenchWheelSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'PigmentLab Roue Chromatique en Ligne Gratuite — Cercle Chromatique Itten',
    'url': 'https://pigmentlab.com/fr/color-wheel',
    'description': 'Roue chromatique en ligne gratuit et cercle chromatique de Johannes Itten (RYB) & RGB. Roue couleur complémentaire, générateur de palettes et contrôle du contraste WCAG.',
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'EUR'
    }
  },
  frenchFaqSchema
];
---

<Layout
  title="Roue Chromatique en Ligne Gratuite — Roue Couleur Complémentaire & Cercle Chromatique"
  description="Roue chromatique en ligne gratuit et cercle chromatique interactif. Découvrez la roue chromatique des couleurs selon Johannes Itten (RYB) et RGB, trouvez des couleurs complémentaires et testez le contraste WCAG. Meilleure alternative à la roue chromatique Adobe."
  keywords="roue chromatique, roue couleur complémentaire, roue chromatique en ligne gratuit, roue chromatique des couleurs, roue chromatique couleur, roue chromatique couleur complémentaire, roue chromatique adobe, cercle chromatique en ligne, roue chromatique en ligne, roue chromatique photoshop"
  currentPath="/fr/color-wheel"
  lang="fr"
  schema={frenchWheelSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Roue Chromatique Bauhaus &amp; Harmonie des Couleurs</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Roue Chromatique en Ligne Gratuite
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Les sélecteurs comme la roue chromatique Adobe n'utilisent que des angles RVB numériques. PigmentLab vous permet de basculer en 1 clic vers le véritable <strong class="text-[#171717] dark:text-white">cercle chromatique de Johannes Itten (Bauhaus RYB)</strong>, où le <span class="text-[#c41e3a] font-semibold">Rouge</span> fait face au <span class="text-[#14b82a] font-semibold">Vert</span> pour une harmonie naturelle.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ColorWheelStudio lang="fr" />

  <!-- Educational Guide in French -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Théorie des Couleurs &amp; Design</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          Le guide complet de la roue chromatique et des couleurs complémentaires
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Comprendre le cercle chromatique des couleurs, calculer les harmonies complémentaires et choisir entre le modèle Itten et le modèle numérique.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Qu'est-ce qu'une roue chromatique et pourquoi l'utiliser en ligne ?
          </h3>
          <p>
            La <strong>roue chromatique</strong> (ou cercle chromatique) est l'outil fondamental de la théorie de la couleur. Conçue à l'origine par Isaac Newton puis perfectionnée par Goethe et le maître du Bauhaus Johannes Itten, la <strong>roue chromatique des couleurs</strong> organise le spectre de la lumière visible en un cercle continu de 360 degrés.
          </p>
          <p>
            Notre <strong>roue chromatique en ligne gratuit</strong> permet aux graphistes, peintres et webdesigners de composer des palettes équilibrées sans calcul complexe. Elle calcule automatiquement les teintes secondaires et tertiaires à partir de n'importe quelle couleur de départ.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. Le cercle chromatique des 12 teintes : Modèle Itten (RYB) vs. Écran numérique (RGB)
          </h3>
          <p>
            Le positionnement géométrique des opposés varie profondément entre l'art traditionnel et les écrans numériques :
          </p>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Teinte de base</th>
                  <th class="p-4 sm:p-5 text-[#c41e3a] font-semibold">Opposé Roue Artiste (Itten RYB)</th>
                  <th class="p-4 sm:p-5 text-[#0070f3] font-semibold">Opposé Écran Numérique (RGB)</th>
                  <th class="p-4 sm:p-5">Catégorie</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Rouge (#E60026)</td>
                  <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400 font-medium">Vert (#00AA44)</td>
                  <td class="p-4 sm:p-5 text-cyan-600 dark:text-cyan-400">Cyan (#00FFFF)</td>
                  <td class="p-4 sm:p-5">Couleur Primaire</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Jaune (#FFE600)</td>
                  <td class="p-4 sm:p-5 text-purple-600 dark:text-purple-400 font-medium">Violet (#7A0099)</td>
                  <td class="p-4 sm:p-5 text-blue-600 dark:text-blue-400">Bleu (#0000FF)</td>
                  <td class="p-4 sm:p-5">Couleur Primaire</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Bleu (#002185)</td>
                  <td class="p-4 sm:p-5 text-orange-600 dark:text-orange-400 font-medium">Orange (#FF6600)</td>
                  <td class="p-4 sm:p-5 text-yellow-600 dark:text-yellow-400">Jaune (#FFFF00)</td>
                  <td class="p-4 sm:p-5">Couleur Primaire</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            3. Roue couleur complémentaire et contraste simultané
          </h3>
          <p>
            La <strong>roue couleur complémentaire</strong> associe deux teintes diamétralement opposées (180 degrés). Placée côte à côte, une paire complémentaire intensifie la saturation perçue de chaque couleur grâce au phénomène de contraste simultané. Idéal pour attirer l'attention sur un bouton d'action ou un logo.
          </p>
        </section>

        <!-- FAQs -->
        <section class="space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Questions Fréquentes
          </h3>
          <div class="space-y-4">
            {frenchFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>

