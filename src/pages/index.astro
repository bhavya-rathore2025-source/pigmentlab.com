---
import Layout from '../layouts/Layout.astro';
import ExploreColorTools from '../components/ExploreColorTools.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'PigmentLab',
  'url': 'https://pigmentlaboratory.com',
  'description': 'Online-Farblabor mit echter subtraktiver Pigmentabsorption und Johannes Itten Bauhaus Farbkreis. Farbmischer Simulator & interaktiver Farbrad Generator für Designer und Künstler.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com',
    'logo': 'https://pigmentlaboratory.com/favicon.svg'
  }
};
---

<Layout
  title="PigmentLab — Subtraktive Farbphysik & Johannes Itten Bauhaus Farbtheorie"
  description="Entdecken Sie PigmentLab: Das physikbasierte Farblabor. Echte subtraktive Lichtabsorption, Johannes Itten Farbkreis (Bauhaus RYB), Farben mischen Simulator und WCAG-Barrierefreiheit in Echtzeit."
  keywords="pigmentlab, farbkreis, farben mischen, farbrad, farbkreis nach itten, farbkreis itten, farbpaletten generator, farben mischen simulator, pigmentphysik"
  currentPath="/"
  lang="de"
  schema={websiteSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 overflow-hidden">
    <!-- Geist Mesh Gradient Ambient Bloom -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-35 dark:opacity-25">
      <div class="absolute -top-[25%] left-[15%] h-[420px] w-[600px] rounded-full bg-gradient-to-tr from-[#007cf0]/35 via-[#7928ca]/30 to-[#ff0080]/30 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[10%] h-[380px] w-[500px] rounded-full bg-gradient-to-br from-[#00dfd8]/30 via-[#f9cb28]/35 to-[#ff4d4d]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3] animate-pulse"></span>
          <span>Optische subtraktive Farbphysik &amp; Bauhaus Farblehre</span>
        </div>

        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-5xl lg:text-6xl leading-[1.1]">
          Farbwissenschaft mit echten physikalischen Pigmenten
        </h1>

        <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
          Digitale Bildschirmwerkzeuge mitteln RGB-Lichtkanäle linear, wodurch Mischungen zu trübem Graubraun verblassen. <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong> simuliert physikalische Lichtabsorption und die klassische Bauhaus-Farblehre nach Johannes Itten — für lebendige, authentische Farbpaletten.
        </p>

        <!-- Primary Dual-Tool Action Cards -->
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 text-left">
          <!-- Card 1: Mixing Studio -->
          <a
            href="/mix"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  Subtraktive Farboptik
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Farben Mischen Simulator
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Mischen Sie Farben mit echten Schiebereglern und physikalischer Lichtabsorption. Erleben Sie, wie Blau + Gelb ein leuchtendes Grün ergibt — mit Live-Mischtabelle und CSS <code class="font-mono text-xs">color-mix()</code> Code.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Farbmischer öffnen</span>
              <span class="text-xs text-[#8f8f8f]">· 4 Mischmodi</span>
            </div>
          </a>

          <!-- Card 2: Artist Wheel Studio -->
          <a
            href="/color-wheel"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Itten Bauhaus Farbrad
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Farbkreis & Farbrad Online
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Entdecken Sie den Farbkreis nach Johannes Itten mit 12 Farbtönen, bei dem Rot gegenüber von Grün liegt. Inklusive Farbpaletten-Generator, 9-Stufen-Schattierungsskala und WCAG 2.1 Kontrastprüfung.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Farbkreis starten</span>
              <span class="text-xs text-[#8f8f8f]">· 6 Harmonien</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ExploreColorTools lang="de" currentPage="home" />
</Layout>
