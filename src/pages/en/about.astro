---
import Layout from '../../layouts/Layout.astro';
import JumpNav from '../../components/JumpNav.astro';
import AboutBodySection from '../../components/AboutBodySection.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';
import { buildAboutPageSchemas } from '../../utils/seoSchema';
import { aboutJumpLinks } from '../../i18n/toolGuides';

const aboutSchema = buildAboutPageSchemas({
  lang: 'en',
  url: 'https://pigmentlaboratory.com/en/about',
  pageName: 'About PigmentLab',
  pageDescription: 'Learn about PigmentLab, our subtractive color science engine, Kubelka-Munk pigment physics, and Johannes Itten Bauhaus color theory.',
  orgDescription: 'Realistic physical color tools based on subtractive pigment absorption physics and Johannes Itten Bauhaus RYB color theory.',
  articleHeadline: 'Why Linear RGB Mixing Fails: Kubelka-Munk Pigment Physics & Bauhaus Color Theory',
  articleDescription: 'How PigmentLab replaces additive RGB averaging with spectral Kubelka-Munk pigment absorption, Johannes Itten’s RYB circle, and modern W3C OKLCH and WCAG 2.1 standards.',
});
---

<Layout
  title="About PigmentLab — Subtractive Color Physics & Theory"
  description="Discover the story, optical physics, and mission behind PigmentLab. Bridging Johannes Itten's Bauhaus theory with spectral Kubelka-Munk pigment absorption."
  keywords="about pigmentlab, pigmentlab story, pigmentlab mission, subtractive color physics, kubelka-munk theory, johannes itten theory, optical color science"
  currentPath="/en/about"
  lang="en"
  schema={aboutSchema}
>
  <!-- Hero Section -->
  <section id="mission" class="scroll-mt-20 relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[30%] left-[20%] h-[400px] w-[500px] rounded-full bg-gradient-to-tr from-[#007cf0]/30 via-[#7928ca]/25 to-[#ff0080]/25 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[15%] h-[360px] w-[460px] rounded-full bg-gradient-to-br from-[#00dfd8]/25 via-[#f9cb28]/30 to-[#ff4d4d]/25 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
          <span>Our Mission & Scientific Foundation</span>
        </div>

        <h1 class="mt-6 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl lg:text-6xl leading-[1.12]">
          Physical Paint Realism for the Modern Digital Age
        </h1>

        <p class="mx-auto mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
          For decades, computer screens have forced creators to work with <strong class="text-[#171717] dark:text-white font-medium">additive RGB light</strong>, which turns mixed paints into dull, murky grey. <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong> was born to restore authentic physical light absorption and classical Bauhaus color harmony to the web.
        </p>

        <JumpNav items={aboutJumpLinks.en} ariaLabel="Section navigation" />
      </div>
    </div>
  </section>

  <AboutBodySection lang="en" />

  <ExploreColorTools lang="en" currentPage="about" />
</Layout>

