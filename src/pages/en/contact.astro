---
import Layout from '../../layouts/Layout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contact PigmentLab',
  'url': 'https://pigmentlaboratory.com/en/contact',
  'description': 'Contact the PigmentLab team. Send feedback, suggest new physical paint pigments, report bugs, or inquire about color science partnerships.',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com',
    'email': 'contact@pigmentlaboratory.com'
  }
};
---

<Layout
  title="Contact Us — PigmentLab"
  description="Have questions about Kubelka-Munk pigment physics, Johannes Itten color theory, or want to suggest a paint pigment? Get in touch with the PigmentLab team."
  keywords="contact pigmentlab, pigmentlab support, color science feedback, pigment requests, color mixer questions"
  currentPath="/en/contact"
  lang="en"
  schema={contactSchema}
>
  <!-- Header -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>We'd Love to Hear From You</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Get in Touch with PigmentLab
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        Have a question about subtractive pigment physics, want to suggest a new artist paint preset, or found an issue? We're here to help.
      </p>
    </div>
  </section>

  <!-- Main Grid: Form + Direct Contact Details -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Form Column (7 cols) -->
        <div class="lg:col-span-7 rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 sm:p-8 shadow-xs">
          <div id="contact-form-container">
            <h2 class="text-xl font-semibold text-[#171717] dark:text-white">
              Send Us a Message
            </h2>
            <p class="mt-1 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
              Fill out the form below and we will get back to you as soon as possible.
            </p>

            <form id="contact-form" class="mt-6 space-y-4">
              <!-- Name -->
              <div>
                <label for="contact-name" class="block text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] uppercase tracking-wider">
                  Your Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="e.g. Leonardo or Elena"
                  class="mt-1.5 w-full rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#161616] px-3.5 py-2.5 text-sm text-[#171717] dark:text-white placeholder-[#8f8f8f] focus:border-[#171717] focus:outline-none dark:focus:border-white transition-colors"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="contact-email" class="block text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] uppercase tracking-wider">
                  Email Address <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="mt-1.5 w-full rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#161616] px-3.5 py-2.5 text-sm text-[#171717] dark:text-white placeholder-[#8f8f8f] focus:border-[#171717] focus:outline-none dark:focus:border-white transition-colors"
                />
              </div>

              <!-- Inquiry Type -->
              <div>
                <label for="contact-subject" class="block text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] uppercase tracking-wider">
                  Topic / Inquiry Type
                </label>
                <select
                  id="contact-subject"
                  name="subject"
                  class="mt-1.5 w-full rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#161616] px-3.5 py-2.5 text-sm text-[#171717] dark:text-white focus:border-[#171717] focus:outline-none dark:focus:border-white transition-colors"
                >
                  <option value="General Inquiry">General Question / Inquiry</option>
                  <option value="Pigment Suggestion">Suggest a New Pigment / Paint Preset</option>
                  <option value="Physics Feedback">Color Science & Kubelka-Munk Math</option>
                  <option value="Bug Report">Bug Report / Technical Issue</option>
                  <option value="Collaboration">Design Collaboration / Partnership</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="contact-message" class="block text-xs font-mono font-medium text-[#171717] dark:text-[#ededed] uppercase tracking-wider">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Tell us what you have in mind..."
                  class="mt-1.5 w-full rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#161616] px-3.5 py-2.5 text-sm text-[#171717] dark:text-white placeholder-[#8f8f8f] focus:border-[#171717] focus:outline-none dark:focus:border-white transition-colors"
                ></textarea>
              </div>

              <div id="form-error-alert" class="hidden rounded-xl bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/40 p-3 text-xs text-red-600 dark:text-red-400">
                Please fill in all required fields with a valid email.
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                id="contact-submit-btn"
                class="w-full inline-flex h-11 items-center justify-center rounded-xl bg-[#171717] px-6 text-sm font-medium text-white shadow-xs transition-colors hover:bg-black dark:bg-white dark:text-[#171717] dark:hover:bg-[#ededed] cursor-pointer"
              >
                Send Message →
              </button>
            </form>
          </div>

          <!-- Success State (Shown after submit) -->
          <div id="contact-success-state" class="hidden text-center py-8">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="mt-4 text-xl font-bold text-[#171717] dark:text-white">Message Received!</h3>
            <p class="mt-2 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed max-w-md mx-auto">
              Thank you for writing to PigmentLab. We have received your message and will review it carefully. We typically respond within 24–48 hours.
            </p>
            <button
              id="reset-form-btn"
              type="button"
              class="mt-6 inline-flex h-9 items-center justify-center rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#161616] px-5 text-xs font-medium text-[#171717] dark:text-white hover:bg-[#ebebeb] dark:hover:bg-[#222222] transition-colors cursor-pointer"
            >
              Send Another Message
            </button>
          </div>
        </div>

        <!-- Details Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Direct Emails Card -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-base font-semibold text-[#171717] dark:text-white">
              Direct Communication
            </h3>
            <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">
              Prefer to email directly? Use the appropriate address below:
            </p>

            <ul class="mt-4 space-y-3.5 text-xs sm:text-sm">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">💬</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">General Inquiries & Support</strong>
                  <a href="mailto:contact@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    contact@pigmentlaboratory.com
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">🔬</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">Physics & Pigment Suggestions</strong>
                  <a href="mailto:physics@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    physics@pigmentlaboratory.com
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">🔒</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">Privacy & Legal Department</strong>
                  <a href="mailto:privacy@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    privacy@pigmentlaboratory.com
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Response Expectation Card -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-sm font-semibold text-[#171717] dark:text-white flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Response Time
            </h3>
            <p class="mt-2 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
              We typically review and respond to incoming emails within <strong class="text-[#171717] dark:text-white">24 to 48 hours</strong> during standard business days.
            </p>
          </div>

          <!-- Useful Links -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">
              Helpful Resources
            </h3>
            <ul class="mt-3 space-y-2 text-xs">
              <li>
                <a href="/en/about" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Learn About PigmentLab's Physics</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/en/mix" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Subtractive Color Mixing Studio</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/en/color-wheel" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Johannes Itten Artist Wheel</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/en/privacy" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Privacy Policy & LocalStorage</span>
                  <span>→</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">
          Frequently Asked Questions
        </h2>
        <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
          Quick answers to common questions about PigmentLab's physics, licensing, and tools.
        </p>
      </div>

      <div class="mt-10 space-y-4">
        <!-- Q1 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Can I use colors and CSS code from PigmentLab in commercial products?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Yes, 100%! All color recipes, hex values, OKLCH variables, and CSS code snippets generated by PigmentLab are free for you to use in any personal, open-source, or commercial application without any royalty or mandatory license attribution.
          </p>
        </details>

        <!-- Q2 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>How does the Subtractive Color Mixer differ from standard RGB color pickers?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Standard digital screen pickers linearly add RGB light channels together, which turns mixtures like blue and yellow into dull muddy grey. PigmentLab simulates physical particle absorption and scattering (Kubelka-Munk theory), producing the true emerald green that occurs when real paint pigments absorb light.
          </p>
        </details>

        <!-- Q3 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Can I suggest a specific physical paint pigment to be added to the mixer?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Absolutely! We are continuously expanding our spectral database. If there is a particular artist pigment (such as Quinacridone Magenta, Burnt Umber, or Naples Yellow) you would like to see modeled, select "Suggest a New Pigment" in the form above.
          </p>
        </details>

        <!-- Q4 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Where are my saved custom presets and workspace changes stored?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Your custom presets and active work sessions (in the Color Mixer and Color Wheel) are saved locally on your device inside your browser's <code class="font-mono text-xs">localStorage</code> (<code class="font-mono text-xs">pl_pigment_presets_v1</code>, <code class="font-mono text-xs">pl_color_mixer_state_v1</code>, and <code class="font-mono text-xs">pl_color_wheel_state_v1</code>). They remain private to your machine, prevent accidental data loss on refresh, and are never uploaded to any remote server.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- Client-side Form Handling Script -->
  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const formContainer = document.getElementById('contact-form-container');
      const successState = document.getElementById('contact-success-state');
      const errorAlert = document.getElementById('form-error-alert');
      const resetBtn = document.getElementById('reset-form-btn');
      const submitBtn = document.getElementById('contact-submit-btn');

      if (!form) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorAlert?.classList.add('hidden');

        const name = document.getElementById('contact-name')?.value.trim();
        const email = document.getElementById('contact-email')?.value.trim();
        const message = document.getElementById('contact-message')?.value.trim();

        if (!name || !email || !message) {
          errorAlert?.classList.remove('hidden');
          return;
        }

        // Visual loading state
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending message...';
        }

        setTimeout(() => {
          formContainer?.classList.add('hidden');
          successState?.classList.remove('hidden');
          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Send Message →';
          }
        }, 600);
      });

      resetBtn?.addEventListener('click', function () {
        successState?.classList.add('hidden');
        formContainer?.classList.remove('hidden');
      });
    })();
  </script>
</Layout>

