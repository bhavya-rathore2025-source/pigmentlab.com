---
import Layout from '../../layouts/Layout.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'PigmentLab',
  'url': 'https://pigmentlaboratory.com/en',
  'description': 'Online color science and pigment physics platform. Experience authentic subtractive pigment absorption and Johannes Itten Bauhaus color palettes for digital creators.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com',
    'logo': 'https://pigmentlaboratory.com/favicon.svg'
  }
};
---

<Layout
  title="PigmentLab — Subtractive Color Physics & Bauhaus Color Theory"
  description="Explore PigmentLab's physics-based color suite. Discover authentic physical light absorption, Johannes Itten Bauhaus color palettes, and real-time accessibility contrast analysis."
  keywords="pigmentlab, pigment lab, pigment physics, kubelka munk, itten color theory, subtractive color science, artist color platform, pigment absorption"
  currentPath="/en"
  lang="en"
  schema={websiteSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-35 dark:opacity-25">
      <div class="absolute -top-[25%] left-[15%] h-[420px] w-[600px] rounded-full bg-gradient-to-tr from-[#007cf0]/35 via-[#7928ca]/30 to-[#ff0080]/30 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[10%] h-[380px] w-[500px] rounded-full bg-gradient-to-br from-[#00dfd8]/30 via-[#f9cb28]/35 to-[#ff4d4d]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3] animate-pulse"></span>
          <span>Optical Subtractive Science & Classical Theory</span>
        </div>

        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-5xl lg:text-6xl leading-[1.1]">
          Color Science Built on Real Physical Pigments
        </h1>

        <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
          Standard digital screen tools linearly average RGB light channels, turning mixtures into dull brownish-grey. <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong> models physical particle absorption and classical Bauhaus color theory—delivering vibrant, authentic color palettes for artists, UI designers, and educators.
        </p>

        <!-- Primary Dual-Tool Action Cards -->
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 text-left">
          <a
            href="/en/mix"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  Subtractive Paint Optics
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Pigment Blending Studio
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Blend custom proportion sliders with authentic subtractive light scattering. Experience Blue + Yellow yielding vibrant emerald Green, with real-time CSS <code class="font-mono text-xs">color-mix()</code> code generation.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Launch Blending Studio</span>
              <span class="text-xs text-[#8f8f8f]">· 4 blend modes</span>
            </div>
          </a>

          <a
            href="/en/color-wheel"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Bauhaus RYB Model
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Bauhaus Artist Wheel Studio
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Explore Johannes Itten's classical 12-hue artist color circle where Red opposes Green and Blue opposes Orange. Features 9-step shade scales, WCAG 2.1 matrix scores, and color blindness simulations.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Open Artist Wheel Studio</span>
              <span class="text-xs text-[#8f8f8f]">· 6 palette modes</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ExploreColorTools lang="en" currentPage="home" />
</Layout>

