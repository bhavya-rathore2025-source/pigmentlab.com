---
import Layout from '../../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Terms & Conditions — PigmentLab',
  'url': 'https://pigmentlaboratory.com/en/terms',
  'description': 'Terms of Service and Conditions for PigmentLab. Free for personal and commercial creative use with clear intellectual property ownership rights.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com'
  }
};
---

<Layout
  title="Terms & Conditions — PigmentLab"
  description="Review the Terms and Conditions of PigmentLab. Clear, fair guidelines granting full commercial ownership of your generated color palettes and CSS code."
  keywords="pigmentlab terms, terms and conditions, terms of service, commercial license, color tools legal"
  currentPath="/en/terms"
  lang="en"
  schema={termsSchema}
>
  <!-- Header -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
        <span>Transparent & Creator-Friendly</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Terms & Conditions
      </h1>

      <p class="mt-3 text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] font-mono">
        Effective & Last Updated: November 2026 · Version 1.2
      </p>

      <p class="mt-5 text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        Welcome to <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong> (<a href="https://pigmentlaboratory.com" class="underline hover:text-[#0070f3]">pigmentlaboratory.com</a>). By accessing or using our website, tools, and color science engines, you agree to comply with and be bound by the following Terms and Conditions.
      </p>
    </div>
  </section>

  <!-- At a Glance Cards -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-10">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">
        Summary for Creators & Developers
      </h2>

      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">You Own Your Colors</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            All palettes, CSS code, and hex values you mix belong to you for personal, open-source, or commercial use.
          </p>
        </div>

        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">Zero Royalties</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            No licensing fees or mandatory attribution required (though a shoutout to pigmentlaboratory.com is always appreciated).
          </p>
        </div>

        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">Provided Free "As-Is"</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Simulations provide scientific estimations; always test physical dye batches prior to high-volume manufacturing.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Terms Content -->
  <section class="bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12 text-sm sm:text-base leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">

      <!-- Section 1 -->
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          1. Acceptance of Terms
        </h2>
        <p class="mt-4">
          By visiting, browsing, or using any part of PigmentLab, you affirm that you are of legal age to enter into this agreement or have obtained parental/guardian consent. If you do not accept all provisions in these Terms, you must immediately cease accessing the site.
        </p>
      </div>

      <!-- Section 2 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          2. Description of the Service
        </h2>
        <p class="mt-4">
          PigmentLab offers online computational color science tools, including:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-sm">
          <li><strong>Subtractive Color Mixing Studio:</strong> Kubelka-Munk optical absorption and scattering simulations.</li>
          <li><strong>Bauhaus Artist Wheel:</strong> Johannes Itten 12-hue RYB circle with classical harmony and shade generators.</li>
          <li><strong>Accessibility Auditing:</strong> WCAG 2.1 contrast ratio calculations and Daltonization CVD simulation previewers.</li>
          <li><strong>CSS & Design Token Exporters:</strong> Real-time CSS <code class="font-mono text-xs">color-mix()</code>, OKLCH, OKLab, HEX, RGB values.</li>
        </ul>
        <p class="mt-3 text-sm">
          We reserve the right to improve, modify, or temporarily suspend aspects of the service without prior notice to maintain software quality.
        </p>
      </div>

      <!-- Section 3 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          3. Ownership of Generated Colors & Commercial License
        </h2>
        <p class="mt-4">
          We believe color is a universal human asset. <strong>PigmentLab claims zero ownership over any color values, color palettes, mix recipes, or CSS styling code generated using our platform.</strong>
        </p>
        <p class="mt-3">
          You are granted a worldwide, perpetual, irrevocable, royalty-free license to use, publish, distribute, incorporate, and commercially exploit any color combinations, palettes, or CSS code you produce using PigmentLab in:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-sm">
          <li>Commercial web and mobile software, UI kits, design systems, and apps.</li>
          <li>Physical artworks, paintings, textiles, interior design, and industrial products.</li>
          <li>Marketing collateral, branding assets, logo design, and printed media.</li>
          <li>Open-source software libraries and educational curriculum materials.</li>
        </ul>
      </div>

      <!-- Section 4 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          4. Intellectual Property of PigmentLab
        </h2>
        <p class="mt-4">
          While your generated color outputs belong entirely to you, the PigmentLab website, its visual interface, brand identity, logos, proprietary mathematical source code, and original instructional documentation are the intellectual property of PigmentLab and are protected under international copyright and trademark laws. You agree not to reverse-engineer, decompile, or frame the website for competitive replication without express prior written consent.
        </p>
      </div>

      <!-- Section 5 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          5. Color Accuracy & Scientific Disclaimer
        </h2>
        <p class="mt-4">
          PigmentLab strives for the highest degree of physical and optical realism. However, please be advised of inherent physical and display limitations:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-sm">
          <li><strong>Display Hardware Gamuts:</strong> Consumer displays operate in RGB color gamuts (sRGB, Display P3). Certain physical paint pigments possess reflectance spectra that lie outside standard digital gamut boundaries.</li>
          <li><strong>Manufacturer Variations:</strong> Real-world paint formulations (e.g., Cadmium Yellow or Cobalt Blue) vary between brands (Winsor &amp; Newton, Golden, Gamblin) based on pigment binder purity, mill grain size, and optical density.</li>
          <li><strong>Industrial Applications:</strong> For critical industrial manufacturing (automotive coatings, commercial plastics, textile batch dyeing), computational models must always be physically validated using spectrophotometers in a controlled lighting booth.</li>
        </ul>
      </div>

      <!-- Section 6 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          6. Acceptable Use Policy
        </h2>
        <p class="mt-4">
          When using PigmentLab, you agree not to:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-sm">
          <li>Attempt to disrupt, flood, or compromise our hosting network through denial-of-service (DDoS) attacks.</li>
          <li>Deploy automated scrapers or bots in a manner that degrades service performance for other creators.</li>
          <li>Misrepresent PigmentLab or falsely claim official endorsement by PigmentLab.</li>
        </ul>
      </div>

      <!-- Section 7 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          7. Disclaimer of Warranties
        </h2>
        <p class="mt-4">
          PigmentLab is provided on an <strong>"as is"</strong> and <strong>"as available"</strong> basis, without warranties of any kind, whether express, statutory, or implied. To the fullest extent permissible by law, PigmentLab disclaims all warranties, including merchantability, fitness for a specific purpose, accuracy, or uninterrupted service.
        </p>
      </div>

      <!-- Section 8 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          8. Limitation of Liability
        </h2>
        <p class="mt-4">
          Under no circumstances shall PigmentLab, its founders, or contributors be held liable for any direct, indirect, incidental, special, or consequential damages (including loss of profits, physical dye production errors, or business interruption) resulting from the use or inability to use the platform.
        </p>
      </div>

      <!-- Section 9 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          9. Governing Law
        </h2>
        <p class="mt-4">
          These Terms shall be interpreted and governed in accordance with applicable general commercial laws, without regard to conflict of law principles.
        </p>
      </div>

      <!-- Section 10 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          10. Contact Information
        </h2>
        <p class="mt-4">
          If you have questions or concerns regarding these Terms and Conditions, please contact us at:
        </p>
        <div class="mt-4 rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#141414] p-5">
          <p class="font-mono text-sm text-[#171717] dark:text-white">
            <strong>Email:</strong> <a href="mailto:legal@pigmentlaboratory.com" class="text-[#0070f3] hover:underline">legal@pigmentlaboratory.com</a>
          </p>
          <p class="mt-2 text-xs text-[#8f8f8f] dark:text-[#737373]">
            Or submit an inquiry directly via our <a href="/contact" class="text-[#171717] dark:text-white underline">Contact Us Page</a>.
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>

