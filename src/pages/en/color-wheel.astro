---
import Layout from '../../layouts/Layout.astro';
import ColorWheelStudio from '../../components/ColorWheelStudio.astro';
import JumpNav from '../../components/JumpNav.astro';
import ModularToolSections from '../../components/ModularToolSections.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';
import { buildWheelPageSchemas } from '../../utils/seoSchema';
import { wheelJumpLinks } from '../../i18n/toolGuides';

const colorWheelFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is a color wheel picker and how is it used in design?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A color wheel picker is an interactive design tool that arranges the visible spectrum into a geometric circle. It allows designers and artists to select base hues, adjust saturation and brightness, and calculate mathematically balanced color palettes such as complementary, analogous, and triadic schemes.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How does this tool compare to the Adobe Color Wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Unlike Adobe Color Wheel, which relies solely on digital additive RGB angles and requires an Adobe Creative Cloud account to save palettes, our Color Wheel Picker offers a 1-click toggle between classical Johannes Itten artist RYB (Red opposite Green) and digital RGB, real-time WCAG 2.1 AA/AAA contrast scoring, a 9-step tint and shade scale, and zero account or login requirements.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is a complementary color wheel and why is it important?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A complementary color wheel maps colors that sit directly opposite each other across the 360-degree circle (such as Red and Green, or Blue and Orange). These pairs create maximum visual contrast through simultaneous contrast, making them ideal for high-impact call-to-action buttons, badges, and focal points.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is the difference between an Itten RYB color wheel chart and a digital RGB wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'On a traditional Johannes Itten RYB color wheel chart, the primary pigments are Red, Yellow, and Blue, placing Red opposite Green and Blue opposite Orange. On a digital RGB screen wheel, the primaries are Red, Green, and Blue light, placing Red opposite Cyan and Blue opposite Yellow.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Can I check accessibility and color blindness on this color wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. Our color wheel picker includes a real-time WCAG 2.1 contrast matrix with AA and AAA pass/fail badges, plus a color vision deficiency simulator supporting Protanopia, Deuteranopia, Tritanopia, and Monochromacy.'
      }
    }
  ]
};

const pageSchema = buildWheelPageSchemas({
  lang: 'en',
  url: 'https://pigmentlaboratory.com/en/color-wheel',
  appName: 'PigmentLab Color Wheel Picker & Palette Generator',
  appDescription: 'Free online color wheel picker with Johannes Itten RYB artist mode, digital RGB mode, complementary color wheel generator, WCAG 2.1 contrast checking, and 9-step shade scales.',
  articleHeadline: 'Johannes Itten RYB Artist Color Wheel vs. Digital RGB Wheel Guide',
  articleDescription: 'Comparing the 12-hue Bauhaus RYB artist color wheel with additive RGB pickers, harmony geometry, 9-step shade scales, and WCAG 2.1 contrast testing.',
  currency: 'USD',
  faqSchema: colorWheelFaqSchema,
});
---

<Layout
  title="Color Wheel Picker & Palette Generator — Complementary Color Wheel"
  description="Interactive color wheel picker featuring Johannes Itten's 12-hue Bauhaus artist wheel (RYB) and digital RGB modes. Generate complementary color wheel palettes, 9-step tint scales, and test WCAG contrast. Premier Adobe Color Wheel alternative."
  keywords="color wheel, color wheel picker, adobe color wheel, color wheel chart, complementary color wheel, itten color wheel, color scheme generator, color palette builder"
  currentPath="/en/color-wheel"
  lang="en"
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Johannes Itten Bauhaus Wheel & Color Palettes</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Color Wheel Picker & Palette Generator
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Standard screen pickers like the Adobe Color Wheel only use digital RGB angles (Red opposite Cyan). PigmentLab provides a 1-click toggle to switch between the traditional <strong class="text-[#171717] dark:text-white">Johannes Itten Bauhaus RYB artist color wheel</strong> (where <span class="text-[#c41e3a] font-semibold">Red</span> is opposite <span class="text-[#14b82a] font-semibold">Green</span>) and the standard digital web color wheel chart.
        </p>
        <JumpNav items={wheelJumpLinks.en} ariaLabel="Section navigation" />
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ColorWheelStudio lang="en" />

  <!-- Comprehensive Educational Guide & SEO Section -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Color Theory & Palette Science</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          The Complete Guide to the Color Wheel, Color Wheel Picker & Color Palettes
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Master color relationships, generate balanced complementary palettes, and understand classical vs digital color spaces.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Understanding the Color Wheel and Interactive Color Wheel Picker
          </h3>
          <p>
            The <strong>color wheel</strong> is the cornerstone of color theory, graphic design, and artistic composition. Originating from Sir Isaac Newton’s 1666 circular refraction diagram and later expanded by Goethe and Bauhaus master Johannes Itten, the <strong>color wheel</strong> maps the continuous spectrum of visible light into a manageable geometric circle. Whether you are creating brand identity guidelines, designing accessible user interfaces, or mixing physical paint on canvas, the <strong>color wheel</strong> enables you to predict visual contrast and balance with scientific certainty.
          </p>
          <p>
            An interactive <strong>color wheel picker</strong> takes this classical foundation and elevates it for the digital age. Instead of manually guessing hex codes or relying on clunky operating system dialogs, a dedicated <strong>color wheel picker</strong> allows you to select a primary base hue, sweep across 360 degrees of tonal variations, and automatically calculate balanced secondary and accent palette colors.
          </p>
        </section>

        <section id="itten-vs-rgb" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. The 12-Hue Color Wheel Chart: Classical Artist RYB vs. Digital RGB
          </h3>
          <p>
            A <strong>color wheel chart</strong> organizes twelve principal hues into primary, secondary, and tertiary categories. However, the geometric placement of opposite hues differs fundamentally between the traditional artist <strong>color wheel chart</strong> and digital computer screens:
          </p>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Base Hue</th>
                  <th class="p-4 sm:p-5 text-[#c41e3a] font-semibold">Artist Wheel (Itten RYB) Opposite</th>
                  <th class="p-4 sm:p-5 text-[#0070f3] font-semibold">Digital Screen (RGB) Opposite</th>
                  <th class="p-4 sm:p-5">Color Type</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Red (#E60026)</td>
                  <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400 font-medium">Green (#00AA44)</td>
                  <td class="p-4 sm:p-5 text-cyan-600 dark:text-cyan-400">Cyan (#00FFFF)</td>
                  <td class="p-4 sm:p-5">Primary</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Yellow (#FFE600)</td>
                  <td class="p-4 sm:p-5 text-purple-600 dark:text-purple-400 font-medium">Purple (#7A0099)</td>
                  <td class="p-4 sm:p-5 text-blue-600 dark:text-blue-400">Blue (#0000FF)</td>
                  <td class="p-4 sm:p-5">Primary</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Blue (#002185)</td>
                  <td class="p-4 sm:p-5 text-orange-600 dark:text-orange-400 font-medium">Orange (#FF6600)</td>
                  <td class="p-4 sm:p-5 text-yellow-600 dark:text-yellow-400">Yellow (#FFFF00)</td>
                  <td class="p-4 sm:p-5">Primary</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="harmonies" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            3. Complementary Color Wheel Harmonies
          </h3>
          <p>
            The <strong>complementary color wheel</strong> harmony is the single most celebrated visual relationship in design history. By pairing colors located exactly 180 degrees apart, each color amplifies the perceived intensity of the other through physiological simultaneous contrast. In UI and graphic design, complementary pairings create instant focal clarity.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            4. Why PigmentLab is the Superior Adobe Color Wheel Alternative
          </h3>
          <p>
            While the <strong>Adobe Color Wheel</strong> has long been an industry mainstay, it is locked into Adobe's ecosystem and purely additive digital RGB angles. PigmentLab offers:
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Classical Johannes Itten RYB Mode:</strong> True artist color harmony (Red opposite Green).</li>
            <li><strong>Zero Login or Account Barrier:</strong> Complete instant access with local storage persistence.</li>
            <li><strong>Built-in WCAG 2.1 Contrast Matrix:</strong> Instant AA/AAA accessibility scoring.</li>
            <li><strong>Multi-Format Exports:</strong> Tailwind CSS tokens, CSS variables, and SVG swatches.</li>
          </ul>
        </section>

        <ModularToolSections tool="wheel" lang="en" />

        <!-- FAQs -->
        <section id="faq" class="scroll-mt-20 space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Frequently Asked Questions
          </h3>
          <div class="space-y-4">
            {colorWheelFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>

  <ExploreColorTools lang="en" currentPage="wheel" />
</Layout>

