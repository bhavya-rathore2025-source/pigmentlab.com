---
import Layout from '../../layouts/Layout.astro';
import ColorWheelStudio from '../../components/ColorWheelStudio.astro';
import JumpNav from '../../components/JumpNav.astro';
import ModularToolSections from '../../components/ModularToolSections.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';
import { buildWheelPageSchemas } from '../../utils/seoSchema';
import { wheelJumpLinks } from '../../i18n/toolGuides';

const ptFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'O que é o círculo cromático e como usar na combinação de cores?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'O círculo cromático é uma ferramenta geométrica que organiza as cores do espectro visível em 360 graus. Ele é amplamente utilizado por designers, maquiadores, consultores de moda e artistas para encontrar harmonias como cores complementares, análogas e triádicas.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Qual a diferença entre a roda de cores de Itten (RYB) e o padrão digital RGB?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No círculo cromático de Johannes Itten (Bauhaus RYB), as cores primárias são Vermelho, Amarelo e Azul, posicionando o Vermelho oposto ao Verde. Nas telas digitais RGB, o Vermelho fica oposto ao Ciano. O modelo de Itten reflete a mistura física de tintas e tecidos.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Círculo cromático: quais cores combinam entre si? (Harmonias de cores)',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Para saber quais cores combinam no círculo cromático, aplicam-se regras geométricas consagradas: 1. Cores Complementares (opostas a 180°, como Azul e Laranja) para contraste marcante e botões de destaque. 2. Cores Análogas (lado a lado no círculo, como Verde, Azul-Verde e Azul) para combinações elegantes e harmônicas. 3. Tríades (formam um triângulo de 120°, como Amarelo, Vermelho e Azul) para paletas ricas e dinâmicas. 4. Monocromáticas (tons claros e escuros de uma mesma cor base).'
      }
    },
    {
      '@type': 'Question',
      'name': 'Como este círculo cromático online se compara à roda de cores Adobe?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A PigmentLab oferece um botão direto para alternar entre o círculo cromático de Itten (RYB) e o digital RGB, cálculo imediato de contraste WCAG 2.1 (AA e AAA) e não exige cadastro nem assinatura Adobe Creative Cloud.'
      }
    }
  ]
};

const ptWheelSchema = buildWheelPageSchemas({
  lang: 'pt',
  url: 'https://pigmentlaboratory.com/pt/color-wheel',
  appName: 'PigmentLab Círculo Cromático Online & Roda de Cores — Cores Complementares',
  appDescription: 'Círculo cromático online interativo e roda de cores com modelo de Johannes Itten (RYB) e RGB. Gere cores complementares, análogas e teste o contraste WCAG.',
  articleHeadline: 'Círculo Cromático de Johannes Itten (RYB) vs. Roda RGB — Guia',
  articleDescription: 'Como funciona o círculo cromático Bauhaus RYB de 12 matizes, harmonias complementares, escalas de tons e teste de contraste WCAG 2.1.',
  currency: 'BRL',
  faqSchema: ptFaqSchema,
});
---

<Layout
  title="Círculo Cromático Online & Roda de Cores — Paletas"
  description="Círculo cromático online interativo e roda de cores (RYB e RGB). Cores complementares, harmonia de paletas e contraste WCAG. Alternativa à roda Adobe."
  keywords="círculo cromático, circulo cromatico, roda de cores, circulo cromatico cores, roda de cores complementares, roda de cores adobe, roda de cores ryb, roda de cores terciária, paleta de cores online, combinacao de cores"
  currentPath="/pt/color-wheel"
  lang="pt"
  schema={ptWheelSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Círculo Cromático Bauhaus &amp; Roda de Cores</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Círculo Cromático Online &amp; Roda de Cores
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          A maioria dos aplicativos na web como a roda de cores Adobe usa apenas coordenadas RGB. A PigmentLab permite alternar com 1 clique para o autêntico <strong class="text-[#171717] dark:text-white">círculo cromático de Johannes Itten (RYB)</strong>, onde o <span class="text-[#c41e3a] font-semibold">Vermelho</span> opõe-se ao <span class="text-[#14b82a] font-semibold">Verde</span> — ideal para moda, consultoria de cores e arte.
        </p>
        <JumpNav items={wheelJumpLinks.pt} ariaLabel="Navegação da página" />
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ColorWheelStudio lang="pt" />

  <!-- Educational Guide in Portuguese -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Teoria das Cores &amp; Estilo</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          Guia completo do círculo cromático, roda de cores e harmonias
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Aprenda a criar combinações perfeitas com cores complementares, análogas e entenda a diferença entre o modelo de Itten e o RGB.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. O que é o círculo cromático e para que serve?
          </h3>
          <p>
            O <strong>círculo cromático</strong> (frequentemente chamado de <strong>roda de cores</strong>) é a representação circular ordenada de todas as cores perceptíveis pelo olho humano. Ele é essencial não apenas para artes visuais e pintura, mas tornou-se indispensável no Brasil para estilistas, consultoria de imagem pessoal (colorimetria) e design gráfico.
          </p>
          <p>
            Com este <strong>círculo cromático online</strong>, você seleciona qualquer tom de partida e obtém instantaneamente paletas matematicamente equilibradas para suas criações.
          </p>
        </section>

        <section id="itten-vs-rgb" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. Círculo cromático cores: Itten RYB vs. Tela RGB
          </h3>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Cor Base</th>
                  <th class="p-4 sm:p-5 text-[#c41e3a] font-semibold">Oposta no Círculo de Itten (RYB)</th>
                  <th class="p-4 sm:p-5 text-[#0070f3] font-semibold">Oposta na Tela Digital (RGB)</th>
                  <th class="p-4 sm:p-5">Classificação</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Vermelho (#E60026)</td>
                  <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400 font-medium">Verde (#00AA44)</td>
                  <td class="p-4 sm:p-5 text-cyan-600 dark:text-cyan-400">Ciano (#00FFFF)</td>
                  <td class="p-4 sm:p-5">Primária</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Amarelo (#FFE600)</td>
                  <td class="p-4 sm:p-5 text-purple-600 dark:text-purple-400 font-medium">Violeta / Roxo (#7A0099)</td>
                  <td class="p-4 sm:p-5 text-blue-600 dark:text-blue-400">Azul (#0000FF)</td>
                  <td class="p-4 sm:p-5">Primária</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Azul (#002185)</td>
                  <td class="p-4 sm:p-5 text-orange-600 dark:text-orange-400 font-medium">Laranja (#FF6600)</td>
                  <td class="p-4 sm:p-5 text-yellow-600 dark:text-yellow-400">Amarelo (#FFFF00)</td>
                  <td class="p-4 sm:p-5">Primária</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="harmonies" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            3. Roda de cores complementares
          </h3>
          <p>
            A <strong>roda de cores complementares</strong> mapeia pares que estão em lados opostos do círculo. O contraste simultâneo entre essas cores ativa a retina e proporciona máximo impacto, muito utilizado para marcas modernas e interfaces atraentes.
          </p>
        </section>

        <ModularToolSections tool="wheel" lang="pt" />

        <!-- FAQs -->
        <section id="faq" class="scroll-mt-20 space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Perguntas Frequentes
          </h3>
          <div class="space-y-4">
            {ptFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>

  <ExploreColorTools lang="pt" currentPage="wheel" />
</Layout>

