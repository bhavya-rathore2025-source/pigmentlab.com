---
import Layout from '../../layouts/Layout.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'PigmentLab',
  'url': 'https://pigmentlaboratory.com/pt',
  'description': 'PigmentLab: Ferramentas de cores com física real de pigmentos subtrativos e teoria das cores de Johannes Itten. Simulador de mistura de cores e círculo cromático online para designers e artistas.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com',
    'logo': 'https://pigmentlaboratory.com/favicon.svg'
  }
};
---

<Layout
  title="PigmentLab — Física de Pigmentos Reais & Círculo Cromático Bauhaus"
  description="Explore o laboratório de cores da PigmentLab. Absorção de luz física real, círculo cromático de Johannes Itten (Bauhaus RYB), simulador de mistura de cores e análise de contraste WCAG."
  keywords="pigmentlab, círculo cromático, circulo cromatico, mistura de cores, roda de cores, tabela de mistura de cores, cores complementares"
  currentPath="/pt"
  lang="pt"
  schema={websiteSchema}
>
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 overflow-hidden">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-35 dark:opacity-25">
      <div class="absolute -top-[25%] left-[15%] h-[420px] w-[600px] rounded-full bg-gradient-to-tr from-[#007cf0]/35 via-[#7928ca]/30 to-[#ff0080]/30 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[10%] h-[380px] w-[500px] rounded-full bg-gradient-to-br from-[#00dfd8]/30 via-[#f9cb28]/35 to-[#ff4d4d]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3] animate-pulse"></span>
          <span>Ciência Óptica Subtrativa &amp; Teoria Bauhaus</span>
        </div>

        <h1 class="mt-5 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-5xl lg:text-6xl leading-[1.1]">
          Ciência das Cores com Pigmentos Físicos Reais
        </h1>

        <p class="mt-4 text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
          Ferramentas digitais comuns apenas calculam médias lineares de luz que resultam em tons cinzentos. O <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong> modela a absorção física da luz e a clássica teoria do Bauhaus para criar paletas autênticas.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 text-left">
          <a
            href="/pt/mix"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                  Óptica Subtrativa de Tintas
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Simulador de Mistura de Cores
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Misture proporções com dispersão autêntica da luz. Azul + Amarelo resulta em Verde esmeralda vivo, com geração de código CSS <code class="font-mono text-xs">color-mix()</code> em tempo real.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Abrir simulador</span>
              <span class="text-xs text-[#8f8f8f]">· 4 modos de mistura</span>
            </div>
          </a>

          <a
            href="/pt/color-wheel"
            class="group relative flex flex-col justify-between rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#111111] p-6 transition-all duration-200 hover:border-[#171717] dark:hover:border-white hover:shadow-lg dark:hover:shadow-2xl/40"
          >
            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1a1a1a] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
                  <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                  Modelo Itten RYB
                </span>
                <span class="text-xs font-mono text-[#8f8f8f] group-hover:translate-x-0.5 transition-transform">→</span>
              </div>
              <h2 class="mt-4 text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Círculo Cromático Online
              </h2>
              <p class="mt-2 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Explore o círculo cromático de 12 cores de Johannes Itten com Vermelho oposto ao Verde. Inclui escalas de 9 tons e matriz de pontuação de contraste WCAG 2.1.
              </p>
            </div>
            <div class="mt-6 flex items-center gap-2 pt-4 border-t border-[#ebebeb] dark:border-[#222222]">
              <span class="text-xs font-semibold text-[#171717] dark:text-white group-hover:underline">Abrir círculo cromático</span>
              <span class="text-xs text-[#8f8f8f]">· 6 harmonias</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ExploreColorTools lang="pt" currentPage="home" />
</Layout>

