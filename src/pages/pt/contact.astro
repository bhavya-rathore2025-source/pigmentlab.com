---
import Layout from '../../layouts/Layout.astro';
import ContactFormCard from '../../components/ContactFormCard.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Contato PigmentLab',
  'url': 'https://pigmentlaboratory.com/pt/contact',
  'description': 'Fale com a equipe do PigmentLab. Envie sugestões de novos pigmentos artísticos, feedbacks ou dúvidas sobre a ciência das cores.',
  'mainEntity': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com',
    'email': 'contact@pigmentlaboratory.com'
  }
};
---

<Layout
  title="Contato & Feedback — PigmentLab"
  description="Dúvidas sobre a física de pigmentos Kubelka-Munk, teoria das cores de Johannes Itten ou sugestões de pigmentos? Entre em contato com a equipe do PigmentLab."
  keywords="contato pigmentlab, suporte pigmentlab, feedback ciencia das cores, sugestao pigmento, mistura de tintas"
  currentPath="/pt/contact"
  lang="pt"
  schema={contactSchema}
>
  <!-- Header -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Ficaremos felizes em ouvir você</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Entre em Contato com o PigmentLab
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        Tem alguma dúvida sobre física subtrativa de pigmentos, quer sugerir uma nova cor artística ou compartilhar ideias? Responderemos com todo prazer.
      </p>
    </div>
  </section>

  <!-- Main Grid: Form + Direct Contact Details -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Form Column (7 cols) -->
        <ContactFormCard lang="pt" />

        <!-- Details Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <!-- Direct Emails Card -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-base font-semibold text-[#171717] dark:text-white">
              Comunicação Direta
            </h3>
            <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">
              Prefere enviar um e-mail diretamente? Utilize os canais abaixo:
            </p>

            <ul class="mt-4 space-y-3.5 text-xs sm:text-sm">
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">💬</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">Dúvidas Gerais & Suporte</strong>
                  <a href="mailto:contact@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    contact@pigmentlaboratory.com
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">🔬</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">Física & Sugestões de Pigmentos</strong>
                  <a href="mailto:physics@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    physics@pigmentlaboratory.com
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-0.5 text-base">🔒</span>
                <div>
                  <strong class="text-[#171717] dark:text-white block font-medium">Privacidade & Questões Jurídicas</strong>
                  <a href="mailto:privacy@pigmentlaboratory.com" class="text-[#0070f3] hover:underline font-mono text-xs">
                    privacy@pigmentlaboratory.com
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Response Expectation Card -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-sm font-semibold text-[#171717] dark:text-white flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Tempo de Resposta
            </h3>
            <p class="mt-2 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
              Analisamos e respondemos aos e-mails recebidos normalmente dentro de <strong class="text-[#171717] dark:text-white">24 a 48 horas</strong> em dias úteis.
            </p>
          </div>

          <!-- Useful Links -->
          <div class="rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-6 shadow-xs">
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">
              Recursos Úteis
            </h3>
            <ul class="mt-3 space-y-2 text-xs">
              <li>
                <a href="/pt/about" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Conheça a física do PigmentLab</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/pt/mix" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Estúdio de Mistura Subtrativa de Cores</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/pt/color-wheel" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Círculo Cromático de Johannes Itten</span>
                  <span>→</span>
                </a>
              </li>
              <li>
                <a href="/pt/privacy" class="text-[#171717] dark:text-white hover:text-[#0070f3] dark:hover:text-[#0070f3] flex items-center justify-between">
                  <span>Política de Privacidade e Armazenamento Local</span>
                  <span>→</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">
          Perguntas Frequentes (FAQ)
        </h2>
        <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
          Respostas rápidas sobre a ciência das cores, licenciamento e ferramentas do PigmentLab.
        </p>
      </div>

      <div class="mt-10 space-y-4">
        <!-- Q1 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Posso usar as cores e códigos CSS do PigmentLab em projetos comerciais?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Sim, 100%! Todas as fórmulas de cores, códigos hexadecimais, valores OKLCH e trechos de código CSS gerados no PigmentLab são totalmente gratuitos para uso em projetos pessoais, de código aberto ou comerciais, sem cobrança de royalties ou atribuição obrigatória.
          </p>
        </details>

        <!-- Q2 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Como o misturador subtrativo difere dos seletores RGB comuns?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Os seletores de tela padrão somam os canais de luz RGB linearmente, fazendo com que misturar azul e amarelo resulte em um cinza apagado. O PigmentLab simula a absorção e dispersão física de partículas reais (teoria Kubelka-Munk), gerando o verdadeiro verde esmeralda que ocorre quando pigmentos reais absorvem a luz.
          </p>
        </details>

        <!-- Q3 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Posso sugerir um pigmento físico de tinta específico para adicionar ao misturador?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Com certeza! Estamos sempre expandindo nosso banco de dados espectral. Se há um pigmento artístico específico (como Magenta de Quinacridona, Terra de Sombra Queimada ou Amarelo de Nápoles) que você gostaria de ver disponível, selecione "Sugerir Novo Pigmento" no formulário acima.
          </p>
        </details>

        <!-- Q4 -->
        <details class="group rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-[#fafafa] dark:bg-[#121212] p-5 [&_svg]:open:-rotate-180">
          <summary class="flex cursor-pointer items-center justify-between font-medium text-sm text-[#171717] dark:text-white list-none">
            <span>Onde ficam salvas minhas predefinições e sessões de trabalho?</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-200 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Suas configurações personalizadas e sessões ativas são salvas localmente no seu dispositivo através do <code class="font-mono text-xs">localStorage</code> do navegador (<code class="font-mono text-xs">pl_pigment_presets_v1</code>, <code class="font-mono text-xs">pl_color_mixer_state_v1</code> e <code class="font-mono text-xs">pl_color_wheel_state_v1</code>). Elas permanecem exclusivamente no seu computador e jamais são enviadas a servidores externos.
          </p>
        </details>
      </div>
    </div>
  </section>

</Layout>
