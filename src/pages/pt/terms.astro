---
import Layout from '../../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Termos e Condições — PigmentLab',
  'url': 'https://pigmentlaboratory.com/pt/terms',
  'description': 'Termos de serviço do PigmentLab: Gratuito para uso pessoal e comercial com direitos totais sobre as paletas geradas.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com'
  }
};
---

<Layout
  title="Termos e Condições — PigmentLab"
  description="Termos e Condições de Uso da PigmentLab. Gratuito para uso pessoal e comercial sem restrições sobre suas criações."
  keywords="termos de uso pigmentlab, termos e condicoes, licenca comercial, direitos autorais paletas"
  currentPath="/pt/terms"
  lang="pt"
  schema={termsSchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 text-center">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Termos e Condições
      </h1>
      <p class="mt-4 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
        Todas as paletas de cores, misturas, códigos CSS e tokens gerados no PigmentLab pertencem exclusivamente a você e podem ser usados livremente.
      </p>
    </div>
  </section>
</Layout>

