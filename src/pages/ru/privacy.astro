---
import Layout from '../../layouts/Layout.astro';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Политика конфиденциальности — PigmentLab',
  'url': 'https://pigmentlab.com/ru/privacy',
  'description': 'Политика конфиденциальности PigmentLab: работа на стороне клиента, локальное хранилище, отсутствие слежки.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlab.com'
  }
};
---

<Layout
  title="Политика Конфиденциальности — PigmentLab"
  description="Ознакомьтесь с политикой конфиденциальности PigmentLab. Все вычисления производятся в браузере без передачи личных данных."
  keywords="политика конфиденциальности pigmentlab, приватность, локальное хранилище"
  currentPath="/ru/privacy"
  lang="ru"
  schema={privacySchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 text-center">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Политика Конфиденциальности
      </h1>
      <p class="mt-4 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
        PigmentLab выполняет все расчеты непосредственно на вашем устройстве. Мы не сохраняем ваши формулы и палитры на серверах.
      </p>
    </div>
  </section>
</Layout>

