---
import Layout from '../../layouts/Layout.astro';
import ColorWheelStudio from '../../components/ColorWheelStudio.astro';

const ruFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Что такое цветовой круг онлайн и как им пользоваться?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Цветовой круг онлайн — это интерактивный инструмент, организующий видимый спектр в замкнутый геометрический круг 360°. Он помогает художникам, графическим дизайнерам и веб-мастерам создавать гармоничные палитры цветов: комплементарные (дополнительные), триады и аналоговые схемы.'
      }
    },
    {
      '@type': 'Question',
      'name': 'В чем разница между кругом Иттена (RYB) и цифровым кругом RGB?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'В классическом круге Иоганнеса Иттена (Баухаус) основными цветами являются Красный, Желтый и Синий, где Красный находится напротив Зеленого. В экранном круге RGB красный находится напротив бирюзового (циан). Круг Иттена отражает физическое смешивание красок.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Как подобрать дополнительные цвета?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Дополнительные (комплементарные) цвета расположены прямо напротив друг друга (на 180 градусов). Они создают максимальный зрительный контраст, привлекающий внимание к ключевым элементам интерфейса.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Как называется палитра цветов?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'В дизайне и живописи упорядоченная палитра цветов называется цветовой схемой (гармонией) или цветовой гаммой. Главным инструментом для её составления служит цветовой круг (например, 12-частный круг Иоганнеса Иттена), группирующий первичные, вторичные и дополнительные оттенки.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Сколько цветов содержит палитра?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Классический спектральный цветовой круг Иттена содержит 12 основных цветов. Однако в прикладном дизайне и брендинге рабочая палитра обычно состоит из 3–5 ключевых цветов: доминирующего, вторичного, акцентного и нейтральных фоновых тонов.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Палитра цветов: как смешивать оттенки?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'После составления гармоничной палитры на цветовом круге вы можете протестировать реальное смешивание выбранных оттенков в нашем онлайн-симуляторе красок PigmentLab, который точно рассчитывает физическое поглощение света.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Можно ли проверить контрастность по WCAG?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Да. Инструмент в реальном времени оценивает контрастность всех цветов палитры по стандарту WCAG 2.1 (AA и AAA) и моделирует восприятие дальтониками.'
      }
    }
  ]
};

const ruWheelSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'PigmentLab Цветовой Круг Онлайн & Палитра Цветов — Круг Иттена',
    'url': 'https://pigmentlab.com/ru/color-wheel',
    'description': 'Интерактивный цветовой круг онлайн по теории Иоганнеса Иттена (RYB) и RGB. Подбор дополнительных цветов, генератор гармоничных палитр цветов и проверка контрастности WCAG.',
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    }
  },
  ruFaqSchema
];
---

<Layout
  title="Цветовой Круг Онлайн & Палитра Цветов — Цветовой Круг Иттена"
  description="Интерактивный цветовой круг онлайн по теории Иоганнеса Иттена (RYB) и RGB. Подбор дополнительных цветов, генератор гармоничных палитр цветов и проверка контрастности WCAG."
  keywords="цветовой круг онлайн, палитра цветов, цветовой круг иттена, круг иттена, сочетание цветов, комплементарные цвета, генератор палитры цветов онлайн, гармония цвета"
  currentPath="/ru/color-wheel"
  lang="ru"
  schema={ruWheelSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Цветовой Круг Баухаус &amp; Палитра Цветов</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Цветовой Круг Онлайн &amp; Палитра Цветов
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Большинство экранных палитр используют лишь цифровые углы RGB. PigmentLab позволяет переключиться в 1 клик на классический <strong class="text-[#171717] dark:text-white">цветовой круг Иоганнеса Иттена (RYB)</strong>, где <span class="text-[#c41e3a] font-semibold">Красный</span> расположен напротив <span class="text-[#14b82a] font-semibold">Зеленого</span>.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ColorWheelStudio lang="ru" />

  <!-- Educational Guide in Russian -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Теория Цвета &amp; Гармонии</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          Полное руководство по цветовому кругу и подбору палитры цветов
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Гармония цвета, комплементарные пары и ключевые различия между кругом Иттена и цифровым спектром RGB.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Что такое цветовой круг онлайн?
          </h3>
          <p>
            <strong>Цветовой круг онлайн</strong> — это фундаментальный ориентир для художников и дизайнеров. Разработанный на основе опытов Исаака Ньютона и систематизированный Иоганнесом Иттеном в школе Баухаус, круг упорядочивает оттенки по кругу, позволяя мгновенно определять сочетаемость.
          </p>
          <p>
            Наш генератор помогает составить гармоничную <strong>палитру цветов</strong> для интерфейсов сайтов, брендинга, интерьеров и традиционной живописи.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. Цветовой круг Иттена vs. RGB
          </h3>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Базовый цвет</th>
                  <th class="p-4 sm:p-5 text-[#c41e3a] font-semibold">Противоположный в круге Иттена (RYB)</th>
                  <th class="p-4 sm:p-5 text-[#0070f3] font-semibold">Противоположный в RGB</th>
                  <th class="p-4 sm:p-5">Тип</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Красный (#E60026)</td>
                  <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400 font-medium">Зеленый (#00AA44)</td>
                  <td class="p-4 sm:p-5 text-cyan-600 dark:text-cyan-400">Циан / Голубой (#00FFFF)</td>
                  <td class="p-4 sm:p-5">Основной (первичный)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Желтый (#FFE600)</td>
                  <td class="p-4 sm:p-5 text-purple-600 dark:text-purple-400 font-medium">Фиолетовый (#7A0099)</td>
                  <td class="p-4 sm:p-5 text-blue-600 dark:text-blue-400">Синий (#0000FF)</td>
                  <td class="p-4 sm:p-5">Основной (первичный)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Синий (#002185)</td>
                  <td class="p-4 sm:p-5 text-orange-600 dark:text-orange-400 font-medium">Оранжевый (#FF6600)</td>
                  <td class="p-4 sm:p-5 text-yellow-600 dark:text-yellow-400">Желтый (#FFFF00)</td>
                  <td class="p-4 sm:p-5">Основной (первичный)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- FAQs -->
        <section class="space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Часто задаваемые вопросы
          </h3>
          <div class="space-y-4">
            {ruFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>

