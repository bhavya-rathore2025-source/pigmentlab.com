---
import Layout from '../../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Условия Использования — PigmentLab',
  'url': 'https://pigmentlab.com/ru/terms',
  'description': 'Условия использования PigmentLab: бесплатный доступ для личных и коммерческих целей, полные права на созданные палитры.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlab.com'
  }
};
---

<Layout
  title="Условия Использования — PigmentLab"
  description="Условия использования PigmentLab. Бесплатный доступ без ограничений для коммерческих и творческих проектов."
  keywords="условия использования pigmentlab, лицензия, коммерческое использование, права на палитры"
  currentPath="/ru/terms"
  lang="ru"
  schema={termsSchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20 text-center">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Условия Использования
      </h1>
      <p class="mt-4 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
        Все палитры, коды цветов (HEX, RGB, HSL, CMYK, OKLCH) и сгенерированный CSS-код принадлежат исключительно вам.
      </p>
    </div>
  </section>
</Layout>

