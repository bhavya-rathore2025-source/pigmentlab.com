---
import Layout from '../../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': '利用規約 — PigmentLab',
  'url': 'https://pigmentlaboratory.com/ja/terms',
  'description': 'PigmentLabの利用規約。商用・個人を問わず完全無料、生成されたカラーパレットおよびCSSコードの完全な知的財産権所有権を明記。',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlaboratory.com'
  }
};
---

<Layout
  title="利用規約 — PigmentLab"
  description="PigmentLab利用規約：作成したパレットやCSSコードの商用利用権、無料利用条件、知的財産権に関するガイドライン。"
  keywords="pigmentlab 利用規約, terms of service, 商用ライセンス, 著作権, カラーパレット 知的財産権"
  currentPath="/ja/terms"
  lang="ja"
  schema={termsSchema}
>
  <!-- Header -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
        <span>透明でクリエイターに優しい利用条件</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        利用規約 (Terms & Conditions)
      </h1>

      <p class="mt-3 text-xs sm:text-sm text-[#8f8f8f] dark:text-[#737373] font-mono">
        制定・最終改定日: 2026年11月 · バージョン 1.2
      </p>

      <p class="mt-5 text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        <strong class="text-[#171717] dark:text-white font-medium">PigmentLab</strong>（<a href="https://pigmentlaboratory.com" class="underline hover:text-[#0070f3]">pigmentlaboratory.com</a>）へようこそ。当サイトのツール、色彩計算エンジンをご利用いただくにあたり、以下の利用規約にご同意いただいたものとみなします。
      </p>
    </div>
  </section>

  <!-- At a Glance Cards -->
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#000000] py-10">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">
        クリエイター・開発者のための要約
      </h2>

      <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">生成物の権利はあなたのもの</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            作成したカラーパレット、CSSコード、HEX値は、個人・商用・オープンソースを問わず自由にご利用いただけます。
          </p>
        </div>

        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">ロイヤリティフリー</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            ライセンス料や必須のクレジット表記は不要です（pigmentlaboratory.comの紹介リンクは大歓迎です）。
          </p>
        </div>

        <div class="rounded-xl border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#0e0e0e] p-5 shadow-2xs">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950/40 dark:text-blue-400 font-bold text-sm">
            ✓
          </div>
          <h3 class="mt-3 text-sm font-semibold text-[#171717] dark:text-white">完全無料・現状有姿での提供</h3>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            物理シミュレーションは科学的推計値です。大規模印刷や製造の際は事前に実物サンプルで色確認を行ってください。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Terms Content -->
  <section class="bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 space-y-12 text-sm sm:text-base leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">

      <!-- Section 1 -->
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          1. サービスの利用許諾
        </h2>
        <p class="mt-4">
          PigmentLabは、すべてのユーザーに対して、当サイトのWebツールおよび色彩シミュレーターを個人的、教育的、または商用目的で利用するための、非独占的、譲渡不可の無償ライセンスを付与します。
        </p>
      </div>

      <!-- Section 2 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          2. 知的財産権および生成物の帰属
        </h2>
        <p class="mt-4">
          当サイトのUIデザイン、独自の色彩物理アルゴリズム、ソースコードの著作権はPigmentLabに帰属します。
        </p>
        <p class="mt-3">
          一方で、<strong>ユーザーが当サイトのツールを通じて作成した混色比率、カラーパレット、エクスポートされたCSSコード、SVGアセットに対する権利は、完全にユーザー自身に帰属します</strong>。PigmentLabがユーザーの作成物に対して権利を主張することはありません。
        </p>
      </div>

      <!-- Section 3 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          3. 免責事項
        </h2>
        <p class="mt-4">
          当サイトの色彩シミュレーション（クベルカ・ムンク理論計算等）は科学的知見に基づき精密に設計されていますが、ユーザーの閲覧環境（ディスプレイの色温度、キャリブレーション、照明条件）や実物塗料の顔料ロット差により、画面表示と実際の物理塗料との間に差異が生じる場合があります。工業生産や商用印刷に用いる場合は、必ず本生産前に実物試し塗りを行ってください。
        </p>
      </div>

      <!-- Section 4 -->
      <div class="pt-6 border-t border-[#ebebeb] dark:border-[#222222]">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-[#171717] dark:text-white">
          4. 規約の変更
        </h2>
        <p class="mt-4">
          当サイトは、必要に応じて本利用規約を随時改定できるものとします。最新の改定日は本ページ上部に明記されます。
        </p>
      </div>

    </div>
  </section>
</Layout>
