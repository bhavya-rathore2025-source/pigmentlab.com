---
import Layout from '../layouts/Layout.astro';

const colorWheelFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is a color wheel picker and how is it used in design?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A color wheel picker is an interactive design tool that arranges the visible spectrum into a geometric circle. It allows designers and artists to select base hues, adjust saturation and brightness, and calculate mathematically balanced color palettes such as complementary, analogous, and triadic schemes.'
      }
    },
    {
      '@type': 'Question',
      'name': 'How does this tool compare to the Adobe Color Wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Unlike Adobe Color Wheel, which relies solely on digital additive RGB angles and requires an Adobe Creative Cloud account to save palettes, our Color Wheel Picker offers a 1-click toggle between classical Johannes Itten artist RYB (Red opposite Green) and digital RGB, real-time WCAG 2.1 AA/AAA contrast scoring, a 9-step tint and shade scale, and zero account or login requirements.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is a complementary color wheel and why is it important?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A complementary color wheel maps colors that sit directly opposite each other across the 360-degree circle (such as Red and Green, or Blue and Orange). These pairs create maximum visual contrast through simultaneous contrast, making them ideal for high-impact call-to-action buttons, badges, and focal points.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is the difference between an Itten RYB color wheel chart and a digital RGB wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'On a traditional Johannes Itten RYB color wheel chart, the primary pigments are Red, Yellow, and Blue, placing Red opposite Green and Blue opposite Orange. On a digital RGB screen wheel, the primaries are Red, Green, and Blue light, placing Red opposite Cyan and Blue opposite Yellow.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Can I check accessibility and color blindness on this color wheel?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. Our color wheel picker includes a real-time WCAG 2.1 contrast matrix with AA and AAA pass/fail badges, plus a color vision deficiency simulator supporting Protanopia, Deuteranopia, Tritanopia, and Monochromacy.'
      }
    }
  ]
};

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'PigmentLab Color Wheel Picker & Palette Generator',
    'url': 'https://pigmentlab.com/color-wheel',
    'description': 'Free online color wheel picker with Johannes Itten RYB artist mode, digital RGB mode, complementary color wheel generator, WCAG 2.1 contrast checking, and 9-step shade scales.',
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    }
  },
  colorWheelFaqSchema
];
---

<Layout
  title="Color Wheel Picker & Palette Generator - Complementary Color Wheel"
  description="Interactive color wheel picker featuring Johannes Itten's 12-hue Bauhaus artist wheel (RYB) and digital RGB modes. Generate complementary color wheel palettes, 9-step tint scales, and test WCAG contrast. Better than Adobe Color Wheel."
  keywords="color wheel, color wheel picker, adobe color wheel, color wheel chart, complementary color wheel, itten color wheel, farbkreis itten, color scheme generator, color palette builder"
  currentPath="/color-wheel"
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <!-- Geist Mesh Gradient Bloom -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Johannes Itten Bauhaus Wheel & Color Palettes</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Color Wheel Picker & Palette Generator
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Standard screen pickers like the Adobe Color Wheel only use digital RGB angles (Red opposite Cyan). Real Color Mixer provides a 1-click toggle to switch between the traditional <strong class="text-[#171717] dark:text-white">Johannes Itten Bauhaus RYB artist color wheel</strong> (where <span class="text-[#c41e3a] font-semibold">Red</span> is opposite <span class="text-[#14b82a] font-semibold">Green</span>) and the standard digital web color wheel chart.
        </p>

        <!-- Mode Switcher Tabs (Itten vs Digital RGB) -->
        <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-1 rounded-2xl sm:rounded-full border border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#141414] p-1.5 sm:p-1 shadow-2xs max-w-full">
          <button
            type="button"
            id="wheel-mode-itten"
            data-wheel="itten"
            class="wheel-mode-btn active cursor-pointer rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-xs"
          >
            🎨 Klassischer Itten (RYB Artist Wheel)
          </button>
          <button
            type="button"
            id="wheel-mode-rgb"
            data-wheel="rgb"
            class="wheel-mode-btn cursor-pointer rounded-full px-4 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
          >
            💻 Digital Screen Wheel (RGB / Web)
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Tool Canvas Section -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Palette Scheme Filter Bar -->
      <div class="mb-8 flex flex-wrap items-center justify-center gap-1.5">
        <button
          type="button"
          data-scheme="complementary"
          class="scheme-btn active cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium transition-all bg-[#171717] text-white shadow-xs"
        >
          Complementary (Opuestos)
        </button>
        <button
          type="button"
          data-scheme="analogous"
          class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] transition-all"
        >
          Analogous (Análogos)
        </button>
        <button
          type="button"
          data-scheme="triadic"
          class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] transition-all"
        >
          Triadic (Tríada)
        </button>
        <button
          type="button"
          data-scheme="tetradic"
          class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] transition-all"
        >
          Tetradic (Tétrada)
        </button>
        <button
          type="button"
          data-scheme="split"
          class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] transition-all"
        >
          Split-Complementary
        </button>
        <button
          type="button"
          data-scheme="monochromatic"
          class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] transition-all"
        >
          Monochromatic
        </button>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        
        <!-- Left Column: Interactive Wheel Canvas (6 cols) -->
        <div class="space-y-6 lg:col-span-6">
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-4">
              <div>
                <h2 class="text-base font-semibold text-[#171717]">Interactive Canvas</h2>
                <p id="wheel-desc-tag" class="text-xs text-[#8f8f8f]">
                  Drag the node to rotate palette colors. Mode: Itten RYB (Red opposite Green).
                </p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  id="random-hue-btn"
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717]"
                  title="Randomize hue"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Shuffle</span>
                </button>
              </div>
            </div>

            <!-- Canvas Container -->
            <div class="relative mx-auto mt-6 flex items-center justify-center">
              <canvas
                id="color-wheel-canvas"
                width="360"
                height="360"
                class="touch-none cursor-crosshair rounded-full border border-[#ebebeb] shadow-xs select-none w-full max-w-[360px] aspect-square"
              ></canvas>
            </div>

            <!-- Precision Controls (Sliders & Hex) -->
            <div class="mt-6 space-y-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-4 text-xs">
              <div class="flex items-center justify-between gap-4">
                <span class="w-20 font-mono text-[#8f8f8f]">Hue Angle</span>
                <input
                  type="range"
                  id="hue-slider"
                  min="0"
                  max="359"
                  value="0"
                  class="h-1.5 flex-1 cursor-pointer accent-[#171717]"
                />
                <span id="hue-value-label" class="w-12 text-right font-mono font-semibold text-[#171717]">0°</span>
              </div>

              <div class="flex items-center justify-between gap-4">
                <span class="w-20 font-mono text-[#8f8f8f]">Saturation</span>
                <input
                  type="range"
                  id="sat-slider"
                  min="20"
                  max="100"
                  value="100"
                  class="h-1.5 flex-1 cursor-pointer accent-[#171717]"
                />
                <span id="sat-value-label" class="w-12 text-right font-mono font-semibold text-[#171717]">100%</span>
              </div>

              <div class="flex items-center justify-between gap-4">
                <span class="w-20 font-mono text-[#8f8f8f]">Lightness</span>
                <input
                  type="range"
                  id="light-slider"
                  min="20"
                  max="80"
                  value="50"
                  class="h-1.5 flex-1 cursor-pointer accent-[#171717]"
                />
                <span id="light-value-label" class="w-12 text-right font-mono font-semibold text-[#171717]">50%</span>
              </div>

              <div class="flex items-center justify-between border-t border-[#ebebeb] pt-3">
                <span class="font-mono text-[#8f8f8f]">Direct Base Hex</span>
                <div class="flex items-center gap-2">
                  <span id="base-color-dot" class="h-4 w-4 rounded-full border border-black/10 bg-[#FF0000]"></span>
                  <input
                    type="text"
                    id="base-hex-input"
                    value="#FF0000"
                    maxlength="7"
                    class="w-24 rounded border border-[#ebebeb] bg-white px-2 py-0.5 font-mono text-xs uppercase font-medium text-[#171717]"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Color Vision Deficiency Simulator -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                Color Blindness Simulation
              </h3>
              <span class="text-[11px] text-[#8f8f8f]">8% of users</span>
            </div>
            <p class="mt-2 text-xs text-[#8f8f8f]">Test how people with color vision deficiency perceive your palette:</p>
            <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
              <button type="button" data-cvd="normal" class="cvd-btn active rounded-md border border-[#ebebeb] bg-[#171717] px-2.5 py-1.5 text-xs font-medium text-white transition-colors">
                Normal Vision
              </button>
              <button type="button" data-cvd="protanopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors">
                Protanopia (Red-Blind)
              </button>
              <button type="button" data-cvd="deuteranopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors">
                Deuteranopia (Green-Blind)
              </button>
              <button type="button" data-cvd="tritanopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors">
                Tritanopia (Blue-Blind)
              </button>
              <button type="button" data-cvd="achromatopsia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors">
                Achromatopsia (Monochrome)
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Palette Swatches, 9-Shade Scales & WCAG (6 cols) -->
        <div class="space-y-6 lg:col-span-6">
          
          <!-- Palette Swatches Card -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-4">
              <h2 class="text-base font-semibold text-[#171717]">Color Palette</h2>
              <span id="palette-count-tag" class="rounded bg-[#f2f2f2] px-2 py-0.5 font-mono text-[11px] text-[#4d4d4d]">
                2 Colors
              </span>
            </div>

            <!-- Dynamic Swatches Row -->
            <div id="palette-swatches-grid" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
              <!-- Swatches injected by JS -->
            </div>

            <!-- Dynamic 9-Step Shade & Tint Scale (Tailwind 50-900) -->
            <div class="mt-6 border-t border-[#ebebeb] pt-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                  9-Step Tints & Shades Scale
                </span>
                <span id="active-scale-label" class="font-mono text-xs text-[#8f8f8f]">
                  Base Color
                </span>
              </div>
              <p class="mt-1 text-xs text-[#8f8f8f]">Click any shade below to copy its HEX code directly into your clipboard:</p>

              <div id="shade-scale-strip" class="mt-3 flex overflow-x-auto rounded-lg border border-[#ebebeb] shadow-inner">
                <!-- 50 to 900 swatches -->
              </div>
            </div>
          </div>

          <!-- Real-Time WCAG 2.1 Contrast Matrix -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                Palette WCAG Contrast Matrix
              </h3>
              <span class="text-[11px] text-[#8f8f8f]">Contrast between palette colors</span>
            </div>

            <div id="wcag-contrast-matrix" class="mt-4 space-y-2 text-xs">
              <!-- Matrix rows injected by JS -->
            </div>
          </div>

          <!-- Multi-Format Developer Export -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                Developer & Designer Exports
              </h3>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  id="download-svg-btn"
                  class="inline-flex items-center gap-1 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] hover:text-[#171717] transition-colors"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  <span>SVG Palette</span>
                </button>
              </div>
            </div>

            <!-- Export Code Formats -->
            <div class="mt-4 space-y-3">
              <!-- Tailwind Config -->
              <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-xs">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[11px] text-[#8f8f8f]">Tailwind CSS Theme Token Config</span>
                  <button type="button" id="copy-tailwind-btn" class="font-medium text-[#0070f3] hover:underline cursor-pointer">
                    Copy Code
                  </button>
                </div>
                <pre id="tailwind-export-code" class="mt-1 font-mono text-[11px] text-[#171717] overflow-x-auto whitespace-pre-wrap"></pre>
              </div>

              <!-- CSS Variables -->
              <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-xs">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[11px] text-[#8f8f8f]">CSS Custom Properties (:root)</span>
                  <button type="button" id="copy-css-vars-btn" class="font-medium text-[#0070f3] hover:underline cursor-pointer">
                    Copy CSS
                  </button>
                </div>
                <pre id="css-vars-export-code" class="mt-1 font-mono text-[11px] text-[#171717] overflow-x-auto whitespace-pre-wrap"></pre>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Comprehensive Educational Guide & SEO Section -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Color Theory & Palette Science</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          The Complete Guide to the Color Wheel, Color Wheel Picker & Color Palettes
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Master color relationships, generate balanced complementary palettes, and understand classical vs digital color spaces.
        </p>
      </div>

      <!-- Main Prose Body -->
      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        
        <!-- Section 1: Color Wheel & Color Wheel Picker -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Understanding the Color Wheel and Interactive Color Wheel Picker
          </h3>
          <p>
            The <strong>color wheel</strong> is the cornerstone of color theory, graphic design, and artistic composition. Originating from Sir Isaac Newton’s 1666 circular refraction diagram and later expanded by Goethe and Bauhaus master Johannes Itten, the <strong>color wheel</strong> maps the continuous spectrum of visible light into a manageable geometric circle. Whether you are creating brand identity guidelines, designing accessible user interfaces, or mixing physical paint on canvas, the <strong>color wheel</strong> enables you to predict visual contrast and balance with scientific certainty.
          </p>
          <p>
            An interactive <strong>color wheel picker</strong> takes this classical foundation and elevates it for the digital age. Instead of manually guessing hex codes or relying on clunky operating system dialogs, a dedicated <strong>color wheel picker</strong> allows you to select a primary base hue, sweep across 360 degrees of tonal variations, and automatically calculate balanced secondary and accent palette colors.
          </p>
        </section>

        <!-- Section 2: How to Use the Color Wheel Picker -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. How to Use This Color Wheel Picker: Step-by-Step
          </h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-5">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-mono font-bold">1</span>
              <h4 class="mt-3 text-sm font-semibold text-[#111827] dark:text-white">Choose Wheel Mode</h4>
              <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Toggle between <strong>Klassischer Itten (RYB Artist Wheel)</strong> for traditional art color balance (Red opposite Green) and <strong>Digital Screen Wheel (RGB / Web)</strong> for standard screen coordinates.
              </p>
            </div>
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-5">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-[#171717] dark:bg-white text-white dark:text-[#171717] text-xs font-mono font-bold">2</span>
              <h4 class="mt-3 text-sm font-semibold text-[#111827] dark:text-white">Select Palette Scheme</h4>
              <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                Click a palette preset: <strong>Complementary</strong>, <strong>Analogous</strong>, <strong>Triadic</strong>, <strong>Tetradic</strong>, <strong>Split-Complementary</strong>, or <strong>Monochromatic</strong>.
              </p>
            </div>
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-5">
