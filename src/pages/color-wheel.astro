<script>
  import {
    ittenAngleToRgbHue,
    rgbHueToIttenAngle,
    hslToRgb,
    rgbToHex,
    rgbToHsl,
    hexToRgb,
    getWcagContrast,
    getContrastRating,
    simulateColorBlindness,
    generatePaletteScale
  } from '../utils/colorPhysics';

  // State
  let wheelMode: 'itten' | 'rgb' = 'itten';
  let schemeType: 'complementary' | 'analogous' | 'triadic' | 'tetradic' | 'split' | 'monochromatic' = 'complementary';
  let currentHue = 0; // 0 to 359 (in Itten angle if wheelMode='itten', or in RGB hue if wheelMode='rgb')
  let currentSat = 100;
  let currentLight = 50;
  let currentCvd: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia' = 'normal';
  let selectedSwatchHex = '';

  // DOM
  const canvas = document.getElementById('color-wheel-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const hueSlider = document.getElementById('hue-slider') as HTMLInputElement;
  const satSlider = document.getElementById('sat-slider') as HTMLInputElement;
  const lightSlider = document.getElementById('light-slider') as HTMLInputElement;
  const hueValueLabel = document.getElementById('hue-value-label');
  const satValueLabel = document.getElementById('sat-value-label');
  const lightValueLabel = document.getElementById('light-value-label');
  const baseHexInput = document.getElementById('base-hex-input') as HTMLInputElement;
  const baseColorDot = document.getElementById('base-color-dot');
  const wheelDescTag = document.getElementById('wheel-desc-tag');
  const randomHueBtn = document.getElementById('random-hue-btn');

  // Palette & Scales DOM
  const swatchesGrid = document.getElementById('palette-swatches-grid');
  const shadeScaleStrip = document.getElementById('shade-scale-strip');
  const activeScaleLabel = document.getElementById('active-scale-label');
  const wcagMatrix = document.getElementById('wcag-contrast-matrix');
  const paletteCountTag = document.getElementById('palette-count-tag');

  // Export DOM
  const tailwindExportCode = document.getElementById('tailwind-export-code');
  const cssVarsExportCode = document.getElementById('css-vars-export-code');
  const copyTailwindBtn = document.getElementById('copy-tailwind-btn');
  const copyCssVarsBtn = document.getElementById('copy-css-vars-btn');
  const downloadSvgBtn = document.getElementById('download-svg-btn');

  // Wheel Mode Buttons
  const wheelModeIttenBtn = document.getElementById('wheel-mode-itten');
  const wheelModeRgbBtn = document.getElementById('wheel-mode-rgb');
  const schemeBtns = document.querySelectorAll('.scheme-btn');
  const cvdBtns = document.querySelectorAll('.cvd-btn');

  // Initialize Canvas Size for Retina Screens
  const size = 360;
  const radius = size / 2;
  const center = { x: radius, y: radius };

  function renderWheel() {
    ctx.clearRect(0, 0, size, size);

    // Draw Wheel Gradient Ring
    const innerRadius = 24;
    const outerRadius = radius - 8;

    // Draw in radial slices
    const steps = 360;
    for (let i = 0; i < steps; i++) {
      const angle = (i * Math.PI) / 180;
      const nextAngle = ((i + 1.5) * Math.PI) / 180;

      // Determine RGB hue
      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(i) : i;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);

      ctx.beginPath();
      ctx.moveTo(center.x, center.y);
      ctx.arc(center.x, center.y, outerRadius, angle, nextAngle);
      ctx.closePath();

      // Create radial fade towards center white
      const grad = ctx.createRadialGradient(center.x, center.y, innerRadius, center.x, center.y, outerRadius);
      grad.addColorStop(0, '#ffffff');
      grad.addColorStop(1, `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`);

      ctx.fillStyle = grad;
      ctx.fill();
    }

    // Inner Hole Mask (adapts dynamically to dark or light mode)
    const isDark = document.documentElement.classList.contains('dark');
    ctx.beginPath();
    ctx.arc(center.x, center.y, innerRadius, 0, Math.PI * 2);
    ctx.fillStyle = isDark ? '#0a0a0a' : '#ffffff';
    ctx.fill();
    ctx.lineWidth = 1;
    ctx.strokeStyle = isDark ? '#262626' : '#ebebeb';
    ctx.stroke();

    // Compute Active Palette Points
    const angles = computeSchemeAngles(currentHue, schemeType);
    const rDist = (outerRadius - innerRadius) * (currentSat / 100) + innerRadius;

    // Draw Connecting Polygon/Lines
    if (angles.length > 1) {
      ctx.beginPath();
      angles.forEach((ang, idx) => {
        const rad = (ang * Math.PI) / 180;
        const px = center.x + Math.cos(rad) * rDist;
        const py = center.y + Math.sin(rad) * rDist;
        if (idx === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.closePath();
      ctx.lineWidth = 2;
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.55)' : 'rgba(23, 23, 23, 0.4)';
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Draw Nodes for Each Palette Color
    angles.forEach((ang, idx) => {
      const rad = (ang * Math.PI) / 180;
      const px = center.x + Math.cos(rad) * rDist;
      const py = center.y + Math.sin(rad) * rDist;

      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(ang) : ang;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);
      let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
      hex = simulateColorBlindness(hex, currentCvd);

      ctx.beginPath();
      ctx.arc(px, py, idx === 0 ? 11 : 8, 0, Math.PI * 2);
      ctx.fillStyle = hex;
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = idx === 0 ? (isDark ? '#ffffff' : '#171717') : (isDark ? '#0a0a0a' : '#ffffff');
      ctx.stroke();

      // Shadow
      ctx.shadowColor = 'rgba(0,0,0,0.25)';
      ctx.shadowBlur = 4;
    });

    ctx.shadowBlur = 0;
  }

  function computeSchemeAngles(baseAngle: number, type: string): number[] {
    const norm = (a: number) => ((a % 360) + 360) % 360;

    switch (type) {
      case 'complementary':
        return [norm(baseAngle), norm(baseAngle + 180)];
      case 'analogous':
        return [norm(baseAngle - 30), norm(baseAngle), norm(baseAngle + 30)];
      case 'triadic':
        return [norm(baseAngle), norm(baseAngle + 120), norm(baseAngle + 240)];
      case 'tetradic':
        return [norm(baseAngle), norm(baseAngle + 90), norm(baseAngle + 180), norm(baseAngle + 270)];
      case 'split':
        return [norm(baseAngle), norm(baseAngle + 150), norm(baseAngle + 210)];
      case 'monochromatic':
        return [norm(baseAngle)];
      default:
        return [norm(baseAngle)];
    }
  }

  function getPaletteColors(): { name: string; hex: string }[] {
    const angles = computeSchemeAngles(currentHue, schemeType);

    if (schemeType === 'monochromatic') {
      const baseRgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(currentHue) : currentHue;
      const lightSteps = [80, 60, 45, 25];
      return lightSteps.map((l, i) => {
        const rgb = hslToRgb(baseRgbHue, currentSat, l);
        let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
        hex = simulateColorBlindness(hex, currentCvd);
        return { name: `Mono ${i + 1}`, hex };
      });
    }

    return angles.map((ang, i) => {
      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(ang) : ang;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);
      let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
      hex = simulateColorBlindness(hex, currentCvd);

      let name = i === 0 ? 'Base' : `Color ${i + 1}`;
      if (schemeType === 'complementary' && i === 1) name = 'Opposite';
      if (schemeType === 'triadic') name = i === 0 ? 'Primary' : `Triad ${i}`;
      if (schemeType === 'analogous') name = i === 1 ? 'Base' : `Neighbor ${i + 1}`;

      return { name, hex };
    });
  }

  function updatePaletteUI() {
    const palette = getPaletteColors();
    if (!palette.length) return;

    if (!selectedSwatchHex || !palette.some((p) => p.hex === selectedSwatchHex)) {
      selectedSwatchHex = palette[0].hex;
    }

    if (paletteCountTag) paletteCountTag.textContent = `${palette.length} Colors`;

    // Render Swatches
    if (swatchesGrid) {
      swatchesGrid.innerHTML = '';
      palette.forEach((item, idx) => {
        const isSelected = item.hex === selectedSwatchHex;
        const card = document.createElement('div');
        card.className = `flex items-center justify-between rounded-xl border ${
          isSelected ? 'border-[#171717] ring-1 ring-[#171717]' : 'border-[#ebebeb]'
        } bg-[#fafafa] p-3 transition-all cursor-pointer hover:bg-white`;

        card.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="h-10 w-10 rounded-lg border border-black/10 shrink-0 shadow-xs" style="background-color: ${item.hex};"></span>
            <div>
              <div class="font-medium text-xs text-[#171717]">${item.name}</div>
              <div class="font-mono text-xs text-[#8f8f8f]">${item.hex}</div>
            </div>
          </div>
          <button
            type="button"
            class="copy-hex-pill rounded-full border border-[#ebebeb] bg-white px-2.5 py-1 text-[11px] font-mono text-[#4d4d4d] hover:bg-[#ebebeb] hover:text-[#171717] transition-colors"
            data-hex="${item.hex}"
          >
            Copy
          </button>
        `;

        card.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.copy-hex-pill')) return;
          selectedSwatchHex = item.hex;
          updateShadeScale();
          updatePaletteUI();
        });

        swatchesGrid.appendChild(card);
      });

      // Attach copy buttons
      document.querySelectorAll('.copy-hex-pill').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const hex = (e.currentTarget as HTMLElement).dataset.hex;
          if (hex) {
            navigator.clipboard.writeText(hex);
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => (btn.textContent = original), 1500);
          }
        });
      });
    }

    updateShadeScale();
    updateWcagMatrix(palette);
    updateExportCodes(palette);
  }

  function updateShadeScale() {
    if (!shadeScaleStrip || !selectedSwatchHex) return;
    if (activeScaleLabel) activeScaleLabel.textContent = `Tints & Shades of ${selectedSwatchHex}`;

    const scale = generatePaletteScale(selectedSwatchHex);
    shadeScaleStrip.innerHTML = '';

    scale.forEach((s) => {
      const stepEl = document.createElement('button');
      stepEl.type = 'button';
      stepEl.title = `${s.label}: ${s.hex} (Click to copy)`;
      stepEl.className = 'group relative flex-1 h-12 flex flex-col justify-end p-1 transition-transform hover:scale-105';
      stepEl.style.backgroundColor = s.hex;

      const isLight = s.label === '50' || s.label === '100' || s.label === '200' || s.label === '300';
      stepEl.innerHTML = `
        <span class="text-[9px] font-mono font-bold leading-tight ${isLight ? 'text-black/70' : 'text-white/80'}">
          ${s.label}
        </span>
      `;

      stepEl.addEventListener('click', () => {
        navigator.clipboard.writeText(s.hex);
        alert(`Copied ${s.label} (${s.hex}) to clipboard!`);
      });

      shadeScaleStrip.appendChild(stepEl);
    });
  }

  function updateWcagMatrix(palette: { name: string; hex: string }[]) {
    if (!wcagMatrix) return;
    wcagMatrix.innerHTML = '';

    if (palette.length < 2) {
      wcagMatrix.innerHTML = `<div class="text-[#8f8f8f] italic py-2">Select a multi-color palette to view mutual contrast scores.</div>`;
      return;
    }

    const base = palette[0];
    for (let i = 1; i < palette.length; i++) {
      const comp = palette[i];
      const ratio = getWcagContrast(base.hex, comp.hex);
      const rating = getContrastRating(ratio);

      const row = document.createElement('div');
      row.className = 'flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] p-2.5';
      row.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="h-4 w-4 rounded-full border border-black/10" style="background-color: ${base.hex};"></span>
          <span class="text-[#8f8f8f]">vs</span>
          <span class="h-4 w-4 rounded-full border border-black/10" style="background-color: ${comp.hex};"></span>
          <span class="font-medium text-[#171717]">${base.name} & ${comp.name}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono font-semibold text-[#171717]">${rating.ratioText}</span>
          <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold ${
            rating.aaNormal ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
          }">
            ${rating.aaNormal ? 'AA Pass' : 'AA Fail'}
          </span>
        </div>
      `;
      wcagMatrix.appendChild(row);
    }
  }

  function updateExportCodes(palette: { name: string; hex: string }[]) {
    // Tailwind export
    if (tailwindExportCode) {
      const lines = palette.map((p, i) => `    'color-${i + 1}': '${p.hex}',`).join('\n');
      tailwindExportCode.textContent = `// tailwind.config.js\nmodule.exports = {\n  theme: {\n    extend: {\n      colors: {\n${lines}\n      }\n    }\n  }\n};`;
    }

    // CSS variables export
    if (cssVarsExportCode) {
      const lines = palette.map((p, i) => `  --color-${i + 1}: ${p.hex};`).join('\n');
      cssVarsExportCode.textContent = `:root {\n${lines}\n}`;
    }
  }

  // Handle Drag on Canvas
  let isDragging = false;

  function handleWheelPointer(e: PointerEvent | MouseEvent | TouchEvent) {
    if ('touches' in e && e.cancelable) {
      e.preventDefault();
    }
    const rect = canvas.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
    const clientY = 'touches' in e ? e.touches[0].clientY : (e as MouseEvent).clientY;

    const scaleX = size / (rect.width || 1);
    const scaleY = size / (rect.height || 1);
    const x = (clientX - rect.left) * scaleX - center.x;
    const y = (clientY - rect.top) * scaleY - center.y;

    let rad = Math.atan2(y, x);
    let deg = (rad * 180) / Math.PI;
    if (deg < 0) deg += 360;

    currentHue = Math.round(deg);
    if (hueSlider) hueSlider.value = currentHue.toString();
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;

    updateBaseHexFromState();
    renderWheel();
    updatePaletteUI();
  }

  canvas.addEventListener('mousedown', (e) => {
    isDragging = true;
    handleWheelPointer(e);
  });
  window.addEventListener('mousemove', (e) => {
    if (isDragging) handleWheelPointer(e);
  });
  window.addEventListener('mouseup', () => {
    isDragging = false;
  });

  // Touch Support
  canvas.addEventListener('touchstart', (e) => {
    isDragging = true;
    handleWheelPointer(e);
  }, { passive: false });
  window.addEventListener('touchmove', (e) => {
    if (isDragging) handleWheelPointer(e);
  }, { passive: false });
  window.addEventListener('touchend', () => {
    isDragging = false;
  });

  // Slider Events
  hueSlider.addEventListener('input', () => {
    currentHue = parseInt(hueSlider.value, 10);
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
    updateBaseHexFromState();
    renderWheel();
    updatePaletteUI();
  });

  satSlider.addEventListener('input', () => {
    currentSat = parseInt(satSlider.value, 10);
    if (satValueLabel) satValueLabel.textContent = `${currentSat}%`;
    updateBaseHexFromState();
    renderWheel();
    updatePaletteUI();
  });

  lightSlider.addEventListener('input', () => {
    currentLight = parseInt(lightSlider.value, 10);
    if (lightValueLabel) lightValueLabel.textContent = `${currentLight}%`;
    updateBaseHexFromState();
    renderWheel();
    updatePaletteUI();
  });

  function updateBaseHexFromState() {
    const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(currentHue) : currentHue;
    const rgb = hslToRgb(rgbHue, currentSat, currentLight);
    const hex = rgbToHex(rgb.r, rgb.g, rgb.b);
    if (baseHexInput) baseHexInput.value = hex;
    if (baseColorDot) baseColorDot.style.backgroundColor = hex;
  }

  // Direct Hex Input
  baseHexInput.addEventListener('change', () => {
    let val = baseHexInput.value.trim();
    if (!val.startsWith('#')) val = '#' + val;
    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
      const rgb = hexToRgb(val);
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
      currentSat = hsl.s;
      currentLight = hsl.l;
      currentHue = wheelMode === 'itten' ? Math.round(rgbHueToIttenAngle(hsl.h)) : hsl.h;

      if (hueSlider) hueSlider.value = currentHue.toString();
      if (satSlider) satSlider.value = currentSat.toString();
      if (lightSlider) lightSlider.value = currentLight.toString();
      if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
      if (satValueLabel) satValueLabel.textContent = `${currentSat}%`;
      if (lightValueLabel) lightValueLabel.textContent = `${currentLight}%`;
      if (baseColorDot) baseColorDot.style.backgroundColor = val;

      renderWheel();
      updatePaletteUI();
    }
  });

  // Wheel Mode Switcher
  wheelModeIttenBtn?.addEventListener('click', () => {
    wheelMode = 'itten';
    wheelModeIttenBtn.classList.add('bg-[#171717]', 'text-white', 'shadow-xs');
    wheelModeIttenBtn.classList.remove('text-[#4d4d4d]');
    wheelModeRgbBtn?.classList.remove('bg-[#171717]', 'text-white', 'shadow-xs');
    wheelModeRgbBtn?.classList.add('text-[#4d4d4d]');
    if (wheelDescTag) wheelDescTag.textContent = 'Drag the node to rotate palette colors. Mode: Itten RYB (Red opposite Green).';
    renderWheel();
    updatePaletteUI();
  });

  wheelModeRgbBtn?.addEventListener('click', () => {
    wheelMode = 'rgb';
    wheelModeRgbBtn.classList.add('bg-[#171717]', 'text-white', 'shadow-xs');
    wheelModeRgbBtn.classList.remove('text-[#4d4d4d]');
    wheelModeIttenBtn?.classList.remove('bg-[#171717]', 'text-white', 'shadow-xs');
    wheelModeIttenBtn?.classList.add('text-[#4d4d4d]');
    if (wheelDescTag) wheelDescTag.textContent = 'Drag the node to rotate palette colors. Mode: Digital RGB (Red opposite Cyan).';
    renderWheel();
    updatePaletteUI();
  });

  // Palette Scheme Switchers
  schemeBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      schemeBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'shadow-xs');
        b.classList.add('border', 'border-[#ebebeb]', 'bg-white', 'text-[#4d4d4d]');
      });
      target.classList.add('bg-[#171717]', 'text-white', 'shadow-xs');
      target.classList.remove('border', 'border-[#ebebeb]', 'bg-white', 'text-[#4d4d4d]');

      schemeType = (target.dataset.scheme || 'complementary') as any;
      renderWheel();
      updatePaletteUI();
    });
  });

  // CVD Simulator Switchers
  cvdBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      cvdBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white');
        b.classList.add('bg-[#fafafa]', 'text-[#4d4d4d]');
      });
      target.classList.add('bg-[#171717]', 'text-white');
      target.classList.remove('bg-[#fafafa]', 'text-[#4d4d4d]');

      currentCvd = (target.dataset.cvd || 'normal') as any;
      renderWheel();
      updatePaletteUI();
    });
  });

  // Shuffle Button
  randomHueBtn?.addEventListener('click', () => {
    currentHue = Math.floor(Math.random() * 360);
    if (hueSlider) hueSlider.value = currentHue.toString();
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
    updateBaseHexFromState();
    renderWheel();
    updatePaletteUI();
  });

  // Copy buttons
  copyTailwindBtn?.addEventListener('click', () => {
    if (tailwindExportCode?.textContent) {
      navigator.clipboard.writeText(tailwindExportCode.textContent);
      const original = copyTailwindBtn.textContent;
      copyTailwindBtn.textContent = 'Copied!';
      setTimeout(() => (copyTailwindBtn.textContent = original), 1500);
    }
  });

  copyCssVarsBtn?.addEventListener('click', () => {
    if (cssVarsExportCode?.textContent) {
      navigator.clipboard.writeText(cssVarsExportCode.textContent);
      const original = copyCssVarsBtn.textContent;
      copyCssVarsBtn.textContent = 'Copied!';
      setTimeout(() => (copyCssVarsBtn.textContent = original), 1500);
    }
  });

  // Download SVG
  downloadSvgBtn?.addEventListener('click', () => {
    const palette = getPaletteColors();
    const width = 600;
    const height = 200;
    const swatchW = width / palette.length;

    let rects = '';
    palette.forEach((p, i) => {
      rects += `
        <rect x="${i * swatchW}" y="0" width="${swatchW}" height="${height}" fill="${p.hex}" />
        <text x="${i * swatchW + 10}" y="${height - 20}" font-family="monospace" font-size="14" fill="${
          getWcagContrast(p.hex, '#FFFFFF') >= 4.5 ? '#FFFFFF' : '#171717'
        }">${p.hex}</text>
      `;
    });

    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">
        ${rects}
      </svg>
    `;

    const blob = new Blob([svg], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `color-palette-${schemeType}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Theme change listener to keep canvas hub synchronized
  window.addEventListener('pl:themechange', () => {
    renderWheel();
  });
  window.addEventListener('rcm:themechange', () => {
    renderWheel();
  });

  // Initial Boot
  updateBaseHexFromState();
  renderWheel();
  updatePaletteUI();
</script>

