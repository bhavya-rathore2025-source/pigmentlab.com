---
import Layout from '../layouts/Layout.astro';
import ColorWheelStudio from '../components/ColorWheelStudio.astro';
import JumpNav from '../components/JumpNav.astro';
import ModularToolSections from '../components/ModularToolSections.astro';
import ExploreColorTools from '../components/ExploreColorTools.astro';
import { buildWheelPageSchemas } from '../utils/seoSchema';
import { wheelJumpLinks } from '../i18n/toolGuides';

const germanFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Was ist ein Farbkreis nach Itten und wie unterscheidet er sich von RGB?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Der Farbkreis nach Johannes Itten basiert auf der traditionellen 12-teiligen Künstler-Farblehre des Bauhauses mit den Primärfarben Rot, Gelb und Blau (RYB). Im Itten-Farbkreis liegt Rot direkt gegenüber von Grün und Blau gegenüber von Orange. Auf digitalen RGB-Bildschirmen hingegen stehen sich Rot und Cyan sowie Blau und Gelb gegenüber.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Wie finde ich Komplementärfarben im Farbkreis?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Komplementärfarben liegen sich im Farbkreis genau um 180 Grad gegenüber. Im Itten-Farbkreis bilden Rot und Grün, Gelb und Violett sowie Blau und Orange harmonische Komplementär-Paare mit maximalem Simultankontrast.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Wie funktioniert dieser Farbrad Online Generator als Adobe Farbrad Alternative?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Im Gegensatz zum Adobe Farbrad, das ausschließlich auf digitale RGB-Lichtwinkel setzt und ein Benutzerkonto verlangt, bietet unser Online-Farbrad einen 1-Klick-Wechsel zwischen dem klassischen Johannes Itten Farbkreis und digitalem RGB, direkte WCAG 2.1 AA/AAA Kontrastprüfung und 100% kostenlose Nutzung ohne Anmeldung.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Was sind die Farbkreis Grundfarben?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Die Grundfarben (Primärfarben) im traditionellen Farbkreis nach Itten sind Rot, Gelb und Blau. Aus deren paarweiser Mischung entstehen die Sekundärfarben Orange, Grün und Violett, gefolgt von sechs Tertiärfarben.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Welche Farben passen zusammen im Farbkreis? (Farbkombinationen & Harmonien)',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Im Farbkreis harmonieren Farben nach bewährten geometrischen Gestaltungsregeln: 1. Komplementärfarben (liegen sich direkt gegenüber, z. B. Blau und Orange) erzeugen maximale Leuchtkraft und Kontrast. 2. Analoge Farben (nebeneinanderliegende Farbtöne, z. B. Gelb, Gelb-Orange und Orange) schaffen harmonische, ruhige Verläufe. 3. Triadische Harmonien (drei gleich weit entfernte Farben im 120-Grad-Dreieck, z. B. Rot, Gelb und Blau) bieten ausgewogene Farbpaletten.'
      }
    }
  ]
};

const germanPageSchema = buildWheelPageSchemas({
  lang: 'de',
  url: 'https://pigmentlaboratory.com/color-wheel',
  appName: 'PigmentLab Farbkreis & Farbrad Online — Farbkreis nach Itten',
  appDescription: 'Kostenloses Farbrad online und Farbkreis nach Johannes Itten (Bauhaus RYB) & RGB. Farbkreis Komplementärfarben, Farbpaletten-Generator und WCAG 2.1 Kontrastprüfung. Beste Adobe Farbrad Alternative.',
  articleHeadline: 'Farbkreis nach Johannes Itten (RYB) vs. Digitaler RGB-Farbkreis — Leitfaden',
  articleDescription: 'Wie der 12-teilige Bauhaus-Farbkreis nach Itten arbeitet, Komplementär- und Triaden-Harmonien sowie WCAG-2.1-Kontrastregeln.',
  currency: 'EUR',
  faqSchema: germanFaqSchema,
});
---

<Layout
  title="Farbkreis & Farbrad Online — Farbkreis nach Itten & Farbpaletten Generator"
  description="Interaktiver Farbkreis nach Johannes Itten (Bauhaus RYB) & Farbrad online. Komplementärfarben, Farbkreis Grundfarben, Farbpaletten-Generator und WCAG-Kontrastprüfung. Die kostenlose Adobe Farbrad Alternative."
  keywords="farbkreis, farbrad, farbkreis nach itten, farbkreis itten, farbpaletten-generator, komplementär farben, farbkreis komplementärfarben, farbkreis grundfarben, adobe farbrad, farbrad online, farbrad komplementärfarben, farbschemata"
  currentPath="/color-wheel"
  lang="de"
  schema={germanPageSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[20%] left-[10%] h-[320px] w-[450px] rounded-full bg-gradient-to-tr from-[#ff4d4d]/30 via-[#f9cb28]/30 to-[#00dfd8]/30 blur-3xl"></div>
      <div class="absolute -top-[25%] right-[20%] h-[320px] w-[450px] rounded-full bg-gradient-to-bl from-[#7928ca]/30 via-[#ff0080]/30 to-[#007cf0]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#ff0080] animate-pulse"></span>
          <span>Johannes Itten Bauhaus Farbrad & Farbpaletten</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Farbkreis & Farbrad Online Generator
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Standard-Tools wie das Adobe Farbrad nutzen lediglich digitale RGB-Bildschirmwinkel (Rot gegenüber Cyan). PigmentLab bietet einen 1-Klick-Wechsel zum klassischen <strong class="text-[#171717] dark:text-white">Farbkreis nach Johannes Itten (Bauhaus RYB)</strong>, bei dem <span class="text-[#c41e3a] font-semibold">Rot</span> gegenüber von <span class="text-[#14b82a] font-semibold">Grün</span> liegt — perfekt für Künstler, UI-Designer und Farbtheorie.
        </p>
        <JumpNav items={wheelJumpLinks.de} ariaLabel="Schnellnavigation" />
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <ColorWheelStudio lang="de" />

  <!-- Comprehensive Educational Guide in German -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Farbtheorie & Paletten-Wissenschaft</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          Der umfassende Leitfaden zu Farbkreis, Farbrad und Farbharmonien
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Farbbeziehungen verstehen, Komplementärfarben berechnen und den Unterschied zwischen dem Itten-Farbkreis und digitalem RGB meistern.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Was ist ein Farbkreis und wie nutzt man das Farbrad online?
          </h3>
          <p>
            Der <strong>Farbkreis</strong> (auch als <strong>Farbrad</strong> bekannt) bildet das Fundament der modernen Farbenlehre, Kunst und Mediengestaltung. Bereits Sir Isaac Newton ordnete 1666 das Spektrum des sichtbaren Lichts kreisförmig an, bevor Johann Wolfgang von Goethe und Bauhaus-Meister Johannes Itten das System für die praktische Malkunst verfeinerten. Ein <strong>Farbkreis</strong> ermöglicht es Gestaltern, visuelle Kontraste, Harmonien und Farbstimmungen mit geometrischer Präzision vorauszusagen.
          </p>
          <p>
            Ein digitales <strong>Farbrad online</strong> überführt diese klassische Theorie in die moderne Praxis. Anstatt Farben mühsam nach Augenmaß zu raten, wählen Sie mit dem interaktiven <strong>Farbpaletten-Generator</strong> einen Basiston und berechnen in Sekundenbruchteilen harmonische Komplementärfarben, analoge Schattierungen oder triadische Akkorde.
          </p>
        </section>

        <section id="itten-vs-rgb" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. Der 12-teilige Farbkreis nach Itten: Künstler-RYB im Vergleich zu digitalem RGB
          </h3>
          <p>
            Im <strong>Farbkreis nach Itten</strong> (Bauhaus Weimar) werden zwölf Farbtöne aus den <strong>Farbkreis Grundfarben</strong> Rot, Gelb und Blau hergeleitet. Gegenüber modernen Computerbildschirmen unterscheidet sich die Anordnung der Gegenfarben grundlegend:
          </p>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Grundton</th>
                  <th class="p-4 sm:p-5 text-[#c41e3a] font-semibold">Gegenüber im Itten-Farbkreis (RYB)</th>
                  <th class="p-4 sm:p-5 text-[#0070f3] font-semibold">Gegenüber im digitalen Bildschirm (RGB)</th>
                  <th class="p-4 sm:p-5">Farbkategorie</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Rot (#E60026)</td>
                  <td class="p-4 sm:p-5 text-emerald-600 dark:text-emerald-400 font-medium">Grün (#00AA44)</td>
                  <td class="p-4 sm:p-5 text-cyan-600 dark:text-cyan-400">Cyan (#00FFFF)</td>
                  <td class="p-4 sm:p-5">Primärfarbe (Grundfarbe)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Gelb (#FFE600)</td>
                  <td class="p-4 sm:p-5 text-purple-600 dark:text-purple-400 font-medium">Violett (#7A0099)</td>
                  <td class="p-4 sm:p-5 text-blue-600 dark:text-blue-400">Blau (#0000FF)</td>
                  <td class="p-4 sm:p-5">Primärfarbe (Grundfarbe)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#111827] dark:text-white">Blau (#002185)</td>
                  <td class="p-4 sm:p-5 text-orange-600 dark:text-orange-400 font-medium">Orange (#FF6600)</td>
                  <td class="p-4 sm:p-5 text-yellow-600 dark:text-yellow-400">Gelb (#FFFF00)</td>
                  <td class="p-4 sm:p-5">Primärfarbe (Grundfarbe)</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="harmonies" class="scroll-mt-20 space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            3. Farbkreis Komplementärfarben & Simultankontrast
          </h3>
          <p>
            <strong>Komplementärfarben</strong> sind Farbtöne, die sich im Farbkreis exakt diametral gegenüberstehen. Werden sie nebeneinander platziert, erzeugen sie durch den physiologischen Simultankontrast maximale Leuchtkraft und Dynamik, ohne sich gegenseitig zu beißen. Im Webdesign eignen sich Komplementärfarben hervorragend für auffällige Call-to-Action-Buttons und Hervorhebungen.
          </p>
        </section>

        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            4. Warum PigmentLab die führende Adobe Farbrad Alternative ist
          </h3>
          <p>
            Das bekannte <strong>Adobe Farbrad</strong> zwingt Nutzer in das Creative-Cloud-Ökosystem und ignoriert traditionelle Maltheorien. PigmentLab bietet klare Vorzüge:
          </p>
          <ul class="list-disc pl-5 space-y-1.5">
            <li><strong>Klassischer Itten-Modus:</strong> Echte Künstler-Farbbeziehungen (Rot gegenüber Grün).</li>
            <li><strong>100% ohne Anmeldung:</strong> Sofortige lokale Speicherung Ihrer Paletten ohne Cloud-Zwang.</li>
            <li><strong>Integrierte Barrierefreiheit:</strong> WCAG 2.1 AA/AAA Kontrastprüfung und Simulator für Farbenblindheit.</li>
            <li><strong>Moderner Entwickler-Export:</strong> Direkte Ausgabe für Tailwind CSS v4, CSS Custom Properties und SVG.</li>
          </ul>
        </section>

        <ModularToolSections tool="wheel" lang="de" />

        <!-- FAQs -->
        <section id="faq" class="scroll-mt-20 space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Häufig gestellte Fragen (FAQ)
          </h3>
          <div class="space-y-4">
            {germanFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>

  <ExploreColorTools lang="de" currentPage="wheel" />
</Layout>
