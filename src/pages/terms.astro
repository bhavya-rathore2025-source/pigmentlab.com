---
import Layout from '../layouts/Layout.astro';

const termsSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Allgemeine Geschäftsbedingungen — PigmentLab',
  'url': 'https://pigmentlab.com/terms',
  'description': 'Nutzungsbedingungen von PigmentLab: Kostenlos für persönliche und kommerzielle kreative Nutzung mit uneingeschränkten Urheberrechten für erzeugte Paletten.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlab.com'
  }
};
---

<Layout
  title="Allgemeine Geschäftsbedingungen — PigmentLab"
  description="Allgemeine Geschäfts- und Nutzungsbedingungen von PigmentLab. Kostenlose Nutzung für kommerzielle und kreative Zwecke ohne Einschränkungen."
  keywords="pigmentlab agb, nutzungsbedingungen, kommerzielle nutzung, farbpalette rechte"
  currentPath="/terms"
  lang="de"
  schema={termsSchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
        <span>Fair &amp; Transparent</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Allgemeine Geschäftsbedingungen
      </h1>

      <p class="mt-4 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
        Stand: November 2026 · Kostenlose Lizenz für kreative und kommerzielle Arbeiten.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-[#fafafa] dark:bg-[#000000]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] space-y-6">
      <h2 class="text-xl font-bold text-[#171717] dark:text-white">1. Kostenlose Nutzung</h2>
      <p>
        PigmentLab stellt seine Farbwerkzeuge, einschließlich des Farben mischen Simulators und des Itten-Farbkreises, allen Nutzern weltweit kostenlos zur Verfügung.
      </p>
      <h2 class="text-xl font-bold text-[#171717] dark:text-white">2. Eigentum an generierten Farbcodes und Paletten</h2>
      <p>
        Alle von Ihnen mit PigmentLab erstellten Farbmischungen, Farbcodes (HEX, RGB, HSL, CMYK, OKLCH), CSS-Snippets und SVG-Paletten gehören vollumfänglich Ihnen. Sie dürfen diese uneingeschränkt in kommerziellen und privaten Projekten verwenden.
      </p>
    </div>
  </section>
</Layout>
