---
import Layout from '../layouts/Layout.astro';

const privacySchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': 'Datenschutzerklärung — PigmentLab',
  'url': 'https://pigmentlab.com/privacy',
  'description': 'Datenschutzerklärung von PigmentLab: Client-seitige Datenverarbeitung, lokaler Speicher und vollständiger Verzicht auf Tracking.',
  'publisher': {
    '@type': 'Organization',
    'name': 'PigmentLab',
    'url': 'https://pigmentlab.com'
  }
};
---

<Layout
  title="Datenschutzerklärung — PigmentLab"
  description="Lesen Sie die Datenschutzerklärung von PigmentLab. Unsere Werkzeuge laufen rein clientseitig im Browser ohne Tracking, ohne Datenverkauf und mit voller Wahrung Ihrer Privatsphäre (DSGVO-konform)."
  keywords="pigmentlab datenschutz, datenschutzerklärung, dsgvo, client side, privatsphäre"
  currentPath="/privacy"
  lang="de"
  schema={privacySchema}
>
  <section class="border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Datenschutz &amp; Privatsphäre</span>
      </div>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl">
        Datenschutzerklärung
      </h1>

      <p class="mt-4 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
        Stand: November 2026 · PigmentLab respektiert Ihre Privatsphäre in vollem Umfang.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-[#fafafa] dark:bg-[#000000]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 prose dark:prose-invert text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] space-y-6">
      <h2 class="text-xl font-bold text-[#171717] dark:text-white">1. Client-Side-Architektur (Kein Server-Tracking)</h2>
      <p>
        PigmentLab führt alle Berechnungen für den Farben mischen Simulator und den Farbkreis lokal direkt in Ihrem Webbrowser aus. Es werden keine Farbmischungen, Farbwahlen oder persönliche Entwürfe auf unseren Servern gespeichert.
      </p>
      <h2 class="text-xl font-bold text-[#171717] dark:text-white">2. Lokale Speicherung (LocalStorage)</h2>
      <p>
        Wir nutzen den lokalen Speicher Ihres Browsers ausschließlich, um Ihre bevorzugten Einstellungen (z.B. Dark/Light-Modus, benutzerdefinierte Pigmente oder Farbkreis-Modi) zu speichern. Diese Daten verlassen Ihr Gerät zu keinem Zeitpunkt.
      </p>
    </div>
  </section>
</Layout>
