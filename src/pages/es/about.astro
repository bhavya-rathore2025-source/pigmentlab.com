---
import Layout from '../../layouts/Layout.astro';
import JumpNav from '../../components/JumpNav.astro';
import AboutBodySection from '../../components/AboutBodySection.astro';
import ExploreColorTools from '../../components/ExploreColorTools.astro';
import { buildAboutPageSchemas } from '../../utils/seoSchema';
import { aboutJumpLinks } from '../../i18n/toolGuides';

const aboutSchema = buildAboutPageSchemas({
  lang: 'es',
  url: 'https://pigmentlaboratory.com/es/about',
  pageName: 'Sobre PigmentLab',
  pageDescription: 'Conoce la historia y los principios científicos de PigmentLab: física de pigmentos sustractivos de Kubelka-Munk y teoría del color de Johannes Itten.',
  orgDescription: 'Herramientas de color físicas basadas en absorción espectral Kubelka-Munk y el círculo cromático RYB Bauhaus de Johannes Itten.',
  articleHeadline: 'Por qué falla el promedio RGB: física sustractiva Kubelka-Munk y teoría del color Bauhaus',
  articleDescription: 'Comparativa entre luz aditiva RGB y absorción física de pigmentos, junto a las fuentes académicas de Kubelka-Munk, Itten y estándares W3C.',
});
---

<Layout
  title="Sobre PigmentLab — Misión & Ciencia Óptica del Color"
  description="Historia, misión y física óptica de PigmentLab: la unión de la teoría del color de Johannes Itten con la absorción espectral de pigmentos Kubelka-Munk."
  keywords="sobre pigmentlab, historia pigmentlab, misión pigmentlab, ciencia del color, física de pigmentos, kubelka munk, johannes itten, teoría del color"
  currentPath="/es/about"
  lang="es"
  schema={aboutSchema}
>
  <section id="mission" class="scroll-mt-20 border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24 text-center">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
        <span>Nuestra Misión &amp; Fundamentos Científicos</span>
      </div>
      <h1 class="mt-6 text-3xl font-bold tracking-tight text-[#171717] dark:text-white sm:text-5xl lg:text-6xl">
        Realismo de Pintura Física para la Era Digital
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-base sm:text-lg leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
        Durante décadas, las pantallas forzaron a los creadores a trabajar con luz aditiva RGB, degradando las mezclas a tonos grises. PigmentLab devuelve a la web la absorción física de la luz y la armonía clásica del Bauhaus.
      </p>
      <JumpNav items={aboutJumpLinks.es} ariaLabel="Navegación de secciones" />
    </div>
  </section>

  <AboutBodySection lang="es" />

  <ExploreColorTools lang="es" currentPage="about" />
</Layout>

