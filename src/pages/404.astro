---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404: Pigment Not Found — PigmentLab"
  description="The color formula, pigment recipe, or page you were looking for could not be found in our spectral laboratory."
  currentPath="/404"
  noindex={true}
>
  <div class="relative min-h-[calc(100vh-140px)] flex flex-col justify-center overflow-hidden py-12 sm:py-20">
    <!-- Ambient Spectral Glow -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20" aria-hidden="true">
      <div class="absolute -top-[25%] left-[25%] h-[450px] w-[500px] rounded-full bg-gradient-to-tr from-[#007cf0]/30 via-[#7928ca]/25 to-[#ff0080]/25 blur-3xl"></div>
      <div class="absolute -bottom-[20%] right-[20%] h-[400px] w-[450px] rounded-full bg-gradient-to-br from-[#00dfd8]/25 via-[#f9cb28]/30 to-[#ff4d4d]/25 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 w-full">
      <!-- Main Status Card -->
      <div class="rounded-3xl border border-[#ebebeb] dark:border-[#262626] bg-white/80 dark:bg-[#0a0a0a]/80 backdrop-blur-md p-6 sm:p-12 shadow-sm text-center">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 px-3.5 py-1 text-xs font-mono font-medium text-amber-700 dark:text-amber-400">
          <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span>HTTP 404 • Wavelength Dispersed</span>
        </div>

        <!-- Big 404 Header with Pigment Specimen -->
        <div class="mt-8 flex flex-col items-center">
          <!-- Visual Swatch Card: "The Missing Pigment" -->
          <div class="relative group my-4">
            <div class="w-32 h-36 sm:w-40 sm:h-44 rounded-2xl border border-dashed border-[#d4d4d8] dark:border-[#3f3f46] p-2 bg-[#f4f4f5]/60 dark:bg-[#121212]/80 flex flex-col items-center justify-between shadow-inner">
              <!-- Swatch Header -->
              <div class="w-full flex justify-between items-center text-[10px] font-mono text-[#8f8f8f] dark:text-[#71717a] px-1">
                <span>PL-SPEC</span>
                <span>λ: NULL</span>
              </div>
              
              <!-- Center Checkerboard Void (Transparency / Missing) -->
              <div class="w-full h-20 sm:h-24 rounded-lg border border-[#e4e4e7] dark:border-[#27272a] relative overflow-hidden flex items-center justify-center bg-[linear-gradient(45deg,#f0f0f0_25%,transparent_25%),linear-gradient(-45deg,#f0f0f0_25%,transparent_25%),linear-gradient(45deg,transparent_75%,#f0f0f0_75%),linear-gradient(-45deg,transparent_75%,#f0f0f0_75%)] dark:bg-[linear-gradient(45deg,#1f1f1f_25%,transparent_25%),linear-gradient(-45deg,#1f1f1f_25%,transparent_25%),linear-gradient(45deg,transparent_75%,#1f1f1f_75%),linear-gradient(-45deg,transparent_75%,#1f1f1f_75%)] bg-[size:12px_12px]">
                <span class="text-3xl font-mono font-bold text-[#a1a1aa] dark:text-[#52525b] select-none">404</span>
              </div>

              <!-- Swatch Footer -->
              <div class="w-full text-center">
                <span class="text-[10px] font-mono uppercase tracking-wider text-[#71717a] dark:text-[#a1a1aa] font-semibold">
                  Zero Reflectance
                </span>
              </div>
            </div>
          </div>

          <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#171717] dark:text-white mt-2">
            Pigment Not Found
          </h1>

          <p class="mt-4 max-w-lg text-sm sm:text-base leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
            The color recipe, wavelength, or URL you requested does not exist in our physical laboratory. It may have been absorbed, mixed into another palette, or relocated.
          </p>
        </div>

        <!-- Primary Action Buttons -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-xl bg-[#171717] hover:bg-[#333333] text-white px-5 py-2.5 text-sm font-medium transition-colors shadow-sm dark:bg-white dark:text-black dark:hover:bg-[#ededed]"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Return to Home</span>
          </a>

          <a
            href="/mix"
            class="inline-flex items-center gap-2 rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] hover:bg-[#f2f2f2] dark:hover:bg-[#1c1c1c] text-[#171717] dark:text-white px-5 py-2.5 text-sm font-medium transition-colors"
          >
            <svg class="h-4 w-4 text-[#0070f3]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
            <span>Launch Paint Mixer</span>
          </a>

          <button
            type="button"
            onclick="if (history.length > 1) { history.back(); } else { window.location.href = '/'; }"
            class="inline-flex items-center gap-2 rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-transparent hover:bg-[#f2f2f2] dark:hover:bg-[#181818] text-[#71717a] dark:text-[#a1a1aa] px-4 py-2.5 text-sm font-medium transition-colors"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Go Back</span>
          </button>
        </div>

        <!-- Quick Jump Form -->
        <div class="mt-8 pt-8 border-t border-[#ebebeb] dark:border-[#222222] max-w-md mx-auto">
          <label for="color-jump-input" class="block text-xs font-mono font-medium text-[#71717a] dark:text-[#a1a1aa] mb-2 uppercase tracking-wider">
            Quick Jump to Paint Mixer
          </label>
          <form
            id="quick-jump-form"
            class="flex items-center gap-2"
            onsubmit="event.preventDefault(); const val = document.getElementById('color-jump-input').value.trim(); window.location.href = val ? '/mix?color=' + encodeURIComponent(val) : '/mix';"
          >
            <div class="relative flex-1">
              <input
                id="color-jump-input"
                type="text"
                placeholder="Enter hex or paint name (e.g. #0047AB, Ultramarine)..."
                class="w-full rounded-xl border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-2 text-xs sm:text-sm text-[#171717] dark:text-white placeholder-[#8f8f8f] focus:border-[#171717] focus:outline-none dark:focus:border-white transition-colors"
              />
            </div>
            <button
              type="submit"
              class="rounded-xl bg-[#171717] hover:bg-[#333333] text-white dark:bg-[#ededed] dark:text-black dark:hover:bg-white px-3.5 py-2 text-xs sm:text-sm font-medium transition-colors shrink-0"
            >
              Mix Color
            </button>
          </form>
        </div>
      </div>

      <!-- Helpful Destinations Grid -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Subtractive Mixer -->
        <a
          href="/mix"
          class="group rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white/70 dark:bg-[#0e0e0e]/70 p-5 hover:border-[#171717] dark:hover:border-white transition-all shadow-2xs"
        >
          <div class="flex items-center gap-2 text-xs font-mono text-[#0070f3] dark:text-[#3291ff]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
            <span>Tool 01</span>
          </div>
          <h2 class="mt-2 text-base font-semibold text-[#171717] dark:text-white group-hover:text-[#0070f3] transition-colors">
            Subtractive Paint Mixer &rarr;
          </h2>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Blend oil and acrylic paint pigments using Kubelka-Munk spectral absorption optics.
          </p>
        </a>

        <!-- Itten Color Wheel -->
        <a
          href="/color-wheel"
          class="group rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white/70 dark:bg-[#0e0e0e]/70 p-5 hover:border-[#171717] dark:hover:border-white transition-all shadow-2xs"
        >
          <div class="flex items-center gap-2 text-xs font-mono text-purple-600 dark:text-purple-400">
            <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
            <span>Tool 02</span>
          </div>
          <h2 class="mt-2 text-base font-semibold text-[#171717] dark:text-white group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors">
            Johannes Itten Wheel &rarr;
          </h2>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Explore 12-step Bauhaus harmonies, primary/secondary accords, and tint variations.
          </p>
        </a>

        <!-- Contact Support -->
        <a
          href="/contact"
          class="group rounded-2xl border border-[#ebebeb] dark:border-[#262626] bg-white/70 dark:bg-[#0e0e0e]/70 p-5 hover:border-[#171717] dark:hover:border-white transition-all shadow-2xs"
        >
          <div class="flex items-center gap-2 text-xs font-mono text-emerald-600 dark:text-emerald-400">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>Support</span>
          </div>
          <h2 class="mt-2 text-base font-semibold text-[#171717] dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            Contact Laboratory &rarr;
          </h2>
          <p class="mt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
            Report a broken link, request a specific artist pigment, or share feedback.
          </p>
        </a>
      </div>
    </div>
  </div>
</Layout>

