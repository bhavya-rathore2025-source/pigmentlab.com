    // Slot card clicks
    document.querySelectorAll('.slot-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.remove-slot-btn')) return;
        const idx = parseInt((card as HTMLElement).dataset.slotIndex || '0', 10);
        if (activeSlotIndex !== idx) {
          setActiveSlot(idx);
        }
      });
    });

    // Inputs focus setting active slot
    document.querySelectorAll('.color-picker-input, .hex-text-input, .weight-slider').forEach((input) => {
      input.addEventListener('focus', (e) => {
        const target = e.target as HTMLElement;
        const idx = parseInt(target.dataset.index || '0', 10);
        if (activeSlotIndex !== idx) {
          setActiveSlot(idx);
        }
      });
    });

    // Color pickers
    document.querySelectorAll('.color-picker-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.dataset.index || '0', 10);
        colors[idx].hex = target.value;
        const textInput = target.closest('.slot-card')?.querySelector('.hex-text-input') as HTMLInputElement;
        if (textInput) textInput.value = target.value.toUpperCase();
        if (activeSlotIndex !== idx) {
          setActiveSlot(idx);
        } else {
          updateActiveSlotUI();
        }
        updateMix();
      });
    });

    // Hex text inputs
    document.querySelectorAll('.hex-text-input').forEach((input) => {
      input.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        let val = target.value.trim();
        if (!val.startsWith('#')) val = '#' + val;
        const idx = parseInt(target.dataset.index || '0', 10);
        if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
          colors[idx].hex = val;
          const pickerInput = target.closest('.slot-card')?.querySelector('.color-picker-input') as HTMLInputElement;
          if (pickerInput) pickerInput.value = val;
          if (activeSlotIndex !== idx) {
            setActiveSlot(idx);
          } else {
            updateActiveSlotUI();
          }
          updateMix();
        } else {
          target.value = colors[idx].hex.toUpperCase();
        }
      });
    });

    // Sliders
    document.querySelectorAll('.weight-slider').forEach((slider) => {
      slider.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.dataset.index || '0', 10);
        const val = parseInt(target.value, 10);
        colors[idx].weight = val;
        const label = target.parentElement?.querySelector('.weight-label');
        if (label) label.textContent = `${val}%`;
        if (activeSlotIndex !== idx) setActiveSlot(idx);
        updateMix();
      });
    });

    // Remove buttons
    document.querySelectorAll('.remove-slot-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = (e.currentTarget as HTMLElement).dataset.remove;
        if (target !== undefined) {
          const idx = parseInt(target, 10);
          colors.splice(idx, 1);
          if (activeSlotIndex >= colors.length) {
            activeSlotIndex = colors.length - 1;
          } else if (activeSlotIndex === idx) {
            activeSlotIndex = Math.min(idx, colors.length - 1);
          } else if (activeSlotIndex > idx) {
            activeSlotIndex--;
          }
          renderSlots();
        }
      });
    });
  }

  function updateMix() {
    let mixedHex = '#FFFFFF';

    if (currentMode === 'paint') {
      mixedHex = mixPigmentsKubelkaMunk(colors);
      if (blendModeTag) blendModeTag.textContent = 'Kubelka-Munk (RYB)';
    } else if (currentMode === 'oklch') {
      mixedHex = mixOklch(colors);
      if (blendModeTag) blendModeTag.textContent = 'Perceptual (OKLCH)';
    } else if (currentMode === 'rgb') {
      mixedHex = mixRgb(colors);
      if (blendModeTag) blendModeTag.textContent = 'Screen (Linear RGB)';
    } else if (currentMode === 'cmyk') {
      mixedHex = mixCmyk(colors);
      if (blendModeTag) blendModeTag.textContent = 'Subtractive (CMYK)';
    }

    // Update Swatch Box
    if (swatchBox) swatchBox.style.backgroundColor = mixedHex;
    if (hexDisplay) hexDisplay.textContent = mixedHex;

    const rgb = hexToRgb(mixedHex);
    if (rgbDisplay) rgbDisplay.textContent = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;

    // Update Codes
    if (codeHex) codeHex.textContent = mixedHex;
    const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
    if (codeHsl) codeHsl.textContent = `${hsl.h}°, ${hsl.s}%, ${hsl.l}%`;
    const cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
    if (codeCmyk) codeCmyk.textContent = `${cmyk.c}, ${cmyk.m}, ${cmyk.y}, ${cmyk.k}`;
    const oklch = rgbToOklch(rgb.r, rgb.g, rgb.b);
    if (codeOklch) codeOklch.textContent = `${oklch.l}, ${oklch.c}, ${oklch.h}°`;

    // Modern CSS Code Generator
    if (cssSnippetCode) {
      if (currentMode === 'oklch' && colors.length === 2) {
        cssSnippetCode.textContent = `/* Modern CSS color-mix() */\nbackground-color: color-mix(in oklch, ${colors[0].hex} ${colors[0].weight}%, ${colors[1].hex} ${colors[1].weight}%);`;
      } else {
        cssSnippetCode.textContent = `/* Real Color Mix Result */\nbackground-color: ${mixedHex};\n--color-mixed: ${mixedHex};`;
      }
    }

    // Formula indicator
    if (partsFormulaEl) {
      const parts = colors.map((c, i) => `${c.weight} pts`).join(' : ');
      partsFormulaEl.innerHTML = `Formula: <span class="text-[#171717] font-semibold">${parts}</span>`;
    }

    // WCAG Accessibility calculation
    const contrastWhite = getWcagContrast(mixedHex, '#FFFFFF');
    const contrastBlack = getWcagContrast(mixedHex, '#171717');
    const scoreWhite = getContrastRating(contrastWhite);
    const scoreBlack = getContrastRating(contrastBlack);

    if (wcagWhiteRatio) wcagWhiteRatio.textContent = scoreWhite.ratioText;
    if (wcagBlackRatio) wcagBlackRatio.textContent = scoreBlack.ratioText;

    updateBadge(badgeWhiteAa, scoreWhite.aaNormal, 'AA Pass', 'AA Fail');
    updateBadge(badgeWhiteAaa, scoreWhite.aaaNormal, 'AAA Pass', 'AAA Fail');
    updateBadge(badgeBlackAa, scoreBlack.aaNormal, 'AA Pass', 'AA Fail');
    updateBadge(badgeBlackAaa, scoreBlack.aaaNormal, 'AAA Pass', 'AAA Fail');

    // Live UI Component Previews
    if (previewBtn) {
      previewBtn.style.backgroundColor = mixedHex;
      // choose text color based on best contrast
      previewBtn.style.color = contrastWhite >= contrastBlack ? '#FFFFFF' : '#171717';
    }

    if (previewTag) {
      previewTag.style.backgroundColor = `${mixedHex}1F`; // ~12% opacity
      previewTag.style.borderColor = mixedHex;
      previewTag.style.color = mixedHex;
    }

    if (previewCard) {
      previewCard.style.borderLeftColor = mixedHex;
    }
  }

  function updateBadge(el: HTMLElement | null, pass: boolean, passText: string, failText: string) {
    if (!el) return;
    el.textContent = pass ? passText : failText;
    el.className = `rounded px-1.5 py-0.5 text-[10px] font-semibold ${
      pass ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
    }`;
  }

  // Artist Pigment Quick Presets rendering & management
  const presetGrid = document.getElementById('preset-tubes-grid');
  const addPresetForm = document.getElementById('add-preset-form') as HTMLFormElement | null;
  const newPresetInput = document.getElementById('new-preset-hex') as HTMLInputElement | null;
  const hexPreviewDot = document.getElementById('hex-preview-dot');
  const resetPresetsBtn = document.getElementById('reset-presets-btn');

  function renderPresets() {
    if (!presetGrid) return;

    if (pigmentPresets.length === 0) {
      presetGrid.innerHTML = `
        <div class="col-span-2 sm:col-span-4 py-4 text-center">
          <p class="text-xs text-[#8f8f8f]">No presets saved. Paste a hex above to add one, or click Reset Defaults.</p>
        </div>
      `;
      return;
    }

    const currentHex = colors[activeSlotIndex]?.hex?.toUpperCase();

    presetGrid.innerHTML = pigmentPresets.map((preset, idx) => {
      const isMatching = preset.hex.toUpperCase() === currentHex;
      return `
        <div class="relative group">
          <button
            type="button"
            data-hex="${preset.hex}"
            class="tube-preset w-full flex items-center gap-2 rounded-lg border border-[#ebebeb] p-2 pr-7 text-left hover:bg-[#fafafa] active:scale-[0.98] transition-all cursor-pointer ${
              isMatching ? 'border-[#171717] dark:border-white ring-1 ring-[#171717] dark:ring-white bg-[#fafafa]' : ''
            }"
            title="Load ${preset.name} (${preset.hex}) into active slot"
          >
            <span class="h-5 w-5 rounded-md border border-black/10 shrink-0" style="background-color: ${preset.hex};"></span>
            <span class="text-xs truncate font-medium text-[#171717]">${preset.name}</span>
          </button>
          <button
            type="button"
            data-delete-preset="${idx}"
            class="delete-preset-btn absolute right-1.5 top-1/2 -translate-y-1/2 rounded p-1 text-[#8f8f8f] hover:text-[#ee0000] hover:bg-black/5 dark:hover:bg-white/10 opacity-70 sm:opacity-0 sm:group-hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer"
            title="Delete preset ${preset.name}"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      `;
    }).join('');

    attachPresetListeners();
  }

  function attachPresetListeners() {
    // Tube preset click -> load into active slot
    presetGrid?.querySelectorAll('.tube-preset').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const hex = (e.currentTarget as HTMLElement).dataset.hex;
        if (hex) {
          if (activeSlotIndex < 0 || activeSlotIndex >= colors.length) {
            activeSlotIndex = 0;
          }
          colors[activeSlotIndex].hex = hex;
          renderSlots();
          renderPresets();
        }
      });
    });

    // Delete preset
    presetGrid?.querySelectorAll('.delete-preset-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idxStr = (e.currentTarget as HTMLElement).dataset.deletePreset;
        if (idxStr !== undefined) {
          const idx = parseInt(idxStr, 10);
          pigmentPresets.splice(idx, 1);
          savePigmentPresets(pigmentPresets);
          renderPresets();
        }
      });
    });
  }

  // Live color preview dot when typing / pasting hex
  newPresetInput?.addEventListener('input', () => {
    const normalized = normalizeHex(newPresetInput.value);
    if (normalized && hexPreviewDot) {
      hexPreviewDot.style.backgroundColor = normalized;
      hexPreviewDot.classList.remove('hidden');
    } else if (hexPreviewDot) {
      hexPreviewDot.classList.add('hidden');
    }
  });

  // Handle Add Preset submit
  addPresetForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!newPresetInput) return;
    const hex = normalizeHex(newPresetInput.value);
    if (!hex) {
      newPresetInput.focus();
      newPresetInput.classList.add('border-[#ee0000]');
      setTimeout(() => newPresetInput.classList.remove('border-[#ee0000]'), 1500);
      return;
    }

    pigmentPresets.push({ name: hex, hex });
    savePigmentPresets(pigmentPresets);

    // Apply to active slot immediately
    if (activeSlotIndex < 0 || activeSlotIndex >= colors.length) {
      activeSlotIndex = 0;
    }
    colors[activeSlotIndex].hex = hex;

    newPresetInput.value = '';
    if (hexPreviewDot) hexPreviewDot.classList.add('hidden');

    renderSlots();
    renderPresets();
  });

  // Reset defaults
  resetPresetsBtn?.addEventListener('click', () => {
    pigmentPresets = JSON.parse(JSON.stringify(DEFAULT_PIGMENT_PRESETS));
    savePigmentPresets(pigmentPresets);
    renderPresets();
  });

  // Mode button switcher
  modeBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      modeBtns.forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'shadow-xs');
        b.classList.add('text-[#4d4d4d]');
      });
      target.classList.add('bg-[#171717]', 'text-white', 'shadow-xs');
      target.classList.remove('text-[#4d4d4d]');

      currentMode = (target.dataset.mode || 'paint') as any;
      updateMix();
    });
  });

  // Add Color Button
  addColorBtn?.addEventListener('click', () => {
    if (colors.length < 6) {
      colors.push({ hex: '#C41E3A', weight: 50 });
      activeSlotIndex = colors.length - 1;
      renderSlots();
    }
  });

  // Reset Button
  resetBtn?.addEventListener('click', () => {
    colors = [
      { hex: '#002185', weight: 50 },
      { hex: '#FCD200', weight: 50 },
    ];
    activeSlotIndex = 0;
    renderSlots();
  });

  // Random Preset Button
  let presetIdx = 0;
  randomBtn?.addEventListener('click', () => {
    presetIdx = (presetIdx + 1) % MIX_PRESETS.length;
    colors = JSON.parse(JSON.stringify(MIX_PRESETS[presetIdx]));
    activeSlotIndex = 0;
    renderSlots();
  });

  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetId = (e.currentTarget as HTMLElement).dataset.target;
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el && el.textContent) {
          navigator.clipboard.writeText(el.textContent);
          const original = btn.innerHTML;
          btn.innerHTML = `<span class="text-[10px] text-emerald-600 font-mono">Copied!</span>`;
          setTimeout(() => {
            btn.innerHTML = original;
          }, 1500);
        }
      }
    });
  });

  // Copy CSS Snippet
  copyCssBtn?.addEventListener('click', () => {
    if (cssSnippetCode?.textContent) {
      navigator.clipboard.writeText(cssSnippetCode.textContent);
      const original = copyCssBtn.textContent;
      copyCssBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyCssBtn.textContent = original;
      }, 1500);
    }
  });

  // Initial render
  renderSlots();
  renderPresets();
</script>

