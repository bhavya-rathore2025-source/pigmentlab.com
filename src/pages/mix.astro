---
import Layout from '../layouts/Layout.astro';
import MixerStudio from '../components/MixerStudio.astro';

const germanMixFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Wie funktioniert dieser Farben mischen Simulator online?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Unser Farben mischen Simulator nutzt echte subtraktive Pigmentoptik (Kubelka-Munk-Theorie). Anders als typische Bildbearbeitungsprogramme, die RGB-Werte einfach mitteln, simuliert PigmentLab die physikalische Absorption von Lichtteilchen. Deshalb ergibt Blau und Gelb in unserem Tool ein leuchtendes Grün wie bei echten Acryl- oder Ölfarben.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Wie kann man Farben mischen, um Braun zu erhalten (farben mischen braun)?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Um Braun zu mischen, gibt es drei bewährte Rezepte: 1. Alle drei Grundfarben (Rot, Gelb und Blau) zu gleichen Teilen mischen. 2. Komplementärfarben kombinieren: Rot und Grün oder Blau und Orange mischen. 3. Für ein warmes Erdbraun: Viel Gelb mit etwas Rot und einem winzigen Hauch Blau oder Schwarz anmischen.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Was zeigt die Farben mischen Tabelle?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Die Mischtabelle zeigt die genauen physikalischen Ergebnisse beim Zusammenführen von Primär- und Sekundärfarben. Sie dient Malern, Lackierern und Gestaltern als praktische Orientierung für Farbverhältnisse von 1% bis 100%.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Was passiert beim Mischen aller Farben?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Beim subtraktiven Mischen (Pigmente und Lacke) absorbieren die Farbpartikel immer mehr Wellenlängen des Lichts — die Mischung wird dunkler und mündet in einem tiefen Dunkelbraun bis Schwarz. Bei additiver Bildschirmmischung (RGB) entsteht stattdessen reines Weiß.'
      }
    }
  ]
};

const germanMixSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'PigmentLab Farben Mischen Simulator — Mischtabelle & Farbmischung Rechner',
    'url': 'https://pigmentlab.com/mix',
    'description': 'Kostenloser Farben mischen Simulator online mit echter physikalischer Pigmentoptik. Farben mischen Tabelle, Mischtabelle für Acryl- und Ölfarben, Anleitung wie man Braun mischt und CSS color-mix() Rechner.',
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'EUR'
    }
  },
  germanMixFaqSchema
];
---

<Layout
  title="Farben Mischen Online Simulator — Mischtabelle & Farbmischung Rechner"
  description="Kostenloser Farben mischen Simulator mit echter subtraktiver Pigmentphysik. Farben mischen Tabelle, Mischtabelle für Acryl-, Öl- und Wandfarben, Anleitung wie man Braun mischt und CSS color-mix() Rechner."
  keywords="farben mischen, farben mischen tabelle, farben mischen simulator, farben mischen braun, mischtabelle farben mischen tabelle, farbmischung, farben mischen online, acrylfarben mischen, ölfarben mischen"
  currentPath="/mix"
  lang="de"
  schema={germanMixSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[30%] left-[20%] h-[350px] w-[500px] rounded-full bg-gradient-to-tr from-[#007cf0]/40 via-[#7928ca]/30 to-[#ff0080]/30 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[15%] h-[300px] w-[400px] rounded-full bg-gradient-to-br from-[#00dfd8]/30 via-[#f9cb28]/30 to-[#ff4d4d]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3] animate-pulse"></span>
          <span>Subtraktive Pigmentphysik &amp; Mischtabelle</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Farben Mischen Online Simulator &amp; Farbrechner
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Herkömmliche Bildschirmtools mitteln RGB-Kanäle mathematisch zu schmutzigem Graubraun. Unser <strong class="text-[#171717] dark:text-white">Farben mischen Simulator</strong> berechnet echte Partikelabsorption und Lichtstreuung: Mischen Sie <span class="font-medium text-[#002185] dark:text-[#4d79ff]">Blau</span> und <span class="font-medium text-[#cda000] dark:text-[#ffd233]">Gelb</span> zu leuchtendem <span class="font-medium text-[#168a35] dark:text-[#47d169]">Grün</span> wie bei echter Künstlerfarbe.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Studio Component -->
  <MixerStudio lang="de" />

  <!-- Educational Guide & Mixing Table in German -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Pigment-Optik &amp; Farbformeln</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          Der umfassende Leitfaden: Farben mischen, Mischtabelle und Farbrezepte
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Authentische subtraktive Farbmischung verstehen, Farbmischungen für Braun berechnen und CSS color-mix() Code generieren.
        </p>
      </div>

      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            1. Warum ein Farben mischen Simulator mit echter Pigmentphysik?
          </h3>
          <p>
            Wer mit Acrylfarben, Ölfarben, Aquarell oder Wandfarben arbeitet, weiß: Farbpartikel verhalten sich anders als Pixel auf dem Monitor. Das digitale Mischen auf dem Bildschirm ist additiv (Licht wird addiert). Beim physischen <strong>Farben mischen</strong> subtrahieren Pigmente jedoch Lichtwellen. 
          </p>
          <p>
            Unser <strong>Farben mischen Simulator</strong> schließt diese Lücke. Durch Modellierung der optischen Absorptionskoeffizienten nach Kubelka-Munk erhalten Sie realistische Mischresultate, genaue Mischungsverhältnisse in Prozent und anwendungsbereiten Farbcode.
          </p>
        </section>

        <!-- Farben Mischen Tabelle -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            2. Farben mischen Tabelle: Klassische Farbrezepte im Überblick
          </h3>
          <p>
            Nutzen Sie diese <strong>Farben mischen Tabelle</strong> (Mischtabelle) als Richtwert für Ihre künstlerischen Projekte und Wandfarben:
          </p>
          <div class="overflow-x-auto rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#111111] shadow-2xs">
            <table class="w-full text-left text-xs sm:text-sm">
              <thead class="border-b border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#171717] text-xs font-mono uppercase text-[#8f8f8f] dark:text-[#a1a1aa]">
                <tr>
                  <th class="p-4 sm:p-5">Farbe 1</th>
                  <th class="p-4 sm:p-5">Farbe 2</th>
                  <th class="p-4 sm:p-5">Ergebnis mit PigmentLab (Echte Farbe)</th>
                  <th class="p-4 sm:p-5">Typisches Bildschirm-RGB</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#ebebeb] dark:divide-[#222222] text-[#4d4d4d] dark:text-[#a1a1aa]">
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#002185] dark:text-[#4d79ff]">Phthaloblau (#002185)</td>
                  <td class="p-4 sm:p-5 font-medium text-[#cda000] dark:text-[#ffd233]">Kadmiumgelb (#FFF600)</td>
                  <td class="p-4 sm:p-5 font-semibold text-emerald-600 dark:text-emerald-400">Leuchtendes Smaragdgrün (#3D933E)</td>
                  <td class="p-4 sm:p-5 text-[#8f8f8f]">Trübes Graubraun (#808C43)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#c41e3a] dark:text-[#ff4d6d]">Kadmiumrot (#E60026)</td>
                  <td class="p-4 sm:p-5 font-medium text-[#cda000] dark:text-[#ffd233]">Kadmiumgelb (#FFF600)</td>
                  <td class="p-4 sm:p-5 font-semibold text-orange-600 dark:text-orange-400">Kräftiges Orange (#F27B13)</td>
                  <td class="p-4 sm:p-5 text-[#8f8f8f]">Entsättigtes Orange (#F37B13)</td>
                </tr>
                <tr>
                  <td class="p-4 sm:p-5 font-medium text-[#002185] dark:text-[#4d79ff]">Phthaloblau (#002185)</td>
                  <td class="p-4 sm:p-5 font-medium text-[#c41e3a] dark:text-[#ff4d6d]">Kadmiumrot (#E60026)</td>
                  <td class="p-4 sm:p-5 font-semibold text-purple-600 dark:text-purple-400">Tiefes Violett / Purpur</td>
                  <td class="p-4 sm:p-5 text-[#8f8f8f]">Flaches Magenta</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Farben Mischen Braun -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            3. Farben mischen Braun: Die besten Mischverhältnisse
          </h3>
          <p>
            Die Suchanfrage <strong>"farben mischen braun"</strong> gehört zu den häufigsten Fragen in der Malkunst. Da Braun keine Grundfarbe ist, wird es immer aus mehreren Komponenten gemischt:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] p-4">
              <span class="font-mono text-xs font-bold text-[#171717] dark:text-white">Methode A: 3 Grundfarben</span>
              <p class="mt-2 text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">
                Mischen Sie Rot + Gelb + Blau zu gleichen Teilen. Mehr Gelb ergibt Ockerbraun, mehr Rot ergibt Kastanienbraun.
              </p>
            </div>
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] p-4">
              <span class="font-mono text-xs font-bold text-[#171717] dark:text-white">Methode B: Komplementär</span>
              <p class="mt-2 text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">
                Rot + Grün oder Blau + Orange. Dies ergibt sofort ein natürliches, sattes Erdbraun ohne Schmutzstich.
              </p>
            </div>
            <div class="rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] p-4">
              <span class="font-mono text-xs font-bold text-[#171717] dark:text-white">Methode C: Aufhellen &amp; Abdunkeln</span>
              <p class="mt-2 text-xs text-[#4d4d4d] dark:text-[#a1a1aa]">
                Verwenden Sie Titanweiß für Beigetöne und Ultramarinblau (statt reinem Schwarz) für edles Schokoladenbraun.
              </p>
            </div>
          </div>
        </section>

        <!-- FAQs -->
        <section class="space-y-4 border-t border-[#ebebeb] dark:border-[#222222] pt-8">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
            Häufig gestellte Fragen zum Farben Mischen
          </h3>
          <div class="space-y-4">
            {germanMixFaqSchema.mainEntity.map(faq => (
              <details class="group rounded-xl border border-[#ebebeb] dark:border-[#222222] bg-[#f9fafb] dark:bg-[#121212] p-4 open:border-[#171717] dark:open:border-white">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-[#111827] dark:text-white">
                  <span>{faq.name}</span>
                  <span class="ml-2 text-xs text-[#8f8f8f] transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-sm text-[#4d4d4d] dark:text-[#a1a1aa] leading-relaxed">
                  {faq.acceptedAnswer.text}
                </p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>
