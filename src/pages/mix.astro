---
import Layout from '../layouts/Layout.astro';

const mixFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'How does this online color mixer simulate real paint blending?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Our online color mixer implements the Kubelka-Munk subtractive optical theory (K/S ratio). Unlike standard digital tools that linearly average RGB light channels, our pigment physics simulate how physical particles absorb and scatter specific light wavelengths, producing vibrant Green when mixing Blue and Yellow.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Can I mix custom hex codes in this hex color mixer?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. Our hex color mixer allows you to enter any custom hexadecimal color codes, assign proportional weight percentages (from 1% to 100%), and view the resulting mixed color in real time along with RGB, HSL, and modern CSS color-mix() code.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What is the color mixer generator and how many colors can I blend?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'The color mixer generator is an interactive multi-pigment blending tool that supports blending between 2 and 6 colors simultaneously. You can choose from traditional artist oil tubes (Ultramarine Blue, Cadmium Yellow, Crimson Red, Titanium White) or custom palette swatches.'
      }
    },
    {
      '@type': 'Question',
      'name': 'What blending modes does this color mixer online support?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Our color mixer online supports 4 distinct blending modes: Real Paint (Subtractive Kubelka-Munk physics), Modern Web (Perceptually uniform OKLCH space), Digital Screen (Linear RGB), and Print & Inks (CMYK).'
      }
    },
    {
      '@type': 'Question',
      'name': 'Does this hex color mixer test accessibility and text contrast?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes. Every blend created in the hex color mixer is immediately evaluated for WCAG 2.1 AA and AAA contrast compliance against both pure black (#000000) and pure white (#FFFFFF) text, complete with live UI component previews.'
      }
    }
  ]
};

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    'name': 'PigmentLab Color Mixer Online & Hex Color Mixer',
    'url': 'https://pigmentlab.com/mix',
    'description': 'Free online color mixer and hex color mixer with Kubelka-Munk pigment physics. Blend colors with realistic subtractive absorption so Blue + Yellow yields Green. Supports OKLCH, RGB, and CMYK.',
    'applicationCategory': 'DesignApplication',
    'operatingSystem': 'All',
    'offers': {
      '@type': 'Offer',
      'price': '0',
      'priceCurrency': 'USD'
    }
  },
  mixFaqSchema
];
---

<Layout
  title="Color Mixer Online - Hex Color Mixer & Pigment Blending Generator"
  description="Free color mixer online and hex color mixer with realistic Kubelka-Munk pigment physics. Blend colors with proportion sliders, generate CSS color-mix(), and test WCAG contrast. The premier online color mixer."
  keywords="color mixer, color mixer online, online color mixer, color mixer generator, hex color mixer, paint mixer, kubelka munk, real color mixing, css color mix"
  currentPath="/mix"
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="relative border-b border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-10 sm:py-14">
    <!-- Subtle Geist Mesh Gradient Bloom in background -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-30 dark:opacity-20">
      <div class="absolute -top-[30%] left-[20%] h-[350px] w-[500px] rounded-full bg-gradient-to-tr from-[#007cf0]/40 via-[#7928ca]/30 to-[#ff0080]/30 blur-3xl"></div>
      <div class="absolute -top-[20%] right-[15%] h-[300px] w-[400px] rounded-full bg-gradient-to-br from-[#00dfd8]/30 via-[#f9cb28]/30 to-[#ff4d4d]/30 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-[#fafafa] dark:bg-[#141414] px-3.5 py-1 text-[11px] font-mono uppercase tracking-wider text-[#4d4d4d] dark:text-[#a1a1aa] shadow-2xs">
          <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3] animate-pulse"></span>
          <span>Kubelka-Munk Subtractive Physics & CSS color-mix()</span>
        </div>

        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl lg:text-5xl">
          Real Color Mixer Online & Hex Color Mixer
        </h1>

        <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa] sm:text-base">
          Standard screen tools average RGB channels into dirty brownish-grey. Our <strong>online color mixer</strong> and <strong>color mixer generator</strong> simulates true pigment absorption and light scattering — blend <span class="font-medium text-[#002185] dark:text-[#4d79ff]">Blue</span> and <span class="font-medium text-[#cda000] dark:text-[#ffd233]">Yellow</span> to get vibrant <span class="font-medium text-[#168a35] dark:text-[#47d169]">Green</span> like real physical paint.
        </p>

        <!-- Mode Switcher Tabs (Geist Pill style) -->
        <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-1 rounded-full border border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#141414] p-1 shadow-2xs">
          <button
            type="button"
            data-mode="paint"
            class="mode-btn active cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium transition-all bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-xs"
          >
            🎨 Real Paint (RYB / KM)
          </button>
          <button
            type="button"
            data-mode="oklch"
            class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
          >
            💻 Modern Web (OKLCH)
          </button>
          <button
            type="button"
            data-mode="rgb"
            class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
          >
            🖥️ Digital Screen (RGB)
          </button>
          <button
            type="button"
            data-mode="cmyk"
            class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
          >
            🖨️ Print & Inks (CMYK)
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Tool Workspace -->
  <section class="py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        
        <!-- Left Column: Color Ingredients (7 cols) -->
        <div class="space-y-6 lg:col-span-7">
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-4">
              <div>
                <h2 class="text-base font-semibold text-[#171717]">Mixing Palette</h2>
                <p class="text-xs text-[#8f8f8f]">Adjust proportions and colors to create your custom blend.</p>
              </div>
              <div class="flex items-center gap-2">
                <button
                  id="random-mix-btn"
                  type="button"
                  class="inline-flex items-center gap-1.5 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717]"
                  title="Load a preset recipe"
                >
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                  <span>Preset</span>
                </button>
                <button
                  id="reset-mix-btn"
                  type="button"
                  class="inline-flex items-center rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717]"
                  title="Reset to 50/50 Blue & Yellow"
                >
                  Reset
                </button>
              </div>
            </div>

            <!-- Color Slots Container -->
            <div id="color-slots" class="mt-4 space-y-4">
              <!-- Dynamically rendered slots -->
            </div>

            <!-- Add Color & Formula Action Bar -->
            <div class="mt-6 flex flex-col items-start justify-between gap-3 border-t border-[#ebebeb] pt-4 sm:flex-row sm:items-center">
              <button
                id="add-color-btn"
                type="button"
                class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#171717] shadow-2xs transition-colors hover:bg-[#f2f2f2]"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add Color (Max 6)</span>
              </button>

              <div id="parts-formula" class="font-mono text-xs text-[#8f8f8f]">
                Formula: <span class="text-[#171717] font-semibold">1:1 Paint Mix</span>
              </div>
            </div>
          </div>

          <!-- Physical Paint Tubes Swatches -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#ebebeb] pb-3">
              <div>
                <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                  Artist Pigment Quick Presets
                </h3>
                <p class="mt-0.5 text-xs text-[#8f8f8f]">Click any tube to load into the active slot:</p>
              </div>
              <button
                type="button"
                id="reset-presets-btn"
                class="text-[11px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white cursor-pointer self-start sm:self-auto transition-colors"
                title="Reset presets to default traditional palette"
              >
                Reset Defaults
              </button>
            </div>

            <!-- Add custom preset input bar -->
            <form id="add-preset-form" class="mt-3 flex items-center gap-2">
              <div class="relative flex-1">
                <input
                  type="text"
                  id="new-preset-hex"
                  placeholder="Paste HEX (e.g. #3b82f6 or 3b82f6)..."
                  maxlength="9"
                  autocomplete="off"
                  class="w-full rounded-lg border border-[#ebebeb] bg-[#fafafa] dark:bg-[#0a0a0a] px-3 py-1.5 font-mono text-xs text-[#171717] uppercase placeholder:normal-case placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] dark:focus:border-white transition-colors"
                />
                <span id="hex-preview-dot" class="absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 rounded-full border border-black/15 shadow-2xs hidden"></span>
              </div>
              <button
                type="submit"
                id="submit-preset-btn"
                class="inline-flex items-center gap-1.5 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-[#ebebeb] dark:hover:bg-[#1f1f1f] px-3 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors cursor-pointer shrink-0"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Add Preset</span>
              </button>
            </form>

            <div id="preset-tubes-grid" class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
              <!-- Rendered dynamically -->
            </div>
          </div>

          <!-- Real-Time WCAG 2.1 Contrast Matrix -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3">
              <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
                WCAG 2.1 Accessibility
              </h3>
              <span class="text-[11px] text-[#8f8f8f]">Legibility scoring</span>
            </div>

            <div class="mt-4 grid grid-cols-2 gap-3">
              <!-- On White -->
              <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-center">
                <div class="text-[11px] text-[#8f8f8f]">Against White Text</div>
                <div id="wcag-white-ratio" class="mt-1 font-mono text-lg font-bold text-[#171717]">4.32:1</div>
                <div class="mt-2 flex items-center justify-center gap-1">
                  <span id="badge-white-aa" class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800">AA Large</span>
                  <span id="badge-white-aaa" class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-red-100 text-red-800">AAA Fail</span>
                </div>
              </div>

              <!-- On Black -->
              <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-center">
                <div class="text-[11px] text-[#8f8f8f]">Against Black Text</div>
                <div id="wcag-black-ratio" class="mt-1 font-mono text-lg font-bold text-[#171717]">4.86:1</div>
                <div class="mt-2 flex items-center justify-center gap-1">
                  <span id="badge-black-aa" class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800">AA Pass</span>
                  <span id="badge-black-aaa" class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800">AAA Large</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Result Output & Preview Studio (5 cols) -->
        <div class="space-y-6 lg:col-span-5">
          <!-- Main Result Swatch Card -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs">
            <div class="flex items-center justify-between border-b border-[#ebebeb] pb-3">
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f]">
                Mixed Color Result
              </span>
              <span id="blend-mode-tag" class="rounded bg-[#f2f2f2] px-2 py-0.5 font-mono text-[11px] text-[#4d4d4d]">
                Kubelka-Munk
              </span>
            </div>

            <!-- Big Color Swatch Box -->
            <div class="relative mt-4 flex h-36 w-full items-center justify-center rounded-xl border border-black/10 p-4 transition-colors shadow-inner" id="result-swatch-box">
              <div class="rounded-lg bg-black/40 backdrop-blur-md px-3.5 py-1.5 text-center text-white shadow-sm">
                <div id="result-hex-display" class="font-mono text-xl font-bold tracking-wider">#3D933E</div>
                <div id="result-rgb-display" class="text-[11px] font-mono text-white/80">rgb(61, 147, 62)</div>
              </div>
            </div>

            <!-- Color Format Codes Grid -->
            <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
              <div class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2">
                <div class="truncate">
                  <span class="text-[10px] font-mono text-[#8f8f8f] block">HEX</span>
                  <span id="code-hex" class="font-mono font-medium text-[#171717]">#3D933E</span>
                </div>
                <button type="button" class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]" data-target="code-hex" title="Copy HEX">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>

              <div class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2">
                <div class="truncate">
                  <span class="text-[10px] font-mono text-[#8f8f8f] block">HSL</span>
                  <span id="code-hsl" class="font-mono font-medium text-[#171717]">121°, 41%, 41%</span>
                </div>
                <button type="button" class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]" data-target="code-hsl" title="Copy HSL">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>

              <div class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2">
                <div class="truncate">
                  <span class="text-[10px] font-mono text-[#8f8f8f] block">CMYK</span>
                  <span id="code-cmyk" class="font-mono font-medium text-[#171717]">59, 0, 58, 42</span>
                </div>
                <button type="button" class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]" data-target="code-cmyk" title="Copy CMYK">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>

              <div class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2">
                <div class="truncate">
                  <span class="text-[10px] font-mono text-[#8f8f8f] block">OKLCH</span>
                  <span id="code-oklch" class="font-mono font-medium text-[#171717]">0.58, 0.14, 142</span>
                </div>
                <button type="button" class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]" data-target="code-oklch" title="Copy OKLCH">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                </button>
              </div>
            </div>

            <!-- CSS Snippet Generator -->
            <div class="mt-4 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-mono text-[#8f8f8f]">Modern CSS Output</span>
                <button type="button" id="copy-css-snippet" class="text-xs font-medium text-[#0070f3] hover:underline cursor-pointer">
                  Copy Code
                </button>
              </div>
              <pre id="css-snippet-code" class="mt-1 font-mono text-xs text-[#171717] overflow-x-auto whitespace-pre-wrap">background-color: #3D933E;</pre>
            </div>
          </div>

          <!-- Live Design Mockup Preview Studio -->
          <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717]">
              Live UI Component Preview
            </h3>
            <p class="mt-1 text-xs text-[#8f8f8f]">See how this mixed color performs in realistic design components:</p>

            <div class="mt-4 space-y-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-4">
              <!-- Component 1: Action Button -->
              <div class="flex items-center justify-between">
                <span class="text-xs text-[#8f8f8f]">CTA Button</span>
                <button
                  type="button"
                  id="preview-btn"
                  class="rounded-full px-4 py-1.5 text-xs font-semibold text-white shadow-xs transition-colors"
                  style="background-color: #3D933E;"
                >
                  Confirm Action
                </button>
              </div>

              <!-- Component 2: Outline Tag -->
              <div class="flex items-center justify-between border-t border-[#ebebeb] pt-3">
                <span class="text-xs text-[#8f8f8f]">Status Tag</span>
                <span
                  id="preview-tag"
                  class="inline-flex items-center gap-1.5 rounded-full px-3 py-0.5 text-xs font-medium"
                  style="background-color: rgba(61, 147, 62, 0.12); color: #3D933E; border: 1px solid #3D933E;"
                >
                  <span class="h-1.5 w-1.5 rounded-full" style="background-color: #3D933E;"></span>
                  Verified Mix
                </span>
              </div>

              <!-- Component 3: Card Accent -->
              <div
                id="preview-card"
                class="rounded-lg bg-white p-3 text-xs shadow-2xs border-l-4"
                style="border-left-color: #3D933E;"
              >
                <div class="font-semibold text-[#171717]">Card Headline Accent</div>
                <div class="text-[#8f8f8f] mt-0.5">Component preview dynamically renders the pigment mixture.</div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Comprehensive Educational Guide & SEO Section -->
  <article class="border-t border-[#ebebeb] dark:border-[#222222] bg-white dark:bg-[#0a0a0a] py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center mb-14">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">Pigment Science & Code Generation</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-4xl">
          The Complete Guide to Online Color Mixing & Hex Color Generators
        </h2>
        <p class="mt-3 text-base text-[#4d4d4d] dark:text-[#a1a1aa]">
          Discover authentic subtractive pigment blending, mix custom hex codes, and export production-ready CSS color-mix() code.
        </p>
      </div>

      <!-- Main Prose Body -->
      <div class="space-y-12 text-sm sm:text-base leading-relaxed text-[#374151] dark:text-[#d1d5db]">
        
        <!-- Section 1: Color Mixer & Online Color Mixer -->
        <section class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#111827] dark:text-white">
