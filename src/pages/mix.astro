  function normalizeHex(input: string): string | null {
    let val = input.trim();
    if (val.startsWith('#')) val = val.substring(1);
    if (/^[0-9A-Fa-f]{3}$/.test(val)) {
      val = val.split('').map(c => c + c).join('');
    }
    if (/^[0-9A-Fa-f]{6}$/.test(val)) {
      return '#' + val.toUpperCase();
    }
    return null;
  }

