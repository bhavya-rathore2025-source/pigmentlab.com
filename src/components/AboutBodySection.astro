---
import type { SupportedLanguage } from '../i18n/ui';
import { defaultLang } from '../i18n/utils';
import { aboutBodyContent } from '../i18n/toolGuides';
import ScientificReferences from './ScientificReferences.astro';

interface Props {
  lang?: SupportedLanguage;
  includeComparison?: boolean;
}

const { lang = defaultLang, includeComparison = true } = Astro.props;
const t = aboutBodyContent[lang] || aboutBodyContent.en;
---

{
  includeComparison && (
    <section
      id="rgb-vs-kubelka-munk"
      class="scroll-mt-20 border-b border-[#ebebeb] bg-[#fafafa] py-14 sm:py-20 dark:border-[#222222] dark:bg-[#000000]"
    >
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="text-2xl font-semibold tracking-tight text-[#171717] sm:text-3xl dark:text-white">
            {t.problemHeading}
          </h2>
          <p class="mt-3 text-sm text-[#4d4d4d] sm:text-base dark:text-[#a1a1aa]">
            {t.problemSubheading}
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="rounded-2xl border border-red-200 bg-white p-6 shadow-xs sm:p-8 dark:border-red-950/40 dark:bg-[#0c0c0c]">
            <div class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 font-mono text-xs font-medium text-red-600 dark:bg-red-950/30 dark:text-red-400">
              <span>{t.rgbBadge}</span>
            </div>
            <h3 class="mt-4 text-xl font-semibold text-[#171717] dark:text-white">
              {t.rgbTitle}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
              {t.rgbBody}
            </p>
          </div>

          <div class="rounded-2xl border border-emerald-200 bg-white p-6 shadow-xs sm:p-8 dark:border-emerald-950/40 dark:bg-[#0c0c0c]">
            <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 font-mono text-xs font-medium text-emerald-600 dark:bg-emerald-950/30 dark:text-emerald-400">
              <span>{t.kmBadge}</span>
            </div>
            <h3 class="mt-4 text-xl font-semibold text-[#171717] dark:text-white">
              {t.kmTitle}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
              {t.kmBody}
            </p>
          </div>
        </div>
      </div>
    </section>
  )
}

<section class="bg-white py-14 sm:py-16 dark:bg-[#0a0a0a]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <ScientificReferences lang={lang} topic="all" sectionId="scientific-references" />
  </div>
</section>

