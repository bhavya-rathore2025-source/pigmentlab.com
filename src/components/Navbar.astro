---
import {
  languages,
  useTranslations,
  useTranslatedPath,
  type SupportedLanguage,
  defaultLang,
} from '../i18n/utils';

interface Props {
  currentPath?: string;
  lang?: SupportedLanguage;
}

const { currentPath = '/', lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const isMixActive = currentPath === translatePath('/mix') || currentPath.endsWith('/mix');
const isWheelActive = currentPath === translatePath('/color-wheel') || currentPath.endsWith('/color-wheel');
const isAboutActive = currentPath === translatePath('/about') || currentPath.endsWith('/about');
const isContactActive = currentPath === translatePath('/contact') || currentPath.endsWith('/contact');
const isHomeActive = currentPath === translatePath('/') || currentPath === `/${lang}` || currentPath === '/';
---

<header class="sticky top-0 z-50 w-full border-b border-[#ebebeb] bg-[#fafafa]/90 backdrop-blur-md dark:border-[#262626] dark:bg-[#000000]/85">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand / Logo -->
    {isHomeActive ? (
      <span class="flex items-center gap-2.5 shrink-0 cursor-default" aria-current="page">
        <img src="/favicon.svg" alt="PigmentLab" class="h-7 w-7 rounded-lg object-contain" width="28" height="28" />
        <div class="flex flex-col">
          <span class="text-sm font-semibold tracking-tight text-[#171717] dark:text-[#ededed]">PigmentLab</span>
          <span class="hidden text-[10px] text-[#8f8f8f] sm:inline-block dark:text-[#737373]">pigmentlaboratory.com</span>
        </div>
      </span>
    ) : (
      <a href={translatePath('/')} class="group flex items-center gap-2.5 transition-opacity hover:opacity-80 shrink-0">
        <img src="/favicon.svg" alt="PigmentLab" class="h-7 w-7 rounded-lg object-contain" width="28" height="28" />
        <div class="flex flex-col">
          <span class="text-sm font-semibold tracking-tight text-[#171717] dark:text-[#ededed]">PigmentLab</span>
          <span class="hidden text-[10px] text-[#8f8f8f] sm:inline-block dark:text-[#737373]">pigmentlaboratory.com</span>
        </div>
      </a>
    )}

    <!-- Nav Links (Desktop md+) -->
    <nav class="hidden md:flex items-center gap-1 sm:gap-1.5">
      {isMixActive ? (
        <span
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-amber-400 to-blue-500"></span>
          <span>{t('nav.mixer')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/mix')}
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-amber-400 to-blue-500"></span>
          <span>{t('nav.mixer')}</span>
        </a>
      )}

      {isWheelActive ? (
        <span
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-red-500 via-yellow-400 to-emerald-500"></span>
          <span>{t('nav.wheel')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/color-wheel')}
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-red-500 via-yellow-400 to-emerald-500"></span>
          <span>{t('nav.wheel')}</span>
        </a>
      )}

      {isAboutActive ? (
        <span
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span>{t('nav.about')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/about')}
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span>{t('nav.about')}</span>
        </a>
      )}

      {isContactActive ? (
        <span
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span>{t('nav.contact')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/contact')}
          class="inline-flex h-8 items-center rounded-full px-3 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span>{t('nav.contact')}</span>
        </a>
      )}
    </nav>

    <!-- Language Selector Dropdown, Dark Mode & Mobile Menu Button -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      
      <!-- Multilingual Language Selector -->
      <div class="relative" id="lang-picker-container">
        <button
          id="lang-menu-btn"
          type="button"
          class="inline-flex h-8 items-center gap-1 rounded-full border border-[#ebebeb] bg-white px-2.5 text-xs font-medium text-[#4d4d4d] shadow-2xs hover:border-[#171717] dark:border-[#262626] dark:bg-[#141414] dark:text-[#a1a1a1] dark:hover:border-white transition-colors cursor-pointer"
          aria-label={t('nav.switchLang')}
          aria-expanded="false"
        >
          <svg class="h-3.5 w-3.5 text-[#8f8f8f] dark:text-[#737373]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span class="font-semibold uppercase text-[#171717] dark:text-[#ededed]">{lang}</span>
          <svg class="h-3 w-3 text-[#8f8f8f]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="lang-menu-dropdown"
          class="hidden absolute right-0 mt-1.5 w-36 rounded-xl border border-[#ebebeb] bg-white py-1 shadow-lg dark:border-[#262626] dark:bg-[#141414] z-50 divide-y divide-[#f2f2f2] dark:divide-[#222222]"
        >
          <div class="px-3 py-1 text-[10px] font-mono uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]">
            {t('nav.switchLang')}
          </div>
          <div class="py-0.5">
            {Object.entries(languages).map(([code, label]) => {
              const targetUrl = translatePath(currentPath, code as SupportedLanguage);
              const isActive = code === lang;
              return isActive ? (
                <span
                  class="flex items-center justify-between px-3 py-1.5 text-xs font-semibold text-[#171717] bg-[#f5f5f5] dark:text-white dark:bg-[#222222] cursor-default"
                  aria-current="true"
                >
                  <span>{label}</span>
                  <span class="font-mono text-[10px] uppercase text-[#8f8f8f]">{code}</span>
                </span>
              ) : (
                <a
                  href={targetUrl}
                  class="flex items-center justify-between px-3 py-1.5 text-xs text-[#4d4d4d] hover:bg-[#fafafa] hover:text-[#171717] dark:text-[#a1a1aa] dark:hover:bg-[#1a1a1a] dark:hover:text-white transition-colors"
                  hreflang={code}
                >
                  <span>{label}</span>
                  <span class="font-mono text-[10px] uppercase text-[#8f8f8f]">{code}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Dark / Light Mode Toggle Button -->
      <button
        id="theme-toggle-btn"
        type="button"
        class="inline-flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-[#ebebeb] bg-white text-[#4d4d4d] shadow-2xs transition-colors hover:bg-[#f2f2f2] hover:text-[#171717] dark:border-[#262626] dark:bg-[#141414] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed]"
        aria-label="Toggle dark mode"
        title="Toggle dark / light mode"
      >
        <svg id="theme-sun-icon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-moon-icon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Navigation Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="inline-flex md:hidden h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-[#ebebeb] bg-white text-[#4d4d4d] shadow-2xs transition-colors hover:bg-[#f2f2f2] hover:text-[#171717] dark:border-[#262626] dark:bg-[#141414] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed]"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer / Dropdown Panel -->
  <div
    id="mobile-nav-panel"
    class="hidden border-t border-[#ebebeb] bg-white/95 px-4 py-3 backdrop-blur-md md:hidden dark:border-[#262626] dark:bg-[#0a0a0a]/95"
  >
    <div class="flex flex-col gap-2">
      {isMixActive ? (
        <span
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-amber-400 to-blue-500"></span>
            <span class="font-semibold">{t('nav.mixer')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">{t('nav.mixerBadge')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/mix')}
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-amber-400 to-blue-500"></span>
            <span class="font-semibold">{t('nav.mixer')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">{t('nav.mixerBadge')}</span>
        </a>
      )}

      {isWheelActive ? (
        <span
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-red-500 via-yellow-400 to-emerald-500"></span>
            <span class="font-semibold">{t('nav.wheel')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">{t('nav.wheelBadge')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/color-wheel')}
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-red-500 via-yellow-400 to-emerald-500"></span>
            <span class="font-semibold">{t('nav.wheel')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">{t('nav.wheelBadge')}</span>
        </a>
      )}

      {isHomeActive ? (
        <span
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-[#0070f3] to-[#ff0080]"></span>
            <span class="font-semibold">{t('nav.home')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">PigmentLab</span>
        </span>
      ) : (
        <a
          href={translatePath('/')}
          class="flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <div class="flex items-center gap-2.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-gradient-to-r from-[#0070f3] to-[#ff0080]"></span>
            <span class="font-semibold">{t('nav.home')}</span>
          </div>
          <span class="font-mono text-[10px] opacity-75">PigmentLab</span>
        </a>
      )}

      <div class="my-1 border-t border-[#ebebeb] dark:border-[#222222]"></div>

      {isAboutActive ? (
        <span
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span class="font-medium">{t('nav.about')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/about')}
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span class="font-medium">{t('nav.about')}</span>
        </a>
      )}

      {isContactActive ? (
        <span
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium bg-[#171717] text-white shadow-xs dark:bg-white dark:text-[#171717] cursor-default"
          aria-current="page"
        >
          <span class="font-medium">{t('nav.contact')}</span>
        </span>
      ) : (
        <a
          href={translatePath('/contact')}
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb]/60 hover:text-[#171717] dark:text-[#a1a1a1] dark:hover:bg-[#1f1f1f] dark:hover:text-[#ededed] transition-colors"
        >
          <span class="font-medium">{t('nav.contact')}</span>
        </a>
      )}

      <!-- Mobile Compact Language Selector (<select> avoids redundant crawler links) -->
      <div class="mt-2 flex items-center justify-between rounded-xl border border-[#ebebeb] bg-[#fafafa] px-3 py-2 dark:border-[#222222] dark:bg-[#121212]">
        <label for="mobile-lang-select" class="flex items-center gap-2 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa]">
          <svg class="h-3.5 w-3.5 text-[#8f8f8f] dark:text-[#737373]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>{t('nav.switchLang')}</span>
        </label>
        <div class="relative">
          <select
            id="mobile-lang-select"
            class="appearance-none rounded-lg border border-[#ebebeb] bg-white py-1 pl-2.5 pr-7 text-xs font-semibold text-[#171717] shadow-2xs transition-colors hover:border-[#171717] focus:outline-hidden focus:ring-1 focus:ring-[#171717] dark:border-[#262626] dark:bg-[#1a1a1a] dark:text-[#ededed] dark:hover:border-white cursor-pointer"
            aria-label={t('nav.switchLang')}
          >
            {Object.entries(languages).map(([code, label]) => {
              const targetUrl = translatePath(currentPath, code as SupportedLanguage);
              const isActive = code === lang;
              return (
                <option value={targetUrl} selected={isActive}>
                  {label} ({code.toUpperCase()})
                </option>
              );
            })}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-1.5 text-[#8f8f8f]">
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between px-3 pt-2 text-[11px] text-[#8f8f8f] dark:text-[#737373]">
        <a href={translatePath('/privacy')} class="hover:underline" rel="nofollow">{t('nav.privacy')}</a>
        <span>·</span>
        <a href={translatePath('/terms')} class="hover:underline" rel="nofollow">{t('nav.terms')}</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Language dropdown toggle handler
  const langMenuBtn = document.getElementById('lang-menu-btn');
  const langMenuDropdown = document.getElementById('lang-menu-dropdown');

  langMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = langMenuDropdown?.classList.contains('hidden');
    if (isHidden) {
      langMenuDropdown?.classList.remove('hidden');
      langMenuBtn.setAttribute('aria-expanded', 'true');
    } else {
      langMenuDropdown?.classList.add('hidden');
      langMenuBtn.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('click', (e) => {
    if (!langMenuDropdown?.contains(e.target as Node) && !langMenuBtn?.contains(e.target as Node)) {
      langMenuDropdown?.classList.add('hidden');
      langMenuBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Mobile language select change handler
  const mobileLangSelect = document.getElementById('mobile-lang-select') as HTMLSelectElement | null;
  mobileLangSelect?.addEventListener('change', () => {
    if (mobileLangSelect.value) {
      window.location.href = mobileLangSelect.value;
    }
  });

  // Dark / Light Mode Toggle handler
  const themeToggleBtn = document.getElementById('theme-toggle-btn');
  const sunIcon = document.getElementById('theme-sun-icon');
  const moonIcon = document.getElementById('theme-moon-icon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
        themeToggleBtn?.setAttribute('aria-label', 'Switch to light mode');
        themeToggleBtn?.setAttribute('title', 'Switch to light mode');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
        themeToggleBtn?.setAttribute('aria-label', 'Switch to dark mode');
        themeToggleBtn?.setAttribute('title', 'Switch to dark mode');
      }
    }
  }

  updateThemeUI();

  themeToggleBtn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('pl_theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('pl_theme', 'dark');
    }
    updateThemeUI();
    window.dispatchEvent(new CustomEvent('pl:themechange', { detail: { theme: isDark ? 'light' : 'dark' } }));
  });

  // Mobile Navigation Drawer Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileNavPanel = document.getElementById('mobile-nav-panel');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function toggleMobileMenu(forceClose = false) {
    if (!mobileNavPanel || !mobileMenuBtn) return;
    const isCurrentlyOpen = !mobileNavPanel.classList.contains('hidden');
    const shouldOpen = forceClose ? false : !isCurrentlyOpen;

    if (shouldOpen) {
      mobileNavPanel.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'true');
    } else {
      mobileNavPanel.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
    }
  }

  mobileMenuBtn?.addEventListener('click', () => toggleMobileMenu());

  mobileNavPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMobileMenu(true));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      toggleMobileMenu(true);
    }
  });
</script>
