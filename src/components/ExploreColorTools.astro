---
import { useTranslatedPath, type SupportedLanguage, defaultLang } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
  currentPage: 'mix' | 'wheel' | 'about' | 'home';
}

const { lang = defaultLang, currentPage } = Astro.props;
const translatePath = useTranslatedPath(lang);

interface ToolCardCopy {
  badge: string;
  title: string;
  description: string;
  cta: string;
  dotClass: string;
}

interface ExploreCopy {
  eyebrow: string;
  heading: string;
  subheading: string;
  mix: ToolCardCopy;
  wheel: ToolCardCopy;
  about: ToolCardCopy;
  home: ToolCardCopy;
}

const copyByLang: Record<SupportedLanguage, ExploreCopy> = {
