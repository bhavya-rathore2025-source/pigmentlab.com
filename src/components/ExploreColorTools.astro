    mix: {
      badge: 'Симулятор Кубелки-Мунка',
      title: 'Симулятор смешивания цветов и таблица красок',
      description: 'Смешивайте реальные пигменты (Синий + Желтый = Зеленый), тестируйте режимы OKLCH и CMYK и экспортируйте CSS color-mix().',
      cta: 'Открыть симулятор смешивания →',
