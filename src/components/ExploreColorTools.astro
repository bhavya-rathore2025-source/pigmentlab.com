const t = copyByLang[lang] || copyByLang.en;

const targets: Array<{ key: 'mix' | 'wheel' | 'about' | 'home'; path: string; card: ToolCardCopy }> = [
  { key: 'mix', path: '/mix', card: t.mix },
  { key: 'wheel', path: '/color-wheel', card: t.wheel },
  { key: 'about', path: '/about', card: t.about },
  { key: 'home', path: '/', card: t.home },
].filter((item) => item.key !== currentPage);
---

<section
  id="explore-tools"
  class="scroll-mt-20 border-t border-[#ebebeb] bg-[#fafafa] py-14 dark:border-[#222222] dark:bg-[#000000]"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#71717a]">
        {t.eyebrow}
      </span>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-[#171717] dark:text-white sm:text-3xl">
        {t.heading}
      </h2>
      <p class="mt-2 text-sm text-[#4d4d4d] dark:text-[#a1a1aa]">
        {t.subheading}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        targets.map((item) => (
          <a
            href={translatePath(item.path)}
            class="group flex flex-col justify-between rounded-2xl border border-[#ebebeb] bg-white p-5 shadow-2xs transition-all duration-200 hover:border-[#171717] hover:shadow-md dark:border-[#262626] dark:bg-[#0d0d0d] dark:hover:border-white"
          >
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-0.5 font-mono text-[11px] font-medium text-[#4d4d4d] dark:border-[#2e2e2e] dark:bg-[#141414] dark:text-[#a1a1aa]">
                <span class={`h-1.5 w-1.5 rounded-full ${item.card.dotClass}`} />
                <span>{item.card.badge}</span>
              </span>
              <h3 class="mt-3 text-base font-semibold tracking-tight text-[#171717] dark:text-white">
                {item.card.title}
              </h3>
              <p class="mt-2 text-xs leading-relaxed text-[#4d4d4d] dark:text-[#a1a1aa]">
                {item.card.description}
              </p>
            </div>
            <div class="mt-4 border-t border-[#ebebeb] pt-3 text-xs font-semibold text-[#171717] group-hover:underline dark:border-[#222222] dark:text-white">
              {item.card.cta}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

