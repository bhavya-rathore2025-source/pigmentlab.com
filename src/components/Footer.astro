---
import {
  languages,
  useTranslations,
  useTranslatedPath,
  type SupportedLanguage,
  defaultLang,
} from '../i18n/utils';

interface Props {
  currentPath?: string;
  lang?: SupportedLanguage;
}

const { currentPath = '/', lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="w-full border-t border-[#ebebeb] bg-[#fafafa] py-12 text-[#4d4d4d] dark:border-[#262626] dark:bg-[#0a0a0a]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      <!-- Col 1: Brand & Theory -->
      <div class="space-y-3 md:col-span-1">
        <div class="flex items-center gap-2">
          <img src="/favicon.svg" alt="PigmentLab" class="h-6 w-6 rounded-md object-contain" width="24" height="24" />
          <span class="text-sm font-semibold tracking-tight text-[#171717] dark:text-[#ededed]">PigmentLab</span>
        </div>
        <p class="text-xs leading-relaxed text-[#8f8f8f] dark:text-[#a1a1a1]">
          {t('footer.tagline')}
        </p>
        <p class="text-[11px] text-[#a1a1a1] dark:text-[#737373]">
          © {new Date().getFullYear()} pigmentlab.com · {t('footer.copyright')}
        </p>
      </div>

      <!-- Col 2: Core Tools -->
      <div class="space-y-2">
        <h3 class="font-mono text-xs font-semibold tracking-wider text-[#171717] uppercase dark:text-[#ededed]">{t('footer.tools')}</h3>
        <ul class="space-y-1.5 text-xs">
          <li>
            <a href={translatePath('/mix')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('footer.mixerLink')} <span class="rounded bg-[#f2f2f2] px-1.5 py-0.5 text-[10px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1a1]">{t('nav.mixerBadge')}</span>
            </a>
          </li>
          <li>
            <a href={translatePath('/color-wheel')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('footer.wheelLink')} <span class="rounded bg-[#f2f2f2] px-1.5 py-0.5 text-[10px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1a1]">{t('nav.wheelBadge')}</span>
            </a>
          </li>
          <li>
            <a href={translatePath('/')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('footer.overviewLink')} <span class="rounded bg-[#f2f2f2] px-1.5 py-0.5 text-[10px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1a1]">Specs</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Color Science & Modes -->
      <div class="space-y-2">
        <h3 class="font-mono text-xs font-semibold tracking-wider text-[#171717] uppercase dark:text-[#ededed]">{t('footer.colorScience')}</h3>
        <ul class="space-y-1.5 text-xs text-[#8f8f8f] dark:text-[#a1a1a1]">
          <li><span class="text-[#4d4d4d] dark:text-[#d4d4d4]">Kubelka-Munk (K/S):</span> Subtractive paint mixing</li>
          <li><span class="text-[#4d4d4d] dark:text-[#d4d4d4]">Itten 12-Hue RYB:</span> Traditional artist wheel</li>
          <li><span class="text-[#4d4d4d] dark:text-[#d4d4d4]">OKLCH &amp; OKLab:</span> CSS Color Module 4</li>
          <li><span class="text-[#4d4d4d] dark:text-[#d4d4d4]">WCAG 2.1:</span> AA / AAA contrast validation</li>
        </ul>
      </div>

      <!-- Col 4: Company & Legal -->
      <div class="space-y-2">
        <h3 class="font-mono text-xs font-semibold tracking-wider text-[#171717] uppercase dark:text-[#ededed]">{t('footer.legal')}</h3>
        <ul class="space-y-1.5 text-xs">
          <li>
            <a href={translatePath('/about')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('nav.about')} <span class="rounded bg-[#f2f2f2] px-1.5 py-0.5 text-[10px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1a1]">Story &amp; Science</span>
            </a>
          </li>
          <li>
            <a href={translatePath('/contact')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('nav.contact')} <span class="rounded bg-[#f2f2f2] px-1.5 py-0.5 text-[10px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1a1]">Support &amp; Feedback</span>
            </a>
          </li>
          <li>
            <a href={translatePath('/privacy')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('nav.privacy')}
            </a>
          </li>
          <li>
            <a href={translatePath('/terms')} class="transition-colors hover:text-[#171717] dark:hover:text-white">
              {t('nav.terms')}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Multilingual Language Selector Links in Footer (for SEO crawling & indexing) -->
    <div class="mt-8 border-t border-[#ebebeb] pt-6 dark:border-[#262626]">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <span class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] uppercase tracking-wider">{t('footer.multilingual')}:</span>
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          {Object.entries(languages).map(([code, label]) => {
            const targetUrl = translatePath(currentPath, code as SupportedLanguage);
            const isActive = code === lang;
            return (
              <a
                href={targetUrl}
                class={`rounded-full px-2.5 py-0.5 text-[11px] transition-colors ${
                  isActive
                    ? 'bg-[#171717] font-semibold text-white dark:bg-white dark:text-[#171717]'
                    : 'text-[#666666] hover:bg-[#ebebeb] hover:text-[#171717] dark:text-[#888888] dark:hover:bg-[#1f1f1f] dark:hover:text-white'
                }`}
                hreflang={code}
              >
                {label}
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <div class="mt-6 flex flex-col items-center justify-between border-t border-[#ebebeb] pt-6 text-[11px] text-[#8f8f8f] sm:flex-row dark:border-[#262626] dark:text-[#737373]">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a href={translatePath('/about')} class="hover:text-[#171717] dark:hover:text-white transition-colors">{t('nav.about')}</a>
        <span>·</span>
        <a href={translatePath('/contact')} class="hover:text-[#171717] dark:hover:text-white transition-colors">{t('nav.contact')}</a>
        <span>·</span>
        <a href={translatePath('/privacy')} class="hover:text-[#171717] dark:hover:text-white transition-colors">{t('nav.privacy')}</a>
        <span>·</span>
        <a href={translatePath('/terms')} class="hover:text-[#171717] dark:hover:text-white transition-colors">{t('nav.terms')}</a>
      </div>
      <div class="mt-3 flex items-center gap-3 sm:mt-0">
        <span class="text-[10px]">Built with Astro &amp; Tailwind v4</span>
        <span>·</span>
        <span class="font-mono text-[#171717] dark:text-[#ededed]">pigmentlab.com</span>
      </div>
    </div>
  </div>
</footer>
