const labels = studioI18n[lang] || studioI18n.de;
---

<!-- Mode Switcher Tabs -->
<div class="mt-6 flex justify-center">
  <div
    class="inline-flex flex-wrap items-center justify-center gap-1 rounded-2xl sm:rounded-full border border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#141414] p-1.5 sm:p-1 shadow-2xs max-w-full"
  >
    <button
      type="button"
      data-mode="paint"
      class="mode-btn active cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium transition-all bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-xs"
    >
      {labels.modePaint}
    </button>
    <button
      type="button"
      data-mode="oklch"
      class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
    >
      {labels.modeOklch}
    </button>
    <button
      type="button"
      data-mode="rgb"
      class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
    >
      {labels.modeRgb}
    </button>
    <button
      type="button"
      data-mode="cmyk"
      class="mode-btn cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
    >
      {labels.modeCmyk}
    </button>
  </div>
</div>

<!-- Main Tool Workspace -->
<section class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <!-- Left Column: Mixer Controls & Live Results (7 cols) -->
      <div class="space-y-6 lg:col-span-7">
        <!-- Main Result Swatch Card -->
        <div
          class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs dark:border-[#222222] dark:bg-[#111111]"
        >
          <div
            class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-3"
          >
            <span
              class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f] dark:text-[#737373]"
            >
              {labels.resultTitle}
            </span>
            <span
              id="blend-mode-tag"
              class="rounded bg-[#f2f2f2] px-2 py-0.5 font-mono text-[11px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1aa]"
            >
              Real Paint (RYB)
            </span>
          </div>

          <!-- Big Color Swatch Box -->
          <div
            class="relative mt-4 flex h-36 w-full items-center justify-center rounded-xl border border-black/10 p-4 transition-colors shadow-inner"
            id="result-swatch-box"
          >
            <div
              class="rounded-lg bg-black/40 backdrop-blur-md px-3.5 py-1.5 text-center text-white shadow-sm"
            >
              <div
                id="result-hex-display"
                class="font-mono text-xl font-bold tracking-wider"
              >
                #3D933E
              </div>
              <div
                id="result-rgb-display"
                class="text-[11px] font-mono text-white/80"
              >
                rgb(61, 147, 62)
              </div>
            </div>
          </div>
        </div>

        <!-- Mixing Palette Card -->
        <div
          class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs dark:border-[#222222] dark:bg-[#111111]"
        >
          <div
            class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-4"
          >
            <div>
              <h2 class="text-base font-semibold text-[#171717] dark:text-white">
                {labels.paletteTitle}
              </h2>
              <p class="text-xs text-[#8f8f8f] dark:text-[#a1a1aa]">
                {labels.paletteSubtitle}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="random-mix-btn"
                type="button"
                class="inline-flex items-center gap-1.5 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] dark:hover:text-white cursor-pointer"
                title={labels.presetBtn}
              >
                <svg
                  class="h-3.5 w-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  ></path>
                </svg>
                <span>{labels.presetBtn}</span>
              </button>
              <button
                id="reset-mix-btn"
                type="button"
                class="inline-flex items-center rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] dark:hover:text-white cursor-pointer"
                title={labels.resetBtn}
              >
                {labels.resetBtn}
              </button>
            </div>
          </div>

          <!-- Color Slots Container -->
          <div id="color-slots" class="mt-4 space-y-4">
            <!-- Dynamically rendered slots -->
          </div>

          <!-- Add Color & Formula Action Bar -->
          <div
            class="mt-6 flex flex-col items-start justify-between gap-3 border-t border-[#ebebeb] dark:border-[#222222] pt-4 sm:flex-row sm:items-center"
          >
            <button
              id="add-color-btn"
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full border border-[#ebebeb] bg-white px-3.5 py-1.5 text-xs font-medium text-[#171717] shadow-2xs transition-colors hover:bg-[#f2f2f2] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-white dark:hover:bg-[#262626] cursor-pointer"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"></path>
              </svg>
              <span>{labels.addColor}</span>
            </button>

            <div id="parts-formula" class="font-mono text-xs text-[#8f8f8f] dark:text-[#737373]">
              {labels.formula} <span class="text-[#171717] dark:text-white font-semibold"
                >1:1 Paint Mix</span
              >
            </div>
          </div>
        </div>

        <!-- Live Design Mockup Preview Studio -->
        <div
          class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]"
        >
          <h3
            class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white"
          >
            {labels.uiPreviewTitle}
          </h3>
          <p class="mt-1 text-xs text-[#8f8f8f] dark:text-[#737373]">
            {labels.uiPreviewSubtitle}
          </p>

          <div
            class="mt-4 space-y-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-4 dark:border-[#222222] dark:bg-[#141414]"
          >
            <!-- CTA Button -->
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#8f8f8f] dark:text-[#737373]">{labels.ctaBtn}</span>
              <button
                type="button"
                id="preview-btn"
                class="rounded-full px-4 py-1.5 text-xs font-semibold text-white shadow-xs transition-colors"
                style="background-color: #3D933E;"
              >
                {labels.confirmAction}
              </button>
            </div>

            <!-- Outline Tag -->
            <div
              class="flex items-center justify-between border-t border-[#ebebeb] dark:border-[#222222] pt-3"
            >
              <span class="text-xs text-[#8f8f8f] dark:text-[#737373]">{labels.statusTag}</span>
              <span
                id="preview-tag"
                class="inline-flex items-center gap-1.5 rounded-full px-3 py-0.5 text-xs font-medium"
                style="background-color: rgba(61, 147, 62, 0.12); color: #3D933E; border: 1px solid #3D933E;"
              >
                <span
                  class="h-1.5 w-1.5 rounded-full"
                  style="background-color: #3D933E;"></span>
                {labels.verifiedMix}
              </span>
            </div>

            <!-- Card Accent -->
            <div
              id="preview-card"
              class="rounded-lg bg-white p-3 text-xs shadow-2xs border-l-4 dark:bg-[#1a1a1a]"
              style="border-left-color: #3D933E;"
            >
              <div class="font-semibold text-[#171717] dark:text-white">
                {labels.cardHeadline}
              </div>
              <div class="text-[#8f8f8f] dark:text-[#a1a1aa] mt-0.5">
                {labels.cardSubtitle}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Color Codes, Presets & Accessibility (5 cols) -->
      <div class="space-y-6 lg:col-span-5">
        <!-- Color Codes Output Component -->
        <ColorCodesOutput />

        <!-- Physical Paint Tubes Swatches -->
        <div
          class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]"
        >
          <div
            class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#ebebeb] dark:border-[#222222] pb-3"
          >
            <div>
              <h3
                class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white"
              >
                {labels.quickPresetsTitle}
              </h3>
              <p class="mt-0.5 text-xs text-[#8f8f8f] dark:text-[#737373]">
                {labels.quickPresetsSubtitle}
              </p>
            </div>
            <button
              type="button"
              id="reset-presets-btn"
              class="text-[11px] font-mono text-[#8f8f8f] hover:text-[#171717] dark:hover:text-white cursor-pointer self-start sm:self-auto transition-colors"
              title={labels.resetDefaults}
            >
              {labels.resetDefaults}
            </button>
          </div>

          <!-- Add custom preset input bar -->
          <form id="add-preset-form" class="mt-3 flex items-center gap-2">
            <div class="relative flex-1">
              <input
                type="text"
                id="new-preset-hex"
                placeholder={labels.pasteHex}
                maxlength="9"
                autocomplete="off"
                class="w-full rounded-lg border border-[#ebebeb] bg-[#fafafa] dark:border-[#2e2e2e] dark:bg-[#0a0a0a] px-3 py-1.5 font-mono text-xs text-[#171717] dark:text-white uppercase placeholder:normal-case placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] dark:focus:border-white transition-colors"
              />
              <span
                id="hex-preview-dot"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 rounded-full border border-black/15 shadow-2xs hidden"
              ></span>
            </div>
            <button
              type="submit"
              id="submit-preset-btn"
              class="inline-flex items-center gap-1.5 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-[#ebebeb] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:hover:bg-[#282828] px-3 py-1.5 text-xs font-medium text-[#171717] dark:text-[#ededed] transition-colors cursor-pointer shrink-0"
            >
              <svg
                class="h-3.5 w-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4v16m8-8H4"></path>
              </svg>
              <span>{labels.addPreset}</span>
            </button>
          </form>

          <div
            id="preset-tubes-grid"
            class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-2"
          >
            <!-- Rendered dynamically -->
          </div>
        </div>

        <!-- Real-Time WCAG 2.1 Contrast Matrix -->
        <div
          class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]"
        >
          <div
            class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-3"
          >
            <h3
              class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white"
            >
              {labels.wcagTitle}
            </h3>
            <span class="text-[11px] text-[#8f8f8f] dark:text-[#737373]">{labels.wcagSubtitle}</span>
          </div>

          <div class="mt-4 grid grid-cols-2 gap-3">
            <!-- On White -->
            <div
              class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-center dark:border-[#222222] dark:bg-[#141414]"
            >
              <span class="text-xs font-medium text-[#8f8f8f] dark:text-[#737373]">{labels.onWhite}</span>
              <div
                id="wcag-white-ratio"
                class="mt-1 font-mono text-lg font-bold text-[#171717] dark:text-white"
              >
                3.8:1
              </div>
              <div class="mt-2 flex items-center justify-center gap-1.5">
                <span
                  id="badge-white-aa"
                  class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-red-100 text-red-800"
                  >AA Fail</span
                >
                <span
                  id="badge-white-aaa"
                  class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800"
                  >{labels.largeText}</span
                >
              </div>
            </div>

            <!-- On Black -->
            <div
              class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-center dark:border-[#222222] dark:bg-[#141414]"
            >
              <span class="text-xs font-medium text-[#8f8f8f] dark:text-[#737373]">{labels.onBlack}</span>
              <div
                id="wcag-black-ratio"
                class="mt-1 font-mono text-lg font-bold text-[#171717] dark:text-white"
              >
                5.5:1
              </div>
              <div class="mt-2 flex items-center justify-center gap-1.5">
                <span
                  id="badge-black-aa"
                  class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800"
                  >AA Pass</span
                >
                <span
                  id="badge-black-aaa"
                  class="rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800"
                  >{labels.largeText}</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    mixPigmentsKubelkaMunk,
    mixOklch,
    mixRgb,
    mixCmyk,
    hexToRgb,
    rgbToHex,
    rgbToHsl,
    rgbToCmyk,
    rgbToOklch,
    getWcagContrast,
    getContrastRating,
    type ColorWeight,
  } from "../utils/colorPhysics";

  function normalizeHex(input: string): string | null {
    let val = input.trim();
    if (val.startsWith("#")) val = val.substring(1);
    if (/^[0-9A-Fa-f]{3}$/.test(val)) {
      val = val
        .split("")
        .map((c) => c + c)
        .join("");
    }
    if (/^[0-9A-Fa-f]{6}$/.test(val)) {
      return "#" + val.toUpperCase();
    }
    return null;
  }

  const STORAGE_KEY_PRESETS = "pl_pigment_presets_v1";
  const STORAGE_KEY_MIXER = "pl_color_mixer_state_v1";

  interface MixerState {
    currentMode: "paint" | "oklch" | "rgb" | "cmyk";
    colors: ColorWeight[];
    activeSlotIndex: number;
  }

  const DEFAULT_PRESETS = [
    { name: "Phthalo Blue", hex: "#002185" },
    { name: "Cadmium Yellow", hex: "#FFF600" },
    { name: "Cadmium Red", hex: "#E60026" },
    { name: "Titanium White", hex: "#FFFFFF" },
    { name: "Ivory Black", hex: "#171717" },
    { name: "Burnt Sienna", hex: "#8A3324" },
    { name: "Viridian Green", hex: "#007F5C" },
    { name: "Cobalt Teal", hex: "#00A896" },
    { name: "Ultramarine Blue", hex: "#120A8F" },
    { name: "Yellow Ochre", hex: "#C68E17" },
    { name: "Alizarin Crimson", hex: "#E32636" },
    { name: "Raw Umber", hex: "#734A12" },
  ];

  function loadPresets(): Array<{ name: string; hex: string }> {
    try {
      const raw =
        localStorage.getItem(STORAGE_KEY_PRESETS) ||
        localStorage.getItem("rcm_pigment_presets_v1");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      }
    } catch (e) {}
    return [...DEFAULT_PRESETS];
  }

  function savePresets(presets: Array<{ name: string; hex: string }>) {
    try {
      localStorage.setItem(STORAGE_KEY_PRESETS, JSON.stringify(presets));
    } catch (e) {}
  }

  const DEFAULT_MIXER_STATE: MixerState = {
    currentMode: "paint",
    colors: [
      { hex: "#002185", weight: 50 },
      { hex: "#FFF600", weight: 50 },
    ],
    activeSlotIndex: 0,
  };

  function loadMixerState(): MixerState {
    try {
      const raw =
        localStorage.getItem(STORAGE_KEY_MIXER) ||
        localStorage.getItem("rcm_color_mixer_state_v1");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && Array.isArray(parsed.colors) && parsed.colors.length >= 2) {
          const validModes = ["paint", "oklch", "rgb", "cmyk"];
          const mode = validModes.includes(parsed.currentMode)
            ? parsed.currentMode
            : "paint";
          const activeIndex =
            typeof parsed.activeSlotIndex === "number" &&
            parsed.activeSlotIndex >= 0 &&
            parsed.activeSlotIndex < parsed.colors.length
              ? parsed.activeSlotIndex
              : 0;

          const sanitizedColors: ColorWeight[] = parsed.colors
            .slice(0, 6)
            .map((c: any) => ({
              hex: normalizeHex(c.hex || "") || "#002185",
              weight:
                typeof c.weight === "number" && !isNaN(c.weight)
                  ? Math.max(1, Math.min(100, Math.round(c.weight)))
                  : 50,
            }));

          if (sanitizedColors.length >= 2) {
            return {
              currentMode: mode as any,
              colors: sanitizedColors,
              activeSlotIndex: activeIndex,
            };
          }
        }
      }
    } catch (e) {}
    return {
      currentMode: "paint",
      colors: [
        { hex: "#002185", weight: 50 },
        { hex: "#FFF600", weight: 50 },
      ],
      activeSlotIndex: 0,
    };
  }

  function saveMixerState(state: MixerState) {
    try {
      localStorage.setItem(STORAGE_KEY_MIXER, JSON.stringify(state));
    } catch (e) {}
  }

  let artistPresets = loadPresets();
  const mixerState = loadMixerState();
  let currentMode: "paint" | "oklch" | "rgb" | "cmyk" = mixerState.currentMode;
  let colors: ColorWeight[] = mixerState.colors;
  let activeSlotIndex: number = mixerState.activeSlotIndex;

  function persistCurrentState() {
    saveMixerState({
      currentMode,
      colors,
      activeSlotIndex,
    });
  }

  const swatchBox = document.getElementById("result-swatch-box");
  const hexDisplay = document.getElementById("result-hex-display");
  const rgbDisplay = document.getElementById("result-rgb-display");
  const blendModeTag = document.getElementById("blend-mode-tag");
  const colorSlotsContainer = document.getElementById("color-slots");
  const addColorBtn = document.getElementById("add-color-btn");
  const resetBtn = document.getElementById("reset-mix-btn");
  const randomBtn = document.getElementById("random-mix-btn");
  const partsFormula = document.getElementById("parts-formula");
  const previewBtn = document.getElementById("preview-btn");
  const previewTag = document.getElementById("preview-tag");
  const previewCard = document.getElementById("preview-card");
  const presetGrid = document.getElementById("preset-tubes-grid");
  const addPresetForm = document.getElementById("add-preset-form");
  const newPresetHexInput = document.getElementById("new-preset-hex") as HTMLInputElement;
  const hexPreviewDot = document.getElementById("hex-preview-dot");
  const resetPresetsBtn = document.getElementById("reset-presets-btn");

  const codeHex = document.getElementById("code-hex");
  const codeRgb = document.getElementById("code-rgb");
  const codeHsl = document.getElementById("code-hsl");
  const codeCmyk = document.getElementById("code-cmyk");
  const codeOklch = document.getElementById("code-oklch");
  const cssSnippetCode = document.getElementById("css-snippet-code");
  const copyCssBtn = document.getElementById("copy-css-btn");

  const wcagWhiteRatio = document.getElementById("wcag-white-ratio");
  const wcagBlackRatio = document.getElementById("wcag-black-ratio");
  const badgeWhiteAA = document.getElementById("badge-white-aa");
  const badgeWhiteAAA = document.getElementById("badge-white-aaa");
  const badgeBlackAA = document.getElementById("badge-black-aa");
  const badgeBlackAAA = document.getElementById("badge-black-aaa");

  function calculateMixedColor(): string {
    if (!colors || colors.length === 0) return "#808080";
    if (colors.length === 1) return colors[0].hex;

    switch (currentMode) {
      case "paint":
        return mixPigmentsKubelkaMunk(colors);
      case "oklch":
        return mixOklch(colors);
      case "rgb":
        return mixRgb(colors);
      case "cmyk":
        return mixCmyk(colors);
      default:
        return mixPigmentsKubelkaMunk(colors);
    }
  }

  function renderPresets() {
    if (!presetGrid) return;
    presetGrid.innerHTML = "";

    artistPresets.forEach((tube, index) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "group relative flex items-center gap-2 rounded-lg border border-[#ebebeb] bg-[#fafafa] dark:border-[#262626] dark:bg-[#141414] p-2 text-left transition-all hover:border-[#171717] dark:hover:border-white hover:bg-white dark:hover:bg-[#1f1f1f] shadow-2xs cursor-pointer";
      button.title = `${tube.name} (${tube.hex}) - Click to assign to active slot`;

      button.innerHTML = `
        <span class="h-5 w-5 shrink-0 rounded-full border border-black/10 shadow-2xs" style="background-color: ${tube.hex};"></span>
        <div class="min-w-0 flex-1">
          <div class="truncate text-xs font-medium text-[#171717] dark:text-[#ededed]">${tube.name}</div>
          <div class="font-mono text-[10px] text-[#8f8f8f] dark:text-[#737373]">${tube.hex}</div>
        </div>
        ${
          index >= DEFAULT_PRESETS.length
            ? `<span data-delete-idx="${index}" class="text-[10px] text-red-500 hover:text-red-700 px-1 opacity-0 group-hover:opacity-100 transition-opacity" title="Delete custom preset">×</span>`
            : ""
        }
      `;

      button.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target && target.hasAttribute("data-delete-idx")) {
          e.stopPropagation();
          const delIdx = parseInt(target.getAttribute("data-delete-idx") || "-1", 10);
          if (delIdx >= 0) {
            artistPresets.splice(delIdx, 1);
            savePresets(artistPresets);
            renderPresets();
          }
          return;
        }

        if (colors[activeSlotIndex]) {
          colors[activeSlotIndex].hex = tube.hex;
          persistCurrentState();
          renderSlots();
          updateMix();
        }
      });

      presetGrid.appendChild(button);
    });
  }

  function renderSlots() {
    if (!colorSlotsContainer) return;
    colorSlotsContainer.innerHTML = "";

    colors.forEach((colorItem, index) => {
      const slot = document.createElement("div");
      slot.className = `slot-item rounded-xl border p-3 sm:p-4 transition-all ${
        index === activeSlotIndex
          ? "border-[#171717] bg-[#fafafa] dark:border-white dark:bg-[#141414] shadow-xs"
          : "border-[#ebebeb] bg-white dark:border-[#262626] dark:bg-[#0f0f0f]"
      }`;

      slot.innerHTML = `
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="font-mono text-xs font-semibold text-[#8f8f8f]">#${index + 1}</span>
            <input
              type="color"
              value="${colorItem.hex}"
              data-slot-index="${index}"
              class="slot-color-picker h-8 w-8 cursor-pointer rounded-full border border-black/10 bg-transparent p-0"
              title="Pick color"
            />
            <input
              type="text"
              value="${colorItem.hex}"
              data-slot-index="${index}"
              maxlength="7"
              class="slot-hex-input w-20 rounded border border-[#ebebeb] bg-white dark:border-[#333333] dark:bg-[#1a1a1a] px-2 py-1 font-mono text-xs font-semibold uppercase text-[#171717] dark:text-[#ededed] shadow-2xs"
            />
          </div>

          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
              <input
                type="range"
                min="1"
                max="100"
                value="${colorItem.weight}"
                data-slot-index="${index}"
                class="slot-weight-slider h-1.5 w-24 sm:w-32 cursor-pointer accent-[#171717] dark:accent-white"
              />
              <span class="slot-weight-label w-10 text-right font-mono text-xs font-medium text-[#171717] dark:text-[#ededed]">
                ${colorItem.weight}%
              </span>
            </div>

            ${
              colors.length > 2
                ? `
              <button
                type="button"
                data-remove-slot="${index}"
                class="cursor-pointer text-[#8f8f8f] hover:text-red-500 p-1 transition-colors"
                title="Remove color slot"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            `
                : ""
            }
          </div>
        </div>
      `;

      slot.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.tagName !== "INPUT" && target.tagName !== "BUTTON" && !target.closest("button")) {
          activeSlotIndex = index;
          persistCurrentState();
          renderSlots();
        }
      });

      colorSlotsContainer.appendChild(slot);
    });

    colorSlotsContainer.querySelectorAll(".slot-color-picker").forEach((input) => {
      input.addEventListener("input", (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute("data-slot-index") || "0", 10);
        colors[idx].hex = (e.target as HTMLInputElement).value.toUpperCase();
        activeSlotIndex = idx;
        const hexText = colorSlotsContainer?.querySelector(`.slot-hex-input[data-slot-index="${idx}"]`) as HTMLInputElement;
        if (hexText) hexText.value = colors[idx].hex;
        persistCurrentState();
        updateMix();
      });
    });

    colorSlotsContainer.querySelectorAll(".slot-hex-input").forEach((input) => {
      input.addEventListener("change", (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute("data-slot-index") || "0", 10);
        const val = normalizeHex((e.target as HTMLInputElement).value);
        if (val) {
          colors[idx].hex = val;
          activeSlotIndex = idx;
          const picker = colorSlotsContainer?.querySelector(`.slot-color-picker[data-slot-index="${idx}"]`) as HTMLInputElement;
          if (picker) picker.value = val;
          (e.target as HTMLInputElement).value = val;
          persistCurrentState();
          updateMix();
        }
      });
    });

    colorSlotsContainer.querySelectorAll(".slot-weight-slider").forEach((slider) => {
      slider.addEventListener("input", (e) => {
        const idx = parseInt((e.target as HTMLElement).getAttribute("data-slot-index") || "0", 10);
        const val = parseInt((e.target as HTMLInputElement).value, 10);
        colors[idx].weight = val;
        const label = colorSlotsContainer?.querySelector(`.slot-weight-label[data-slot-index="${idx}"]`);
        if (label) label.textContent = `${val}%`;
        persistCurrentState();
        updateMix();
      });
    });

    colorSlotsContainer.querySelectorAll("[data-remove-slot]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const idx = parseInt((btn as HTMLElement).getAttribute("data-remove-slot") || "0", 10);
        if (colors.length > 2) {
          colors.splice(idx, 1);
          if (activeSlotIndex >= colors.length) activeSlotIndex = colors.length - 1;
          persistCurrentState();
          renderSlots();
          updateMix();
        }
      });
    });
  }

  function updateMix() {
    const mixedHex = calculateMixedColor();
    const rgbArr = hexToRgb(mixedHex);
    const rgb = { r: rgbArr[0], g: rgbArr[1], b: rgbArr[2] };
    const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
    const cmyk = rgbToCmyk(rgb.r, rgb.g, rgb.b);
    const oklch = rgbToOklch(rgb.r, rgb.g, rgb.b);

    if (swatchBox) swatchBox.style.backgroundColor = mixedHex;

    if (blendModeTag) {
      if (currentMode === "paint") blendModeTag.textContent = "Real Paint (RYB)";
      if (currentMode === "oklch") blendModeTag.textContent = "Perceptual (OKLCH)";
      if (currentMode === "rgb") blendModeTag.textContent = "Screen (Linear RGB)";
      if (currentMode === "cmyk") blendModeTag.textContent = "Subtractive (CMYK)";
    }

    if (hexDisplay) hexDisplay.textContent = mixedHex;
    if (rgbDisplay) rgbDisplay.textContent = `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;

    if (codeHex) codeHex.textContent = mixedHex;
    if (codeRgb) codeRgb.textContent = `${rgb.r}, ${rgb.g}, ${rgb.b}`;
    if (codeHsl) codeHsl.textContent = `${hsl.h}°, ${hsl.s}%, ${hsl.l}%`;
    if (codeCmyk) codeCmyk.textContent = `${cmyk.c}, ${cmyk.m}, ${cmyk.y}, ${cmyk.k}`;
    if (codeOklch) codeOklch.textContent = `${oklch.l}, ${oklch.c}, ${oklch.h}°`;

    if (cssSnippetCode) {
      if (currentMode === "oklch" && colors.length === 2) {
        cssSnippetCode.textContent = `/* Modern CSS color-mix() */\nbackground-color: color-mix(in oklch, ${colors[0].hex} ${colors[0].weight}%, ${colors[1].hex} ${colors[1].weight}%);`;
      } else {
        cssSnippetCode.textContent = `/* PigmentLab Mix Result */\nbackground-color: ${mixedHex};\n--color-mixed: ${mixedHex};`;
      }
    }

    if (partsFormula) {
      const parts = colors.map((c) => `${c.weight}% ${c.hex}`).join(" + ");
      partsFormula.innerHTML = `Recipe: <span class="font-semibold text-[#171717] dark:text-white">${parts}</span>`;
    }

    if (previewBtn) previewBtn.style.backgroundColor = mixedHex;
    if (previewTag) {
      previewTag.style.backgroundColor = `${mixedHex}20`;
      previewTag.style.color = mixedHex;
      previewTag.style.borderColor = mixedHex;
      const dot = previewTag.querySelector("span");
      if (dot) dot.style.backgroundColor = mixedHex;
    }
    if (previewCard) previewCard.style.borderLeftColor = mixedHex;

    const scoreWhite = getWcagContrast(mixedHex, "#FFFFFF");
    const scoreBlack = getWcagContrast(mixedHex, "#000000");

    if (wcagWhiteRatio) wcagWhiteRatio.textContent = scoreWhite.ratioText;
    if (wcagBlackRatio) wcagBlackRatio.textContent = scoreBlack.ratioText;

    const ratingWhite = getContrastRating(scoreWhite.ratio);
    const ratingBlack = getContrastRating(scoreBlack.ratio);

    updateBadge(badgeWhiteAA, ratingWhite.aa, "AA Pass", "AA Fail");
    updateBadge(badgeWhiteAAA, ratingWhite.aaa, "AAA Large", "AAA Fail");
    updateBadge(badgeBlackAA, ratingBlack.aa, "AA Pass", "AA Fail");
    updateBadge(badgeBlackAAA, ratingBlack.aaa, "AAA Large", "AAA Fail");
  }

  function updateBadge(el: HTMLElement | null, pass: boolean, passText: string, failText: string) {
    if (!el) return;
    if (pass) {
      el.className = "rounded px-1.5 py-0.5 text-[10px] font-semibold bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300";
    } else {
      el.className = "rounded px-1.5 py-0.5 text-[10px] font-semibold bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300";
    }
    el.textContent = pass ? passText : failText;
  }

  document.querySelectorAll(".mode-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".mode-btn").forEach((b) => {
        b.classList.remove("active", "bg-[#171717]", "text-white", "dark:bg-white", "dark:text-[#171717]");
        b.classList.add("text-[#4d4d4d]", "dark:text-[#a1a1aa]");
      });
      btn.classList.add("active", "bg-[#171717]", "text-white", "dark:bg-white", "dark:text-[#171717]");
      btn.classList.remove("text-[#4d4d4d]", "dark:text-[#a1a1aa]");

      const mode = btn.getAttribute("data-mode");
      if (mode) {
        currentMode = mode as any;
        persistCurrentState();
        updateMix();
      }
    });
  });

  addColorBtn?.addEventListener("click", () => {
    if (colors.length < 6) {
      colors.push({ hex: "#E60026", weight: 30 });
      activeSlotIndex = colors.length - 1;
      persistCurrentState();
      renderSlots();
      updateMix();
    }
  });

  resetBtn?.addEventListener("click", () => {
    colors = [
      { hex: "#002185", weight: 50 },
      { hex: "#FFF600", weight: 50 },
    ];
    activeSlotIndex = 0;
    currentMode = "paint";

    document.querySelectorAll(".mode-btn").forEach((b) => {
      b.classList.remove("active", "bg-[#171717]", "text-white", "dark:bg-white", "dark:text-[#171717]");
      b.classList.add("text-[#4d4d4d]", "dark:text-[#a1a1aa]");
    });
    const defaultModeBtn = document.querySelector('.mode-btn[data-mode="paint"]');
    if (defaultModeBtn) {
      defaultModeBtn.classList.add("active", "bg-[#171717]", "text-white", "dark:bg-white", "dark:text-[#171717]");
      defaultModeBtn.classList.remove("text-[#4d4d4d]", "dark:text-[#a1a1aa]");
    }

    persistCurrentState();
    renderSlots();
    updateMix();
  });

  const PRESET_RECIPES = [
    [
      { hex: "#002185", weight: 50 },
      { hex: "#FFF600", weight: 50 },
    ],
    [
      { hex: "#E60026", weight: 60 },
      { hex: "#FFF600", weight: 40 },
    ],
    [
      { hex: "#002185", weight: 50 },
      { hex: "#E60026", weight: 50 },
    ],
    [
      { hex: "#C68E17", weight: 40 },
      { hex: "#8A3324", weight: 40 },
      { hex: "#002185", weight: 20 },
    ],
    [
      { hex: "#007F5C", weight: 60 },
      { hex: "#FFFFFF", weight: 40 },
    ],
  ];

  randomBtn?.addEventListener("click", () => {
    const recipe = PRESET_RECIPES[Math.floor(Math.random() * PRESET_RECIPES.length)];
    colors = JSON.parse(JSON.stringify(recipe));
    activeSlotIndex = 0;
    persistCurrentState();
    renderSlots();
    updateMix();
  });

  newPresetHexInput?.addEventListener("input", () => {
    const val = normalizeHex(newPresetHexInput.value);
    if (val && hexPreviewDot) {
      hexPreviewDot.style.backgroundColor = val;
      hexPreviewDot.classList.remove("hidden");
    } else if (hexPreviewDot) {
      hexPreviewDot.classList.add("hidden");
    }
  });

  addPresetForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!newPresetHexInput) return;
    const val = normalizeHex(newPresetHexInput.value);
    if (val) {
      artistPresets.push({
        name: `Custom ${val}`,
        hex: val,
      });
      savePresets(artistPresets);
      newPresetHexInput.value = "";
      if (hexPreviewDot) hexPreviewDot.classList.add("hidden");
      renderPresets();
    }
  });

  resetPresetsBtn?.addEventListener("click", () => {
    artistPresets = [...DEFAULT_PRESETS];
    savePresets(artistPresets);
    renderPresets();
  });

  document.querySelectorAll(".copy-code-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      if (targetId) {
        const el = document.getElementById(targetId);
        if (el && el.textContent) {
          navigator.clipboard.writeText(el.textContent);
          const icon = btn.querySelector("svg");
          if (icon) {
            icon.classList.add("text-emerald-500");
            setTimeout(() => icon.classList.remove("text-emerald-500"), 1200);
          }
        }
      }
    });
  });

  copyCssBtn?.addEventListener("click", () => {
    if (cssSnippetCode?.textContent) {
      navigator.clipboard.writeText(cssSnippetCode.textContent);
      const original = copyCssBtn.textContent;
      copyCssBtn.textContent = "Copied!";
      setTimeout(() => {
        copyCssBtn.textContent = original;
      }, 1500);
    }
  });

  renderPresets();
  renderSlots();
  updateMix();
</script>

