const labels = studioI18n[lang] || studioI18n.en;
---

<!-- Mode Switcher Tabs (Itten vs Digital RGB) -->
<div class="mt-6 flex justify-center">
  <div class="inline-flex flex-wrap items-center justify-center gap-1 rounded-2xl sm:rounded-full border border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#141414] p-1.5 sm:p-1 shadow-2xs max-w-full">
    <button
      type="button"
      id="wheel-mode-itten"
      data-wheel="itten"
      class="wheel-mode-btn active cursor-pointer rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-xs"
    >
      {labels.modeItten}
    </button>
    <button
      type="button"
      id="wheel-mode-rgb"
      data-wheel="rgb"
      class="wheel-mode-btn cursor-pointer rounded-full px-4 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all"
    >
      {labels.modeRgb}
    </button>
  </div>
</div>

<!-- Main Tool Canvas Section -->
<section class="py-10">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    
    <!-- Palette Scheme Filter Bar -->
    <div class="mb-8 flex flex-wrap items-center justify-center gap-1.5">
      <button
        type="button"
        data-scheme="complementary"
        class="scheme-btn active cursor-pointer rounded-full px-3.5 py-1.5 text-xs font-medium transition-all bg-[#171717] dark:bg-white text-white dark:text-[#171717] shadow-xs"
      >
        {labels.comp}
      </button>
      <button
        type="button"
        data-scheme="analogous"
        class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#141414] px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#1e1e1e] hover:text-[#171717] dark:hover:text-white transition-all"
      >
        {labels.ana}
      </button>
      <button
        type="button"
        data-scheme="triadic"
        class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#141414] px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#1e1e1e] hover:text-[#171717] dark:hover:text-white transition-all"
      >
        {labels.tri}
      </button>
      <button
        type="button"
        data-scheme="tetradic"
        class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#141414] px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#1e1e1e] hover:text-[#171717] dark:hover:text-white transition-all"
      >
        {labels.tet}
      </button>
      <button
        type="button"
        data-scheme="split"
        class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#141414] px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#1e1e1e] hover:text-[#171717] dark:hover:text-white transition-all"
      >
        {labels.split}
      </button>
      <button
        type="button"
        data-scheme="monochromatic"
        class="scheme-btn cursor-pointer rounded-full border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#141414] px-3.5 py-1.5 text-xs font-medium text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#fafafa] dark:hover:bg-[#1e1e1e] hover:text-[#171717] dark:hover:text-white transition-all"
      >
        {labels.mono}
      </button>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      
      <!-- Left Column: Interactive Wheel Canvas (6 cols) -->
      <div class="space-y-6 lg:col-span-6">
        <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs dark:border-[#222222] dark:bg-[#111111]">
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-4">
            <div>
              <h2 class="text-base font-semibold text-[#171717] dark:text-white">{labels.canvasTitle}</h2>
              <p id="wheel-desc-tag" class="text-xs text-[#8f8f8f] dark:text-[#a1a1aa]">
                {labels.canvasDesc}
              </p>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="random-hue-btn"
                type="button"
                class="inline-flex items-center gap-1.5 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] dark:hover:text-white cursor-pointer"
                title={labels.shuffle}
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>{labels.shuffle}</span>
              </button>
              <button
                id="reset-wheel-btn"
                type="button"
                class="inline-flex items-center rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] transition-colors hover:bg-[#ebebeb] hover:text-[#171717] dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] dark:hover:text-white cursor-pointer"
                title={labels.reset}
              >
                {labels.reset}
              </button>
            </div>
          </div>

          <!-- Canvas Container -->
          <div class="relative mx-auto mt-6 flex items-center justify-center">
            <canvas
              id="color-wheel-canvas"
              width="360"
              height="360"
              class="touch-none cursor-crosshair rounded-full border border-[#ebebeb] shadow-xs select-none w-full max-w-[360px] aspect-square dark:border-[#222222]"
            ></canvas>
          </div>

          <!-- Precision Controls (Sliders & Hex) -->
          <div class="mt-6 space-y-3 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-4 text-xs dark:border-[#222222] dark:bg-[#141414]">
            <div class="flex items-center justify-between gap-4">
              <span class="w-24 font-mono text-[#8f8f8f] dark:text-[#737373]">{labels.hue}</span>
              <input
                type="range"
                id="hue-slider"
                min="0"
                max="359"
                value="0"
                class="h-1.5 flex-1 cursor-pointer accent-[#171717] dark:accent-white"
              />
              <span id="hue-value-label" class="w-12 text-right font-mono font-semibold text-[#171717] dark:text-white">0°</span>
            </div>

            <div class="flex items-center justify-between gap-4">
              <span class="w-24 font-mono text-[#8f8f8f] dark:text-[#737373]">{labels.sat}</span>
              <input
                type="range"
                id="sat-slider"
                min="20"
                max="100"
                value="100"
                class="h-1.5 flex-1 cursor-pointer accent-[#171717] dark:accent-white"
              />
              <span id="sat-value-label" class="w-12 text-right font-mono font-semibold text-[#171717] dark:text-white">100%</span>
            </div>

            <div class="flex items-center justify-between gap-4">
              <span class="w-24 font-mono text-[#8f8f8f] dark:text-[#737373]">{labels.light}</span>
              <input
                type="range"
                id="light-slider"
                min="20"
                max="80"
                value="50"
                class="h-1.5 flex-1 cursor-pointer accent-[#171717] dark:accent-white"
              />
              <span id="light-value-label" class="w-12 text-right font-mono font-semibold text-[#171717] dark:text-white">50%</span>
            </div>

            <div class="flex items-center justify-between border-t border-[#ebebeb] dark:border-[#222222] pt-3">
              <span class="font-mono text-[#8f8f8f] dark:text-[#737373]">{labels.baseHex}</span>
              <div class="flex items-center gap-2">
                <span id="base-color-dot" class="h-4 w-4 rounded-full border border-black/10 dark:border-white/10 shadow-2xs" style="background-color: #FF0000;"></span>
                <input
                  type="text"
                  id="base-hex-input"
                  value="#FF0000"
                  maxlength="7"
                  class="w-24 rounded border border-[#ebebeb] bg-white px-2 py-0.5 font-mono text-xs uppercase font-medium text-[#171717] dark:border-[#333333] dark:bg-[#1a1a1a] dark:text-white"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Color Vision Deficiency Simulator -->
        <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]">
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-3">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white">
              {labels.cvdTitle}
            </h3>
            <span class="text-[11px] text-[#8f8f8f]">8% of users</span>
          </div>
          <p class="mt-2 text-xs text-[#8f8f8f] dark:text-[#737373]">{labels.cvdDesc}</p>
          <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
            <button type="button" data-cvd="normal" class="cvd-btn active rounded-md border border-[#ebebeb] dark:border-white bg-[#171717] dark:bg-white px-2.5 py-1.5 text-xs font-medium text-white dark:text-[#171717] transition-colors cursor-pointer">
              {labels.cvdNormal}
            </button>
            <button type="button" data-cvd="protanopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] cursor-pointer">
              {labels.cvdProtanopia}
            </button>
            <button type="button" data-cvd="deuteranopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] cursor-pointer">
              {labels.cvdDeuteranopia}
            </button>
            <button type="button" data-cvd="tritanopia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] cursor-pointer">
              {labels.cvdTritanopia}
            </button>
            <button type="button" data-cvd="achromatopsia" class="cvd-btn rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1.5 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] transition-colors dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] cursor-pointer">
              {labels.cvdAchromatopsia}
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Palette Swatches, 9-Shade Scales & WCAG (6 cols) -->
      <div class="space-y-6 lg:col-span-6">
        
        <!-- Palette Swatches Card -->
        <div class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs dark:border-[#222222] dark:bg-[#111111]">
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-4">
            <h2 class="text-base font-semibold text-[#171717] dark:text-white">{labels.paletteTitle}</h2>
            <span id="palette-count-tag" class="rounded bg-[#f2f2f2] px-2 py-0.5 font-mono text-[11px] text-[#4d4d4d] dark:bg-[#1a1a1a] dark:text-[#a1a1aa]">
              2 {labels.paletteColors}
            </span>
          </div>

          <!-- Dynamic Swatches Row -->
          <div id="palette-swatches-grid" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- Swatches injected by JS -->
          </div>

          <!-- Dynamic 9-Step Shade & Tint Scale (Tailwind 50-900) -->
          <div class="mt-6 border-t border-[#ebebeb] dark:border-[#222222] pt-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white">
                {labels.scaleTitle}
              </span>
              <span id="active-scale-label" class="font-mono text-xs text-[#8f8f8f] dark:text-[#a1a1aa]">
                Base Color
              </span>
            </div>
            <p class="mt-1 text-xs text-[#8f8f8f] dark:text-[#737373]">{labels.scaleDesc}</p>

            <div id="shade-scale-strip" class="mt-3 flex overflow-x-auto rounded-lg border border-[#ebebeb] shadow-inner dark:border-[#262626]">
              <!-- 50 to 900 swatches -->
            </div>
          </div>
        </div>

        <!-- Real-Time WCAG 2.1 Contrast Matrix -->
        <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]">
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-3">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white">
              {labels.wcagTitle}
            </h3>
            <span class="text-[11px] text-[#8f8f8f] dark:text-[#737373]">{labels.wcagSubtitle}</span>
          </div>

          <div id="wcag-contrast-matrix" class="mt-4 space-y-2 text-xs">
            <!-- Matrix rows injected by JS -->
          </div>
        </div>

        <!-- Multi-Format Developer Export -->
        <div class="rounded-xl border border-[#ebebeb] bg-white p-5 shadow-2xs dark:border-[#222222] dark:bg-[#111111]">
          <div class="flex items-center justify-between border-b border-[#ebebeb] dark:border-[#222222] pb-3">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white">
              {labels.exportTitle}
            </h3>
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="download-svg-btn"
                class="inline-flex items-center gap-1 rounded-md border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-xs font-medium text-[#4d4d4d] hover:bg-[#ebebeb] hover:text-[#171717] transition-colors dark:border-[#2e2e2e] dark:bg-[#1a1a1a] dark:text-[#a1a1aa] dark:hover:bg-[#282828] dark:hover:text-white cursor-pointer"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>{labels.exportSvg}</span>
              </button>
            </div>
          </div>

          <!-- Export Code Formats -->
          <div class="mt-4 space-y-3">
            <!-- Tailwind Config -->
            <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-xs dark:border-[#222222] dark:bg-[#141414]">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] text-[#8f8f8f] dark:text-[#737373]">{labels.tailwindTitle}</span>
                <button type="button" id="copy-tailwind-btn" class="font-medium text-[#0070f3] hover:underline cursor-pointer">
                  {labels.copyCode}
                </button>
              </div>
              <pre id="tailwind-export-code" class="mt-1 font-mono text-[11px] text-[#171717] dark:text-[#ededed] overflow-x-auto whitespace-pre-wrap"></pre>
            </div>

            <!-- CSS Variables -->
            <div class="rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3 text-xs dark:border-[#222222] dark:bg-[#141414]">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] text-[#8f8f8f] dark:text-[#737373]">{labels.cssVarsTitle}</span>
                <button type="button" id="copy-css-vars-btn" class="font-medium text-[#0070f3] hover:underline cursor-pointer">
                  {labels.copyCss}
                </button>
              </div>
              <pre id="css-vars-export-code" class="mt-1 font-mono text-[11px] text-[#171717] dark:text-[#ededed] overflow-x-auto whitespace-pre-wrap"></pre>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  import {
    ittenAngleToRgbHue,
    rgbHueToIttenAngle,
    hslToRgb,
    rgbToHex,
    rgbToHsl,
    hexToRgb,
    getWcagContrast,
    getContrastRating,
    simulateColorBlindness,
    generatePaletteScale
  } from '../utils/colorPhysics';

  const STORAGE_KEY_WHEEL = 'pl_color_wheel_state_v1';

  interface WheelState {
    wheelMode: 'itten' | 'rgb';
    schemeType: 'complementary' | 'analogous' | 'triadic' | 'tetradic' | 'split' | 'monochromatic';
    currentHue: number;
    currentSat: number;
    currentLight: number;
    currentCvd: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia';
    selectedSwatchHex?: string;
  }

  const DEFAULT_WHEEL_STATE: WheelState = {
    wheelMode: 'itten',
    schemeType: 'complementary',
    currentHue: 0,
    currentSat: 100,
    currentLight: 50,
    currentCvd: 'normal',
    selectedSwatchHex: '',
  };

  function loadWheelState(): WheelState {
    try {
      const raw =
        localStorage.getItem(STORAGE_KEY_WHEEL) ||
        localStorage.getItem('rcm_color_wheel_state_v1');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed) {
          const wheelMode = parsed.wheelMode === 'rgb' ? 'rgb' : 'itten';
          const validSchemes = ['complementary', 'analogous', 'triadic', 'tetradic', 'split', 'monochromatic'];
          const schemeType = validSchemes.includes(parsed.schemeType) ? parsed.schemeType : 'complementary';
          const currentHue = typeof parsed.currentHue === 'number' && !isNaN(parsed.currentHue)
            ? ((Math.round(parsed.currentHue) % 360) + 360) % 360
            : 0;
          const currentSat = typeof parsed.currentSat === 'number' && !isNaN(parsed.currentSat)
            ? Math.max(20, Math.min(100, Math.round(parsed.currentSat)))
            : 100;
          const currentLight = typeof parsed.currentLight === 'number' && !isNaN(parsed.currentLight)
            ? Math.max(20, Math.min(80, Math.round(parsed.currentLight)))
            : 50;
          const validCvds = ['normal', 'protanopia', 'deuteranopia', 'tritanopia', 'achromatopsia'];
          const currentCvd = validCvds.includes(parsed.currentCvd) ? parsed.currentCvd : 'normal';
          const selectedSwatchHex = typeof parsed.selectedSwatchHex === 'string' ? parsed.selectedSwatchHex : '';

          return {
            wheelMode: wheelMode as 'itten' | 'rgb',
            schemeType: schemeType as any,
            currentHue,
            currentSat,
            currentLight,
            currentCvd: currentCvd as any,
            selectedSwatchHex,
          };
        }
      }
    } catch (e) {}
    return { ...DEFAULT_WHEEL_STATE };
  }

  function saveWheelState() {
    try {
      const state: WheelState = {
        wheelMode,
        schemeType,
        currentHue,
        currentSat,
        currentLight,
        currentCvd,
        selectedSwatchHex,
      };
      localStorage.setItem(STORAGE_KEY_WHEEL, JSON.stringify(state));
    } catch (e) {}
  }

  // Active state loaded from localStorage
  const initialWheelState = loadWheelState();
  let wheelMode: 'itten' | 'rgb' = initialWheelState.wheelMode;
  let schemeType: 'complementary' | 'analogous' | 'triadic' | 'tetradic' | 'split' | 'monochromatic' = initialWheelState.schemeType;
  let currentHue = initialWheelState.currentHue;
  let currentSat = initialWheelState.currentSat;
  let currentLight = initialWheelState.currentLight;
  let currentCvd: 'normal' | 'protanopia' | 'deuteranopia' | 'tritanopia' | 'achromatopsia' = initialWheelState.currentCvd;
  let selectedSwatchHex = initialWheelState.selectedSwatchHex || '';

  // DOM elements
  const canvas = document.getElementById('color-wheel-canvas') as HTMLCanvasElement;
  const ctx = canvas?.getContext('2d');
  const hueSlider = document.getElementById('hue-slider') as HTMLInputElement;
  const satSlider = document.getElementById('sat-slider') as HTMLInputElement;
  const lightSlider = document.getElementById('light-slider') as HTMLInputElement;
  const hueValueLabel = document.getElementById('hue-value-label');
  const satValueLabel = document.getElementById('sat-value-label');
  const lightValueLabel = document.getElementById('light-value-label');
  const baseHexInput = document.getElementById('base-hex-input') as HTMLInputElement;
  const baseColorDot = document.getElementById('base-color-dot');
  const wheelDescTag = document.getElementById('wheel-desc-tag');
  const randomHueBtn = document.getElementById('random-hue-btn');
  const resetWheelBtn = document.getElementById('reset-wheel-btn');

  // Palette & Scales DOM
  const swatchesGrid = document.getElementById('palette-swatches-grid');
  const shadeScaleStrip = document.getElementById('shade-scale-strip');
  const activeScaleLabel = document.getElementById('active-scale-label');
  const wcagMatrix = document.getElementById('wcag-contrast-matrix');
  const paletteCountTag = document.getElementById('palette-count-tag');

  // Export DOM
  const tailwindExportCode = document.getElementById('tailwind-export-code');
  const cssVarsExportCode = document.getElementById('css-vars-export-code');
  const copyTailwindBtn = document.getElementById('copy-tailwind-btn');
  const copyCssVarsBtn = document.getElementById('copy-css-vars-btn');
  const downloadSvgBtn = document.getElementById('download-svg-btn');

  // Wheel Mode Buttons
  const wheelModeIttenBtn = document.getElementById('wheel-mode-itten');
  const wheelModeRgbBtn = document.getElementById('wheel-mode-rgb');
  const schemeBtns = document.querySelectorAll('.scheme-btn');
  const cvdBtns = document.querySelectorAll('.cvd-btn');

  // Canvas Dimensions
  const size = 360;
  const radius = size / 2;
  const center = { x: radius, y: radius };

  function renderWheel() {
    if (!canvas || !ctx) return;
    ctx.clearRect(0, 0, size, size);

    // Draw Wheel Gradient Ring
    const innerRadius = 24;
    const outerRadius = radius - 8;

    // Draw in radial slices
    const steps = 360;
    for (let i = 0; i < steps; i++) {
      const angle = (i * Math.PI) / 180;
      const nextAngle = ((i + 1.5) * Math.PI) / 180;

      // Determine RGB hue
      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(i) : i;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);
      let renderHex = rgbToHex(rgb.r, rgb.g, rgb.b);

      if (currentCvd !== 'normal') {
        renderHex = simulateColorBlindness(renderHex, currentCvd as any);
      }

      ctx.beginPath();
      ctx.moveTo(center.x, center.y);
      ctx.arc(center.x, center.y, outerRadius, angle, nextAngle);
      ctx.closePath();

      // Create radial fade towards center white
      const grad = ctx.createRadialGradient(center.x, center.y, innerRadius, center.x, center.y, outerRadius);
      grad.addColorStop(0, '#ffffff');
      grad.addColorStop(1, renderHex);

      ctx.fillStyle = grad;
      ctx.fill();
    }

    // Inner Hole Mask (adapts dynamically to dark or light mode)
    const isDark = document.documentElement.classList.contains('dark');
    ctx.beginPath();
    ctx.arc(center.x, center.y, innerRadius, 0, Math.PI * 2);
    ctx.fillStyle = isDark ? '#0a0a0a' : '#ffffff';
    ctx.fill();
    ctx.lineWidth = 1;
    ctx.strokeStyle = isDark ? '#262626' : '#ebebeb';
    ctx.stroke();

    // Compute Active Palette Points
    const angles = computeSchemeAngles(currentHue, schemeType);
    const rDist = (outerRadius - innerRadius) * (currentSat / 100) + innerRadius;

    // Draw Connecting Polygon/Lines
    if (angles.length > 1) {
      ctx.beginPath();
      angles.forEach((ang, idx) => {
        const rad = (ang * Math.PI) / 180;
        const px = center.x + Math.cos(rad) * rDist;
        const py = center.y + Math.sin(rad) * rDist;
        if (idx === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.closePath();
      ctx.lineWidth = 2;
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.6)' : 'rgba(23, 23, 23, 0.45)';
      ctx.setLineDash([4, 4]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    // Draw Nodes for Each Palette Color
    angles.forEach((ang, idx) => {
      const rad = (ang * Math.PI) / 180;
      const px = center.x + Math.cos(rad) * rDist;
      const py = center.y + Math.sin(rad) * rDist;

      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(ang) : ang;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);
      let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
      if (currentCvd !== 'normal') {
        hex = simulateColorBlindness(hex, currentCvd as any);
      }

      ctx.beginPath();
      ctx.arc(px, py, idx === 0 ? 11 : 8, 0, Math.PI * 2);
      ctx.fillStyle = hex;
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = idx === 0 ? (isDark ? '#ffffff' : '#171717') : (isDark ? '#0a0a0a' : '#ffffff');
      ctx.stroke();

      if (idx === 0) {
        ctx.beginPath();
        ctx.arc(px, py, 3.5, 0, Math.PI * 2);
        ctx.fillStyle = isDark ? '#171717' : '#ffffff';
        ctx.fill();
      }
    });
  }

  function computeSchemeAngles(baseAngle: number, type: string): number[] {
    const norm = (a: number) => ((a % 360) + 360) % 360;

    switch (type) {
      case 'complementary':
        return [norm(baseAngle), norm(baseAngle + 180)];
      case 'analogous':
        return [norm(baseAngle), norm(baseAngle - 30), norm(baseAngle + 30)];
      case 'triadic':
        return [norm(baseAngle), norm(baseAngle + 120), norm(baseAngle + 240)];
      case 'tetradic':
        return [norm(baseAngle), norm(baseAngle + 90), norm(baseAngle + 180), norm(baseAngle + 270)];
      case 'split':
        return [norm(baseAngle), norm(baseAngle + 150), norm(baseAngle + 210)];
      case 'monochromatic':
        return [norm(baseAngle)];
      default:
        return [norm(baseAngle)];
    }
  }

  function getPaletteColors(): { name: string; hex: string }[] {
    const angles = computeSchemeAngles(currentHue, schemeType);

    if (schemeType === 'monochromatic') {
      const baseRgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(currentHue) : currentHue;
      const lightSteps = [80, 65, 50, 35, 20];
      return lightSteps.map((l, i) => {
        const rgb = hslToRgb(baseRgbHue, currentSat, l);
        let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
        if (currentCvd !== 'normal') {
          hex = simulateColorBlindness(hex, currentCvd as any);
        }
        return { name: `Mono ${i + 1}`, hex };
      });
    }

    return angles.map((ang, i) => {
      const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(ang) : ang;
      const rgb = hslToRgb(rgbHue, currentSat, currentLight);
      let hex = rgbToHex(rgb.r, rgb.g, rgb.b);
      if (currentCvd !== 'normal') {
        hex = simulateColorBlindness(hex, currentCvd as any);
      }

      let name = i === 0 ? 'Base' : `Color ${i + 1}`;
      if (schemeType === 'complementary' && i === 1) name = 'Opposite';
      if (schemeType === 'triadic') name = i === 0 ? 'Primary' : `Triad ${i}`;
      if (schemeType === 'analogous') name = i === 0 ? 'Base' : (i === 1 ? 'Analogous 1' : 'Analogous 2');
      if (schemeType === 'split') name = i === 0 ? 'Base' : `Split ${i}`;
      if (schemeType === 'tetradic') name = i === 0 ? 'Base' : `Tetrad ${i}`;

      return { name, hex };
    });
  }

  function updatePaletteUI() {
    const palette = getPaletteColors();
    if (!palette.length) return;

    if (!selectedSwatchHex || !palette.some((p) => p.hex.toUpperCase() === selectedSwatchHex.toUpperCase())) {
      selectedSwatchHex = palette[0].hex;
    }

    if (paletteCountTag) {
      paletteCountTag.textContent = `${palette.length} Colors`;
    }

    // Render Swatches
    if (swatchesGrid) {
      swatchesGrid.innerHTML = '';
      palette.forEach((item) => {
        const isSelected = item.hex.toUpperCase() === selectedSwatchHex.toUpperCase();
        const card = document.createElement('div');
        card.className = `flex items-center justify-between rounded-xl border ${
          isSelected
            ? 'border-[#171717] dark:border-white ring-1 ring-[#171717] dark:ring-white'
            : 'border-[#ebebeb] dark:border-[#222222]'
        } bg-[#fafafa] dark:bg-[#141414] p-3 transition-all cursor-pointer hover:bg-white dark:hover:bg-[#1a1a1a]`;

        card.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="h-10 w-10 rounded-lg border border-black/10 dark:border-white/10 shrink-0 shadow-xs" style="background-color: ${item.hex};"></span>
            <div>
              <div class="font-medium text-xs text-[#171717] dark:text-white">${item.name}</div>
              <div class="font-mono text-xs text-[#8f8f8f] dark:text-[#a1a1aa]">${item.hex}</div>
            </div>
          </div>
          <button
            type="button"
            class="copy-hex-pill rounded-full border border-[#ebebeb] dark:border-[#2e2e2e] bg-white dark:bg-[#1c1c1c] px-2.5 py-1 text-[11px] font-mono text-[#4d4d4d] dark:text-[#a1a1aa] hover:bg-[#ebebeb] dark:hover:bg-[#282828] hover:text-[#171717] dark:hover:text-white transition-colors cursor-pointer"
            data-hex="${item.hex}"
          >
            Copy
          </button>
        `;

        card.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.copy-hex-pill')) return;
          selectedSwatchHex = item.hex;
          saveWheelState();
          updateShadeScale();
          updatePaletteUI();
        });

        swatchesGrid.appendChild(card);
      });

      // Attach copy buttons
      document.querySelectorAll('.copy-hex-pill').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const hex = (e.currentTarget as HTMLElement).dataset.hex;
          if (hex) {
            navigator.clipboard.writeText(hex);
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => (btn.textContent = original), 1500);
          }
        });
      });
    }

    updateShadeScale();
    updateWcagMatrix(palette);
    updateExportCodes(palette);
  }

  function updateShadeScale() {
    if (!shadeScaleStrip || !selectedSwatchHex) return;
    if (activeScaleLabel) activeScaleLabel.textContent = `Tints & Shades of ${selectedSwatchHex}`;

    const scale = generatePaletteScale(selectedSwatchHex);
    shadeScaleStrip.innerHTML = '';

    scale.forEach((s) => {
      let displayHex = s.hex;
      if (currentCvd !== 'normal') {
        displayHex = simulateColorBlindness(s.hex, currentCvd as any);
      }

      const stepEl = document.createElement('button');
      stepEl.type = 'button';
      stepEl.title = `${s.label}: ${s.hex} (Click to copy)`;
      stepEl.className = 'group relative flex-1 h-12 flex flex-col justify-end p-1 transition-transform hover:scale-105 cursor-pointer';
      stepEl.style.backgroundColor = displayHex;

      const isLight = s.label === '50' || s.label === '100' || s.label === '200' || s.label === '300';
      stepEl.innerHTML = `
        <span class="text-[9px] font-mono font-bold leading-tight ${isLight ? 'text-black/70' : 'text-white/80'}">
          ${s.label}
        </span>
      `;

      stepEl.addEventListener('click', () => {
        navigator.clipboard.writeText(s.hex);
        stepEl.style.outline = '2px solid #171717';
        setTimeout(() => (stepEl.style.outline = 'none'), 800);
      });

      shadeScaleStrip.appendChild(stepEl);
    });
  }

  function updateWcagMatrix(palette: { name: string; hex: string }[]) {
    if (!wcagMatrix) return;
    wcagMatrix.innerHTML = '';

    if (palette.length < 2) {
      wcagMatrix.innerHTML = `<div class="text-[#8f8f8f] dark:text-[#a1a1aa] italic py-2">Select a multi-color palette to view mutual contrast scores.</div>`;
      return;
    }

    const base = palette[0];
    for (let i = 1; i < palette.length; i++) {
      const comp = palette[i];
      const ratio = getWcagContrast(base.hex, comp.hex);
      const rating = getContrastRating(ratio);

      const row = document.createElement('div');
      row.className = 'flex items-center justify-between rounded-lg border border-[#ebebeb] dark:border-[#222222] bg-[#fafafa] dark:bg-[#141414] p-2.5';
      row.innerHTML = `
        <div class="flex items-center gap-2">
          <span class="h-4 w-4 rounded-full border border-black/10 dark:border-white/10" style="background-color: ${base.hex};"></span>
          <span class="text-[#8f8f8f] dark:text-[#737373]">vs</span>
          <span class="h-4 w-4 rounded-full border border-black/10 dark:border-white/10" style="background-color: ${comp.hex};"></span>
          <span class="font-medium text-[#171717] dark:text-white">${base.name} & ${comp.name}</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="font-mono font-semibold text-[#171717] dark:text-white">${rating.ratioText}</span>
          <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold ${
            rating.aaNormal ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300' : 'bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300'
          }">
            ${rating.aaNormal ? 'AA Pass' : 'AA Fail'}
          </span>
        </div>
      `;
      wcagMatrix.appendChild(row);
    }
  }

  function updateExportCodes(palette: { name: string; hex: string }[]) {
    // Tailwind export
    if (tailwindExportCode) {
      const lines = palette.map((p, i) => `    'color-${i + 1}': '${p.hex}',`).join('\n');
      tailwindExportCode.textContent = `// tailwind.config.js\nmodule.exports = {\n  theme: {\n    extend: {\n      colors: {\n${lines}\n      }\n    }\n  }\n};`;
    }

    // CSS variables export
    if (cssVarsExportCode) {
      const lines = palette.map((p, i) => `  --color-${i + 1}: ${p.hex};`).join('\n');
      cssVarsExportCode.textContent = `:root {\n${lines}\n}`;
    }
  }

  // Handle Drag on Canvas
  let isDragging = false;

  function handleWheelPointer(e: PointerEvent | MouseEvent | TouchEvent) {
    if ('touches' in e && e.cancelable) {
      e.preventDefault();
    }
    const rect = canvas.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : (e as MouseEvent).clientX;
    const clientY = 'touches' in e ? e.touches[0].clientY : (e as MouseEvent).clientY;

    const scaleX = size / (rect.width || 1);
    const scaleY = size / (rect.height || 1);
    const x = (clientX - rect.left) * scaleX - center.x;
    const y = (clientY - rect.top) * scaleY - center.y;

    let rad = Math.atan2(y, x);
    let deg = (rad * 180) / Math.PI;
    if (deg < 0) deg += 360;

    currentHue = Math.round(deg) % 360;
    if (hueSlider) hueSlider.value = currentHue.toString();
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;

    updateBaseHexFromState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  }

  canvas?.addEventListener('mousedown', (e) => {
    isDragging = true;
    handleWheelPointer(e);
  });
  window.addEventListener('mousemove', (e) => {
    if (isDragging) handleWheelPointer(e);
  });
  window.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      saveWheelState();
    }
  });

  // Touch Support
  canvas?.addEventListener('touchstart', (e) => {
    isDragging = true;
    handleWheelPointer(e);
  }, { passive: false });
  window.addEventListener('touchmove', (e) => {
    if (isDragging) handleWheelPointer(e);
  }, { passive: false });
  window.addEventListener('touchend', () => {
    if (isDragging) {
      isDragging = false;
      saveWheelState();
    }
  });

  // Slider Events
  hueSlider?.addEventListener('input', () => {
    currentHue = parseInt(hueSlider.value, 10);
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
    updateBaseHexFromState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  satSlider?.addEventListener('input', () => {
    currentSat = parseInt(satSlider.value, 10);
    if (satValueLabel) satValueLabel.textContent = `${currentSat}%`;
    updateBaseHexFromState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  lightSlider?.addEventListener('input', () => {
    currentLight = parseInt(lightSlider.value, 10);
    if (lightValueLabel) lightValueLabel.textContent = `${currentLight}%`;
    updateBaseHexFromState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  function updateBaseHexFromState() {
    const rgbHue = wheelMode === 'itten' ? ittenAngleToRgbHue(currentHue) : currentHue;
    const rgb = hslToRgb(rgbHue, currentSat, currentLight);
    const hex = rgbToHex(rgb.r, rgb.g, rgb.b);
    if (baseHexInput) baseHexInput.value = hex;
    if (baseColorDot) baseColorDot.style.backgroundColor = hex;
  }

  function updateWheelModeUI() {
    if (wheelMode === 'itten') {
      wheelModeIttenBtn?.classList.add('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
      wheelModeIttenBtn?.classList.remove('text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      wheelModeRgbBtn?.classList.remove('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
      wheelModeRgbBtn?.classList.add('text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      if (wheelDescTag) wheelDescTag.textContent = 'Drag the node to rotate harmonies. Mode: Itten RYB (Red opposite Green).';
    } else {
      wheelModeRgbBtn?.classList.add('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
      wheelModeRgbBtn?.classList.remove('text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      wheelModeIttenBtn?.classList.remove('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
      wheelModeIttenBtn?.classList.add('text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      if (wheelDescTag) wheelDescTag.textContent = 'Drag the node to rotate harmonies. Mode: Digital RGB (Red opposite Cyan).';
    }
  }

  function updateSchemeButtonsUI() {
    schemeBtns.forEach((btn) => {
      const scheme = btn.getAttribute('data-scheme');
      if (scheme === schemeType) {
        btn.classList.add('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
        btn.classList.remove('border', 'border-[#ebebeb]', 'dark:border-[#333333]', 'bg-white', 'dark:bg-[#141414]', 'text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      } else {
        btn.classList.remove('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]', 'shadow-xs');
        btn.classList.add('border', 'border-[#ebebeb]', 'dark:border-[#333333]', 'bg-white', 'dark:bg-[#141414]', 'text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      }
    });
  }

  function updateCvdButtonsUI() {
    cvdBtns.forEach((btn) => {
      const cvd = btn.getAttribute('data-cvd');
      if (cvd === currentCvd) {
        btn.classList.add('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
        btn.classList.remove('bg-[#fafafa]', 'dark:bg-[#1a1a1a]', 'text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      } else {
        btn.classList.remove('active', 'bg-[#171717]', 'dark:bg-white', 'text-white', 'dark:text-[#171717]');
        btn.classList.add('bg-[#fafafa]', 'dark:bg-[#1a1a1a]', 'text-[#4d4d4d]', 'dark:text-[#a1a1aa]');
      }
    });
  }

  function syncControlsWithState() {
    if (hueSlider) hueSlider.value = currentHue.toString();
    if (satSlider) satSlider.value = currentSat.toString();
    if (lightSlider) lightSlider.value = currentLight.toString();
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
    if (satValueLabel) satValueLabel.textContent = `${currentSat}%`;
    if (lightValueLabel) lightValueLabel.textContent = `${currentLight}%`;
    updateWheelModeUI();
    updateSchemeButtonsUI();
    updateCvdButtonsUI();
    updateBaseHexFromState();
  }

  // Direct Hex Input
  baseHexInput?.addEventListener('change', () => {
    let val = baseHexInput.value.trim();
    if (!val.startsWith('#')) val = '#' + val;
    if (/^#[0-9A-Fa-f]{6}$/.test(val)) {
      const rgb = hexToRgb(val);
      const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
      currentSat = hsl.s;
      currentLight = hsl.l;
      currentHue = wheelMode === 'itten' ? Math.round(rgbHueToIttenAngle(hsl.h)) : hsl.h;

      if (hueSlider) hueSlider.value = currentHue.toString();
      if (satSlider) satSlider.value = currentSat.toString();
      if (lightSlider) lightSlider.value = currentLight.toString();
      if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
      if (satValueLabel) satValueLabel.textContent = `${currentSat}%`;
      if (lightValueLabel) lightValueLabel.textContent = `${currentLight}%`;
      if (baseColorDot) baseColorDot.style.backgroundColor = val;

      saveWheelState();
      renderWheel();
      updatePaletteUI();
    }
  });

  // Wheel Mode Switcher
  wheelModeIttenBtn?.addEventListener('click', () => {
    wheelMode = 'itten';
    updateWheelModeUI();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  wheelModeRgbBtn?.addEventListener('click', () => {
    wheelMode = 'rgb';
    updateWheelModeUI();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  // Palette Scheme Switchers
  schemeBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      schemeType = (target.dataset.scheme || 'complementary') as any;
      updateSchemeButtonsUI();
      saveWheelState();
      renderWheel();
      updatePaletteUI();
    });
  });

  // CVD Simulator Switchers
  cvdBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      currentCvd = (target.dataset.cvd || 'normal') as any;
      updateCvdButtonsUI();
      saveWheelState();
      renderWheel();
      updatePaletteUI();
    });
  });

  // Shuffle Button
  randomHueBtn?.addEventListener('click', () => {
    currentHue = Math.floor(Math.random() * 360);
    if (hueSlider) hueSlider.value = currentHue.toString();
    if (hueValueLabel) hueValueLabel.textContent = `${currentHue}°`;
    updateBaseHexFromState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  // Reset Button
  resetWheelBtn?.addEventListener('click', () => {
    wheelMode = DEFAULT_WHEEL_STATE.wheelMode;
    schemeType = DEFAULT_WHEEL_STATE.schemeType;
    currentHue = DEFAULT_WHEEL_STATE.currentHue;
    currentSat = DEFAULT_WHEEL_STATE.currentSat;
    currentLight = DEFAULT_WHEEL_STATE.currentLight;
    currentCvd = DEFAULT_WHEEL_STATE.currentCvd;
    selectedSwatchHex = DEFAULT_WHEEL_STATE.selectedSwatchHex;

    syncControlsWithState();
    saveWheelState();
    renderWheel();
    updatePaletteUI();
  });

  // Copy buttons
  copyTailwindBtn?.addEventListener('click', () => {
    if (tailwindExportCode?.textContent) {
      navigator.clipboard.writeText(tailwindExportCode.textContent);
      const original = copyTailwindBtn.textContent;
      copyTailwindBtn.textContent = 'Copied!';
      setTimeout(() => (copyTailwindBtn.textContent = original), 1500);
    }
  });

  copyCssVarsBtn?.addEventListener('click', () => {
    if (cssVarsExportCode?.textContent) {
      navigator.clipboard.writeText(cssVarsExportCode.textContent);
      const original = copyCssVarsBtn.textContent;
      copyCssVarsBtn.textContent = 'Copied!';
      setTimeout(() => (copyCssVarsBtn.textContent = original), 1500);
    }
  });

  // Download SVG
  downloadSvgBtn?.addEventListener('click', () => {
    const palette = getPaletteColors();
    const width = 600;
    const height = 200;
    const swatchW = width / palette.length;

    let rects = '';
    palette.forEach((p, i) => {
      rects += `
        <rect x="${i * swatchW}" y="0" width="${swatchW}" height="${height}" fill="${p.hex}" />
        <text x="${i * swatchW + 10}" y="${height - 20}" font-family="monospace" font-size="14" fill="${
          getWcagContrast(p.hex, '#FFFFFF') >= 4.5 ? '#FFFFFF' : '#171717'
        }">${p.hex}</text>
      `;
    });

    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">
        ${rects}
      </svg>
    `;

    const blob = new Blob([svg], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `color-palette-${schemeType}.svg`;
    a.click();
    URL.revokeObjectURL(url);
  });

  // Theme change listener to keep canvas synchronized
  window.addEventListener('pl:themechange', () => {
    renderWheel();
  });
  window.addEventListener('rcm:themechange', () => {
    renderWheel();
  });

  // Initial Boot
  syncControlsWithState();
  renderWheel();
  updatePaletteUI();
</script>
