---
---

<!-- Color Codes & CSS Export Card -->
<div
  class="rounded-xl border border-[#ebebeb] bg-white p-5 sm:p-6 shadow-2xs"
>
  <div
    class="flex items-center justify-between border-b border-[#ebebeb] pb-3"
  >
    <span
      class="font-mono text-xs font-semibold uppercase tracking-wider text-[#8f8f8f]"
    >
      Color Formats & CSS
    </span>
    <span
      class="rounded bg-[#f2f2f2] px-2 py-0.5 font-mono text-[11px] text-[#4d4d4d]"
    >
      Export
    </span>
  </div>

  <!-- Color Format Codes Grid -->
  <div class="mt-4 grid grid-cols-2 gap-2 text-xs">
    <div
      class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2"
    >
      <div class="truncate">
        <span class="text-[10px] font-mono text-[#8f8f8f] block">HEX</span>
        <span
          id="code-hex"
          class="font-mono font-medium text-[#171717]">#3D933E</span
        >
      </div>
      <button
        type="button"
        class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]"
        data-target="code-hex"
        title="Copy HEX"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
      </button>
    </div>

    <div
      class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2"
    >
      <div class="truncate">
        <span class="text-[10px] font-mono text-[#8f8f8f] block">HSL</span>
        <span
          id="code-hsl"
          class="font-mono font-medium text-[#171717]"
          >121°, 41%, 41%</span
        >
      </div>
      <button
        type="button"
        class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]"
        data-target="code-hsl"
        title="Copy HSL"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
      </button>
    </div>

    <div
      class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2"
    >
      <div class="truncate">
        <span class="text-[10px] font-mono text-[#8f8f8f] block">CMYK</span>
        <span
          id="code-cmyk"
          class="font-mono font-medium text-[#171717]"
          >59, 0, 58, 42</span
        >
      </div>
      <button
        type="button"
        class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]"
        data-target="code-cmyk"
        title="Copy CMYK"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
      </button>
    </div>

    <div
      class="flex items-center justify-between rounded-lg border border-[#ebebeb] bg-[#fafafa] px-3 py-2"
    >
      <div class="truncate">
        <span class="text-[10px] font-mono text-[#8f8f8f] block">OKLCH</span>
        <span
          id="code-oklch"
          class="font-mono font-medium text-[#171717]"
          >0.58, 0.14, 142</span
        >
      </div>
      <button
        type="button"
        class="copy-btn cursor-pointer text-[#8f8f8f] hover:text-[#171717]"
        data-target="code-oklch"
        title="Copy OKLCH"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- CSS Snippet Generator -->
  <div
    class="mt-4 rounded-lg border border-[#ebebeb] bg-[#fafafa] p-3"
  >
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-mono text-[#8f8f8f]"
        >Modern CSS Output</span
      >
      <button
        type="button"
        id="copy-css-snippet"
        class="text-xs font-medium text-[#0070f3] hover:underline cursor-pointer"
      >
        Copy Code
      </button>
    </div>
    <pre
      id="css-snippet-code"
      class="mt-1 font-mono text-xs text-[#171717] overflow-x-auto whitespace-pre-wrap">background-color: #3D933E;</pre>
  </div>
</div>

