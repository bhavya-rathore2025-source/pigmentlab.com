---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  lang?: string;
}

const {
  title = 'Color Mixer - Mezclador Real de Colores & Rueda de Color Itten',
  description = 'Mezcla colores con física real de pigmentos (Kubelka-Munk) y crea armonías con la rueda de color tradicional de Johannes Itten y moderna OKLCH. Mejor que mezcladores RGB digitales.',
  currentPath = '',
  lang = 'es',
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Dark Mode Init (defaults to dark, respects localStorage if explicitly set to light) -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('rcm_theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google Fonts: Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="mezcla de colores, combinacion de colores, rueda de color, farbkreis nach itten, color mixer, color wheel, kubelka munk, real paint mixing, itten color wheel" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Color Mixer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] text-[#171717] selection:bg-[#171717] selection:text-white dark:bg-[#000000] dark:text-[#ededed] dark:selection:bg-white dark:selection:text-black antialiased">
    <Navbar currentPath={currentPath} />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
