---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import {
  getLangFromUrl,
  getHreflangLinks,
  getOgLocale,
  getAlternateOgLocales,
  normalizePathname,
  getCleanPathname,
  type SupportedLanguage,
  defaultLang,
} from "../i18n/utils";
import { buildBreadcrumbSchema } from "../utils/seoSchema";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  currentPath?: string;
  lang?: SupportedLanguage;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title = "PigmentLab — Subtraktive Farbphysik & Johannes Itten Bauhaus Farbtheorie",
  description = "Kostenlose Online-Farbwerkzeuge basierend auf realistischer physikalischer Pigmentoptik und Johannes Itten Bauhaus-Farbtheorie. Farben mischen, Farbpaletten generieren und WCAG-Kontrast testen.",
  keywords = "pigmentlab, pigment lab, farbkreis, farben mischen, farbrad, farbkreis itten, farbtheorie, farbpaletten generator",
  currentPath = Astro.url.pathname,
  lang,
  canonicalUrl,
  ogImage = "/og-image.png",
  ogType = "website",
  schema,
  noindex = false,
} = Astro.props;

const detectedLang = getLangFromUrl(Astro.url);
const resolvedLang: SupportedLanguage = lang || detectedLang || defaultLang;

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://pigmentlaboratory.com";

// If canonicalUrl not explicitly supplied, compute based on normalized URL path
const activePathname = normalizePathname(currentPath || Astro.url.pathname);
const resolvedCanonical = canonicalUrl || `${siteUrl}${activePathname}`;

const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${ogImage}`;

const ogLocale = getOgLocale(resolvedLang);
const alternateOgLocales = getAlternateOgLocales(resolvedLang);
const hreflangLinks = getHreflangLinks(activePathname, siteUrl);

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "PigmentLab",
  url: `${siteUrl}/`,
  description: description,
  inLanguage: resolvedLang,
  potentialAction: {
    "@type": "SearchAction",
    target: `${siteUrl}/mix?color={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const baseSchemas = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [defaultSchema];

const cleanPath = getCleanPathname(activePathname);
const hasBreadcrumb = baseSchemas.some(
  (item) => item?.["@type"] === "BreadcrumbList",
);
const schemaList =
  !noindex && !hasBreadcrumb && cleanPath !== "/"
    ? [
        ...baseSchemas,
        buildBreadcrumbSchema({
          activePathname,
          lang: resolvedLang,
          siteUrl,
          resolvedCanonical,
        }),
      ]
    : baseSchemas;
---

<!doctype html>
<html lang={resolvedLang} class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=2"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />
    <meta name="apple-mobile-web-app-title" content="Pigment Lab" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Hreflang Alternates for Multilingual SEO -->
    {
      hreflangLinks.map((item) => (
        <link rel="alternate" hreflang={item.hreflang} href={item.href} />
      ))
    }

    <!-- Robots Meta -->
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="pigmentlaboratory.com" />
    <meta name="theme-color" content="#171717" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PigmentLab" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternateOgLocales.map((alt) => (
        <meta property="og:locale:alternate" content={alt} />
      ))
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD Structured Data for Search Engine Rich Snippets -->
    {
      schemaList.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }

    <!-- Dark Mode Init -->
    <script is:inline>
      (function () {
        try {
          const legacyTheme = localStorage.getItem("rcm_theme");
          if (legacyTheme && !localStorage.getItem("pl_theme")) {
            localStorage.setItem("pl_theme", legacyTheme);
          }
          const stored = localStorage.getItem("pl_theme") || legacyTheme;
          if (stored === "light") {
            document.documentElement.classList.remove("dark");
          } else {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Google Fonts: Geist Sans & Geist Mono -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen flex flex-col bg-[#fafafa] text-[#171717] selection:bg-[#171717] selection:text-white dark:bg-[#000000] dark:text-[#ededed] dark:selection:bg-white dark:selection:text-black antialiased overflow-x-hidden w-full"
  >
    <Navbar currentPath={activePathname} lang={resolvedLang} />
    <main class="flex-1 w-full overflow-x-hidden">
      <slot />
    </main>
    <Footer currentPath={activePathname} lang={resolvedLang} />
  </body>
</html>
